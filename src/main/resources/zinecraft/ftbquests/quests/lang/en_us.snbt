	quest.C30000000000017A.quest_subtitle: "Offense"
	quest.C30000000000017A.quest_desc: ["Original effect: All Operators gain ASPD +30 for every Operator in the adjacent 4 tiles", "Description: Flames represent radiance and warmth. Gathering round a fire turns despair into hope.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
