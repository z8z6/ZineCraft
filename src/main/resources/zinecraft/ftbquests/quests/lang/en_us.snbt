	quest.C3000000000002C1.title: "Worn Crossbow New Doctrine"
	quest.C3000000000002C1.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002C1.quest_desc: ["Original effect: 立即进阶一个【狙击】干员（不消耗希望），并使其：攻击时无视目标50%的防御", "Description: “没射中不是你准头不行，给我加大火力，再来！”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002C1.title: "Obtain Worn Crossbow New Doctrine"
	quest.C3000000000002C3.title: "Rusty Blade New Doctrine"
	quest.C3000000000002C3.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002C3.quest_desc: ["Original effect: 立即进阶一个【特种】干员（不消耗希望），并使其：再部署时间-50%", "Description: 即便是经常与特种干员进行实战练习的老手，依然无法精准把握“准备好被打”的时机。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002C3.title: "Obtain Rusty Blade New Doctrine"
	quest.C3000000000002CE.title: "Empty Bed"
	quest.C3000000000002CE.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002CE.quest_desc: ["Original effect: 零件箱中存在4个或更多空栏位时，所有干员部署费用-6", "Description: 两人投下三枚阴影，灵魂拥挤不堪。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002CE.title: "Obtain Empty Bed"
	quest.C3000000000002DB.title: "Advanced Iot Terminal"
	quest.C3000000000002DB.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002DB.quest_desc: ["Original effect: 干员部署后与攻击范围内一名干员用高级物联终端连接，敌人触碰高级物联终端时停顿，每0.5秒受到所有相连的干员攻击力之和50%的法术伤害", "Description: 经过改造的终端，可连接范围指数级扩大，立起接收杆即可立刻体验心意相通！", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
