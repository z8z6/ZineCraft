	quest.C3000000000001D1.quest_subtitle: "Offense"
	quest.C3000000000001D1.quest_desc: ["Original effect: Artilleryman, Phalanx Caster, and Flinger Operators gain +15% ATK for every time they deal damage to the same unit, up to 150%; this bonus will reset if no damage is dealt for 5 seconds", "Description: Strikes land true, the earth trembles.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
