	quest.7D12000000000001.title: "National Setting"
	quest.7D12000000000001.quest_subtitle: "Summary of PRTS nation records"
	quest.7D12000000000001.quest_desc: ["A vast nation at Terra's eastern edge with a long-established eastern civilization, whose northern frontier has long borne responsibility for resisting external threats.\n\nSource boundary: PRTS Terra geography records; this entry does not invent undisclosed lore."]
