	quest.C3000000000000F5.title: "Excessiveness"
	quest.C3000000000000F5.quest_subtitle: "Offense"
	quest.C3000000000000F5.quest_desc: ["Original effect: Deals 3000 True Damage on all enemy units every time an enemy unit enters the Protection Objective", "Description: A gemstone without luster, just like the endless desires of the troupe's leader.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
