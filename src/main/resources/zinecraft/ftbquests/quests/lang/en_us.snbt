	quest.C300000000000081.quest_desc: ["Original effect: Specialist Operators have +30 ASPD.", "Description: Projekt Red has a knife. She has a knife.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
