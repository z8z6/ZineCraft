	quest.C3000000000000C8.title: "Jet Black Dance Shoes"
	quest.C3000000000000C8.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000C8.quest_desc: ["Original effect: Can deploy Melee Operators on High Ground tiles", "Description: The Columbian dancer's steps are firm and strong, her taps reverberating loudly in the air as she strikes the ground.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000C8.title: "Obtain Jet Black Dance Shoes"
	quest.C3000000000000C9.title: "Pure White Dance Shoes"
	quest.C3000000000000C9.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000C9.quest_desc: ["Original effect: Can deploy Ranged Operators on Low Ground tiles", "Description: The Ursus dancer's steps are swift and elegant, her body moving as she wills.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
