	quest.C30000000000007E.quest_subtitle: "Offense"
	quest.C30000000000007E.quest_desc: ["Original effect: Medic Operators have +50 ASPD.", "Description: Compared to the feat of snatching a life from the grip of death, what is three days of coma afterwards?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
