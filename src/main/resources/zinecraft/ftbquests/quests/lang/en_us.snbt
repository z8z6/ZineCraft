	quest.C30000000000008E.quest_desc: ["Original effect: Hope +4, Squad Size Limit +1", "Description: A weird-looking flute. Someone plays it day in and day out.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
