	quest.C300000000000147.quest_subtitle: "Offense"
	quest.C300000000000147.quest_desc: ["Original effect: Operators recover 2 SP when dealing damage to [Sea Monsters]", "Description: Because the evil creatures were born from the sea, they were afraid. Afraid of the flames that would never mix with the sea.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000147.title: "Obtain Flames Of The Inquisition"
	quest.C300000000000149.title: "Memories Of The Shard"
	quest.C300000000000149.quest_subtitle: "Offense"
	quest.C300000000000149.quest_desc: ["Original effect: Deals 3000 True Damage on all enemy units every time an enemy unit enters the Protection Objective", "Description: 'It has pierced Victoria's heart, and is watching the empire bleed.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
