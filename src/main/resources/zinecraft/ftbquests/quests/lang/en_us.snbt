	quest.C30000000000011C.quest_desc: ["Original effect: Fortress, Chain Caster, and Blast Caster Operators recover 2 SP each time they deal damage to an enemy unit", "Description: Strength in numbers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000011C.title: "Obtain Hand Of Diffusion Explosive"
	quest.C30000000000011D.title: "Hand Of Purification"
	quest.C30000000000011D.quest_subtitle: "Offense"
	quest.C30000000000011D.quest_desc: ["Original effect: Bard, Phalanx Caster, and Therapist Operators deal 50% ATK as Arts damage to all enemies in their attack range", "Description: Where it is, dust is not.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000011D.title: "Obtain Hand Of Purification"
	quest.C30000000000011E.title: "Hand Of Pulverization"
	quest.C30000000000011E.quest_subtitle: "Offense"
	quest.C30000000000011E.quest_desc: ["Original effect: Artilleryman, Splash Caster, and Flinger Operators gain +15% ATK for every time they deal damage to the same unit, up to 150%; this bonus will reset if no damage is dealt for 5 seconds", "Description: Your goal isn't just to hit the bullseye over and over.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
