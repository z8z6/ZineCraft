	quest.C30000000000008C.quest_desc: ["Original effect: Hope +2, Squad Size Limit +1", "Description: A lady's elegant scarf. Her appearance is a sign that it is safe here.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
