	quest.C100000000000008.quest_subtitle: "Contains 20 collectibles."
	quest.C100000000000008.quest_desc: ["Primarily affects Originium Ingots, shops, goods, or collectible acquisition.", "Contains 20 collectibles."]
	task.C200000000000008.title: "Read category guide"
	quest.C30000000000000B.title: "Antique Coins"
	quest.C30000000000000B.quest_subtitle: "Resources and Economy"
	quest.C30000000000000B.quest_desc: ["Original effect: Immediately adds +10 Originium Ingots.", "Description: An ancient, rusty coin, weathered to the point where one can no longer identify its age. Things like these are all too common throughout Terra's barrens.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000000B.title: "Obtain Antique Coins"
	quest.C30000000000000C.title: "Actors Jewelry Box"
	quest.C30000000000000C.quest_subtitle: "Resources and Economy"
	quest.C30000000000000C.quest_desc: ["Original effect: Immediately adds +18 Originium Ingots.", "Description: A box containing all kinds of shattered jewelries. The young lead actress wore these jewelries and stepped onto the stage, in the end falling from its highest point.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000000C.title: "Obtain Actors Jewelry Box"
	quest.C30000000000000D.title: "Flawless Jadestone"
	quest.C30000000000000D.quest_subtitle: "Resources and Economy"
	quest.C30000000000000D.quest_desc: ["Original effect: Immediately adds +25 Originium Ingots.", "Description: Even though it thrice brought the city to ruins, it yet shines radiantly in its flawless form. Even today, the Sargon emperor in possession of the gem has yet to find another piece of jewelry matching its brilliance, leaving it with naught but gunsmoke for a companion.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000000D.title: "Obtain Flawless Jadestone"
	quest.C300000000000020.title: "Supreme Ring"
	quest.C300000000000020.quest_subtitle: "Resources and Economy"
	quest.C300000000000020.quest_desc: ["Original effect: +50% Originium Ingot drops from battle.", "Description: In Leithanian mythology, he who holds the ring enjoys the vast riches of the entire world, but greed will also be his undoing.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000020.title: "Obtain Supreme Ring"
	quest.C300000000000023.title: "Rusted Iron Hammer"
	quest.C300000000000023.quest_subtitle: "Resources and Economy"
	quest.C300000000000023.quest_desc: ["Original effect: Shop vendors charge -50% Originium Ingots for their goods.", "Description: 'Change is necessary, and we must do all we can to hasten the oncoming storm.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000023.title: "Obtain Rusted Iron Hammer"
	quest.C3000000000000C7.title: "Proof Of Friendship"
	quest.C3000000000000C7.quest_subtitle: "Resources and Economy"
	quest.C3000000000000C7.quest_desc: ["Original effect: +30% Originium Ingot drops from battle.", "Description: Some old Vampire families are still concerned with formalities and etiquette. When they extend to others their exalted friendship, they do not allow it to be sullied.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000C7.title: "Obtain Proof Of Friendship"
	quest.C300000000000184.title: "Knight Lance Pro"
	quest.C300000000000184.quest_subtitle: "Resources and Economy"
	quest.C300000000000184.quest_desc: ["Original effect: Treasure Chests on the battlefield will drop more Originium Ingots", "Description: Don't worry if your own strength isn't enough! Use these tiny levers to move more, and win more in every round! The grand prize is a holiday trip to Sami!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000184.title: "Obtain Knight Lance Pro"
	quest.C30000000000018E.title: "Polar Retrofit Package"
	quest.C30000000000018E.quest_subtitle: "Resources and Economy"
	quest.C30000000000018E.quest_desc: ["Original effect: When used, Support items will also be used simultaneously on the adjacent 4 tiles", "Description: Proudly produced by the Volvort Kochinski Extreme Environment Equipment Testing Department. It can modify a variety of devices, adapting them for polar regions and increasing their effectiveness in cold environments.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000018E.title: "Obtain Polar Retrofit Package"
	quest.C3000000000001BF.title: "Lost Key"
	quest.C3000000000001BF.quest_subtitle: "Resources and Economy"
	quest.C3000000000001BF.quest_desc: ["Original effect: Gain +20% Command EXP from battles; obtain 50 Originium Ingots upon reaching Command Level 10", "Description: 'Fellas, this key can open the treasure trove lost within the royal city of Kazdel. Hey, green-haired Feline! Watch that hooded slave of yours and keep those hands away from my map!'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001BF.title: "Obtain Lost Key"
	quest.C3000000000001C2.title: "Magic Box"
	quest.C3000000000001C2.quest_subtitle: "Resources and Economy"
	quest.C3000000000001C2.quest_desc: ["Original effect: Originium Ingots +4 and Toil Limit +2", "Description: This ordinary looking box devours souls, compelling those who see it to kill its owner and claim it. When all the humans had killed each other, animals became the new victims. Eventually, the elder revenant retrieved the box from a giant rockhorn's stomach and sealed the rogue revenant in his bones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C2.title: "Obtain Magic Box"
	quest.C3000000000001E7.title: "Thoughts Catcher"
	quest.C3000000000001E7.quest_subtitle: "Resources and Economy"
	quest.C3000000000001E7.quest_desc: ["Original effect: Originium Ingot +1 after each interpretation", "Description: Sorting truth from falsehood takes time, and some ideas will invariably scatter. In such moments, professionally trained retainers will snatch those ideas up and turn them into true wealth.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E7.title: "Obtain Thoughts Catcher"
	quest.C3000000000001F9.title: "Petal"
	quest.C3000000000001F9.quest_subtitle: "Resources and Economy"
	quest.C3000000000001F9.quest_desc: ["Original effect: -50% Command EXP and Originium Ingots from battles; triggers wondrous effects in Face-Off", "Description: Epiphany.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F9.title: "Obtain Petal"
	quest.C30000000000021C.title: "Eye Of Fortune"
	quest.C30000000000021C.quest_subtitle: "Resources and Economy"
	quest.C30000000000021C.quest_desc: ["Original effect: Originium Ingots +5, Operators dispatched in Scout nodes will return with 5 extra Ingots", "Description: A millennium after the Sarkaz vanished, the saying 'the eye of a Cyclops opens for wealth' became folklore. People began worshipping discs with a single embedded eye, seeking wealth and happiness.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000021C.title: "Obtain Eye Of Fortune"
	quest.C30000000000023B.title: "Ink Of Dawn And Dusk"
	quest.C30000000000023B.quest_subtitle: "Resources and Economy"
	quest.C30000000000023B.quest_desc: ["Original effect: When a battle begins, obtain a random Tactical Prop for that battle", "Description: Bubbles blown by the fin swimming within this scroll grant strange effects. The scroll's owner doesn't mind if they're touched, for they'll soon burst and vanish into the wind anyway.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000023B.title: "Obtain Ink Of Dawn And Dusk"
	quest.C30000000000025A.title: "Ink Of The Hidden Butterfly"
	quest.C30000000000025A.quest_subtitle: "Resources and Economy"
	quest.C30000000000025A.quest_desc: ["Original effect: When carrying this Collectible, 'Body of Sui' will raid your party in battles", "Description: A creature researched by Liu'er, made from remnant rock of the Sui Tomb and martial tomes panned by Shuo. Originally Sui was carved on it, but Its form has faded, and now a butterfly is carved to take Its place. But the butterfly fears the Sui's might, so it is time to repel the Sui to appease it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000025A.title: "Obtain Ink Of The Hidden Butterfly"
	quest.C300000000000279.title: "Great Tomb Whistle"
	quest.C300000000000279.quest_subtitle: "Resources and Economy"
	quest.C300000000000279.quest_desc: ["Original effect: After leaving this shop, immediately enter Sui's Remnant Consciousness and gain +3 Candles", "Description: A wood whistle crafted from the Great Tomb Tree. When blown, one's consciousness drifts away from the body, while the whistle turns into fuel to light a steady fire inside the mind.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
