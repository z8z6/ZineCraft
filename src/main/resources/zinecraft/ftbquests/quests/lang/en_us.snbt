	quest.C3000000000000C5.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000C5.quest_desc: ["Original effect: All Operators have -30% Max HP, but have -50% Redeployment Time", "Description: A broken sword. It's usable... probably...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
