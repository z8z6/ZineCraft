	quest.C300000000000096.quest_subtitle: "Offense"
	quest.C300000000000096.quest_desc: ["Original effect: All Operators start with +8 SP.", "Description: A purse used by high-class ladies who shop on the Élysée. Mousse has a purse like this.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
