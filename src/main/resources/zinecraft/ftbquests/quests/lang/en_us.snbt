	quest.C30000000000009B.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.35/s", "Description: A small jar of fowlbeast liver pâté. Bright and vividly colorful, it is eaten only by nobles.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009B.title: "Obtain Fowlbeast Liver Pate"
