	quest.C3000000000000F3.quest_subtitle: "Healing"
	quest.C3000000000000F3.quest_desc: ["Original effect: All friendly units have +30% healing effects and receive -30% Elemental Injury", "Description: We've known how to indulge since birth. Do not resist your desires. Submit to them instead.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F3.title: "Obtain Surging Feast"
	quest.C3000000000000F6.title: "Select Canned Beast Meat"
	quest.C3000000000000F6.quest_subtitle: "Healing"
	quest.C3000000000000F6.quest_desc: ["Original effect: 【结构化】可携带干员+1，所有我方单位每秒回复3点生命\n【半结构化】可携带干员+1，所有我方单位每秒回复5点生命\n【非结构化】可携带干员+1，所有我方单位每秒回复8点生命\n【混沌化】可携带干员+1，所有我方单位每秒回复10点生命", "Description: 对奔行于长路的旅人而言，“开罐即食”的便利，往往比味道更重要。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F6.title: "Obtain Select Canned Beast Meat"
	quest.C3000000000001A9.title: "Hand Of Return"
	quest.C3000000000001A9.quest_subtitle: "Healing"
	quest.C3000000000001A9.quest_desc: ["Original effect: Multi-target Medics, Chain Medics, and Wandering Medics will heal any Operator within their range to full HP when that Operator takes critical damage (Each Operator can only trigger this once per battle)", "Description: Restrain death, and rouse life.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A9.title: "Obtain Hand Of Return"
	quest.C300000000000225.title: "Firefly Booklight"
	quest.C300000000000225.quest_subtitle: "Healing"
	quest.C300000000000225.quest_desc: ["Original effect: When enemies are defeated, surrounding allied units recover 300 HP", "Description: A plant from a scholar's hometown gradually withers by the academy window, but he cannot bear to dispose of it. The pot is eventually bereft of vegetation, but is surrounded by fireflies illuminating the pages of his books.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000225.title: "Obtain Firefly Booklight"
	quest.C30000000000022E.title: "A Jade Jue"
	quest.C30000000000022E.quest_subtitle: "Healing"
	quest.C30000000000022E.quest_desc: ["Original effect: Operators on Vagary Tiles defeated for the first time will recover 30% HP instead of retreating", "Description: A jade pendant gifted by the master of the Garden of Grotesqueries. A friend you happened to make and are traveling with invites you to explore elsewhere, but you politely decline, and his face blinks into a different expression. He tries to pull you by force, only to flinch and withdraw as if scalded by something. You breathe a sigh of relief, and discover the now-cracked pendant on your waist.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000022E.title: "Obtain A Jade Jue"
	quest.C300000000000297.title: "Bloodthirsty Pincerbeast"
	quest.C300000000000297.quest_subtitle: "Healing"
	quest.C300000000000297.quest_desc: ["Original effect: 我方干员击倒敌人时，回复10%最大生命", "Description: 观赏钳兽争斗很有趣，前提是它们钳住的不是你的手指。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000297.title: "Obtain Bloodthirsty Pincerbeast"
	quest.C3000000000002BB.title: "Hand Of Healing"
	quest.C3000000000002BB.quest_subtitle: "Healing"
	quest.C3000000000002BB.quest_desc: ["Original effect: 疗养师、行医、护佑者攻击范围内的我方干员免疫异常状态，拥有医者-地缘策略时，溢出的治疗量可以转化成等量的屏障（最大为100%生命上限）", "Description: 将心比心，时刻呵护。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002BB.title: "Obtain Hand Of Healing"
	quest.C3000000000002BF.title: "Broken Halberd New Doctrine"
	quest.C3000000000002BF.quest_subtitle: "Healing"
	quest.C3000000000002BF.quest_desc: ["Original effect: 立即进阶一个【近卫】干员（不消耗希望），并使其：首次被击倒时回复100%生命", "Description: 百步之外，弩箭与法术更快，但三步之内，还是剑更快。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002BF.title: "Obtain Broken Halberd New Doctrine"
	quest.C100000000000003.title: "Defense"
	quest.C100000000000003.quest_subtitle: "Contains 88 collectibles."
	quest.C100000000000003.quest_desc: ["Primarily improves defenses, resistance, or damage reduction, or weakens enemy attacks.", "Contains 88 collectibles."]
	task.C200000000000003.title: "Read category guide"
	quest.C30000000000002D.title: "Silent Squad"
	quest.C30000000000002D.quest_subtitle: "Defense"
	quest.C30000000000002D.quest_desc: ["Original effect: All friendly units have +35% ATK, +35% DEF, and +45% Max HP", "Description: A set of exploration drones remotely controlled by the Rhodes Island Engineering Department. More efficient and safer than ever, they provide operators on field missions the omnidirectional support and defense they need.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000002D.title: "Obtain Silent Squad"
	quest.C30000000000002E.title: "Fissured Restraints"
	quest.C30000000000002E.quest_subtitle: "Defense"
	quest.C30000000000002E.quest_desc: ["Original effect: All enemy units have -7% ATK.", "Description: It seems this sturdy band was once used to restrain something terrifying... Help...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000002E.title: "Obtain Fissured Restraints"
	quest.C30000000000002F.title: "Abyssal Wyrdmask"
	quest.C30000000000002F.quest_subtitle: "Defense"
	quest.C30000000000002F.quest_desc: ["Original effect: All enemy units have -12% ATK.", "Description: An eldritch mask not belonging to any culture you're familiar with that is capable of making people lose their will to fight... and unconsciously fall into a state of deep contemplation.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000002F.title: "Obtain Abyssal Wyrdmask"
	quest.C300000000000030.title: "Godmothers Token"
	quest.C300000000000030.quest_subtitle: "Defense"
	quest.C300000000000030.quest_desc: ["Original effect: All enemy units have -17% ATK.", "Description: A laurel of bones, the token of a Sicilian noblewoman. This symbol of order will smooth the turbulance of all desires, for conflict is not allowed. Genuine or counterfeit, it still demands you to kneel.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000030.title: "Obtain Godmothers Token"
	quest.C300000000000037.title: "Oriron Round Shield"
	quest.C300000000000037.quest_subtitle: "Defense"
	quest.C300000000000037.quest_desc: ["Original effect: All friendly units have +15% DEF.", "Description: Before the use of Oriron became widespread in today's industrial sector, the material was frequently used to forge military weapons like this one.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000037.title: "Obtain Oriron Round Shield"
	quest.C300000000000038.title: "Military Mirror Armor"
	quest.C300000000000038.quest_subtitle: "Defense"
	quest.C300000000000038.quest_desc: ["Original effect: All friendly units have +25% DEF.", "Description: This mirror armor used to be able to withstand most attacks on the chest, but with the fall of Gaul, such archaic forms of armor have become museum pieces.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000038.title: "Obtain Military Mirror Armor"
	quest.C300000000000039.title: "Old Steam Armor"
	quest.C300000000000039.quest_subtitle: "Defense"
	quest.C300000000000039.quest_desc: ["Original effect: All friendly units have +35% DEF.", "Description: Even this old, outdated steam armor seems to carry with it the resplendence of when the Victorian monarchs cast their glory across half the world.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000039.title: "Obtain Old Steam Armor"
	quest.C300000000000043.title: "Rusted Razor"
	quest.C300000000000043.quest_subtitle: "Defense"
	quest.C300000000000043.quest_desc: ["Original effect: All enemies take +15% Physical damage.", "Description: If you cut yourself with this, you know what will happen.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000043.title: "Obtain Rusted Razor"
	quest.C300000000000044.title: "Carriage Drivers Whip"
	quest.C300000000000044.quest_subtitle: "Defense"
	quest.C300000000000044.quest_desc: ["Original effect: All enemies take +25% Physical damage.", "Description: As the troupe's carriage driver, he has no name and no past. His life is meaningful only when he whips his burdenbeasts.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000044.title: "Obtain Carriage Drivers Whip"
	quest.C300000000000045.title: "Avenger"
	quest.C300000000000045.quest_subtitle: "Defense"
	quest.C300000000000045.quest_desc: ["Original effect: All enemies take +35% Physical damage.", "Description: A gift from Theresis and set up by Theresa, this is the very first weapon that Ascalon received after her inaugural mission as part of the Military Council.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000045.title: "Obtain Avenger"
	quest.C300000000000046.title: "Standard Anti Riot Instrument"
	quest.C300000000000046.quest_subtitle: "Defense"
	quest.C300000000000046.quest_desc: ["Original effect: All enemies take +20% Arts damage.", "Description: Standard equipment of the Ursus Guard. Comes with an intermittent blinding Originium Arts effect. Unfortunately, not many Guards out there remember this when push comes to shove.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000046.title: "Obtain Standard Anti Riot Instrument"
	quest.C300000000000047.title: "Emperors Collection"
	quest.C300000000000047.quest_subtitle: "Defense"
	quest.C300000000000047.quest_desc: ["Original effect: All enemies take +30% Arts damage.", "Description: The Sami revere their wild lands more than anything, and this fragment of the vast wilderness sleeps in the personal collection of the Emperor of Ursus.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000047.title: "Obtain Emperors Collection"
	quest.C300000000000048.title: "Brilliant Lament"
	quest.C300000000000048.quest_subtitle: "Defense"
	quest.C300000000000048.quest_desc: ["Original effect: All enemies take +40% Arts damage.", "Description: His blood yet flows. He has never left this place.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000048.title: "Obtain Brilliant Lament"
	quest.C300000000000069.title: "Iron Guard Tranquility"
	quest.C300000000000069.quest_subtitle: "Defense"
	quest.C300000000000069.quest_desc: ["Original effect: Defender Operators have +25% DEF and +50% Max HP", "Description: 'Is there anyone who can remain in formation under a bombing of that scale?' 'Standing in formation? He moved a few steps forward.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000069.title: "Obtain Iron Guard Tranquility"
	quest.C300000000000079.title: "Stalwart Aid Demoralize"
	quest.C300000000000079.quest_subtitle: "Defense"
	quest.C300000000000079.quest_desc: ["Original effect: Enemies within the attack range of Supporter Operators have -15% ATK.", "Description: There are many ways to weaken an enemy's offensive capabilities: corroding their weapons, psychological warfare, increasing their weight, and... giving them a stomachache.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000079.title: "Obtain Stalwart Aid Demoralize"
	quest.C30000000000007F.title: "Healers Path Restore Sanity"
	quest.C30000000000007F.quest_subtitle: "Defense"
	quest.C30000000000007F.quest_desc: ["Original effect: Allied units within the attack range of Medic Operators gain Resistance.", "Description: Reinforce your thinking. In the domain of your mind, make even every weed impregnable.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007F.title: "Obtain Healers Path Restore Sanity"
	quest.C3000000000000A2.title: "Renowned Singer"
	quest.C3000000000000A2.quest_subtitle: "Defense"
	quest.C3000000000000A2.quest_desc: ["Original effect: Enemies receive 600 Arts Damage per second when stunned, frozen, or bound", "Description: Who cares what it's singing? Make it stop! It's hurting my ears!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A2.title: "Obtain Renowned Singer"
	quest.C3000000000000A3.title: "String Puppet"
	quest.C3000000000000A3.quest_subtitle: "Defense"
	quest.C3000000000000A3.quest_desc: ["Original effect: Enemies receive 700 Arts Damage per second when stunned, frozen, or bound", "Description: The more you struggle and try to break free, the tighter the strings get. Do you really think you are still thinking rationally?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A3.title: "Obtain String Puppet"
	quest.C3000000000000A4.title: "Childrens Puppet"
	quest.C3000000000000A4.quest_subtitle: "Defense"
	quest.C3000000000000A4.quest_desc: ["Original effect: Enemies receive 1000 Arts Damage per second when stunned, frozen, or bound", "Description: A simple puppet made by Iberian children using trinkets found on the seacoast. Supposedly just holding it tight will give you much richer dreams.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A4.title: "Obtain Childrens Puppet"
	quest.C3000000000000AB.title: "Civilight Eterna"
	quest.C3000000000000AB.quest_subtitle: "Defense"
	quest.C3000000000000AB.quest_desc: ["Original effect: All enemies take +150% True damage.", "Description: A small, black crown.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000AB.title: "Obtain Civilight Eterna"
	quest.C3000000000000AF.title: "Royal Alliance Treaty"
	quest.C3000000000000AF.quest_subtitle: "Defense"
	quest.C3000000000000AF.quest_desc: ["Original effect: All friendly units no longer receive any damage from Sarkaz enemies", "Description: The old Sarkaz courts sacrificed themselves to obtain their power. Ever since, the courts have come to terms with one another, banding together against their common enemy.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000AF.title: "Obtain Royal Alliance Treaty"
	quest.C3000000000000B3.title: "Victoria Crown"
	quest.C3000000000000B3.quest_subtitle: "Defense"
	quest.C3000000000000B3.quest_desc: ["Original effect: All enemy units have +30% ATK, DEF, and Max HP; Boss units gain an additional +15% ATK, +15% DEF, and +30% Max HP", "Description: When the last Aslan to rule Victoria was sent to the guillotine, the angry masses rushed forward to trample his reign into dust.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B3.title: "Obtain Victoria Crown"
	quest.C3000000000000B4.title: "Victoria Crown Reforged"
	quest.C3000000000000B4.quest_subtitle: "Defense"
	quest.C3000000000000B4.quest_desc: ["Original effect: All enemy units have +35% ATK, DEF, and Max HP; Leader enemies gain an additional +20% ATK, DEF and +50% Max HP, but these leader bonuses are halved when your squad has Operators from all 8 Classes", "Description: When the last Aslan to rule Victoria was sent to the guillotine, the angry masses rushed forward to trample his reign into dust.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B4.title: "Obtain Victoria Crown Reforged"
	quest.C3000000000000CE.title: "Numbness And Obscenity"
	quest.C3000000000000CE.quest_subtitle: "Defense"
	quest.C3000000000000CE.quest_desc: ["Original effect: All friendly units have +5 RES", "Description: A famous art piece and the final piece created by an insane Leithanian sculptor two hundred years ago. The sculptor was known for his extraordinary talent and his participation in multiple cruel homicides. However, historical records show that few people took notice of his work. He was instead known for his features and beauty.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000CE.title: "Obtain Numbness And Obscenity"
	quest.C3000000000000DE.title: "Royal Brooch"
	quest.C3000000000000DE.quest_subtitle: "Defense"
	quest.C3000000000000DE.quest_desc: ["Original effect: All allied units have RES +15, and gain one-time dodge after deployment", "Description: An ornament worn by Gaulish royalty, made from gold and inlaid with expensive Originium crystals. They are more than decoration: many of these brooches hide Originium circuits loaded with defensive Arts.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DE.title: "Obtain Royal Brooch"
	quest.C3000000000000E3.title: "Scouts Scope"
	quest.C3000000000000E3.quest_subtitle: "Defense"
	quest.C3000000000000E3.quest_desc: ["Original effect: Enemies take increased damage from allied units as range increases (max 100%)", "Description: Lock on, aim, fire, and destroy the enemy's will to resist, all in the name of a better future that Scout will never see. Maybe you can do it for him.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E3.title: "Obtain Scouts Scope"
	quest.C3000000000000E8.title: "Assault Co Op Skirmish"
	quest.C3000000000000E8.quest_subtitle: "Defense"
	quest.C3000000000000E8.quest_desc: ["Original effect: Increases the DEF of Vanguard and Guard Operators by +10% for each Vanguard or Guard Operator in the combat squad.", "Description: A sophisticated blocking technique is essential to protecting one's body.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E8.title: "Obtain Assault Co Op Skirmish"
	quest.C3000000000000EA.title: "Fortification Contract Resolution"
	quest.C3000000000000EA.quest_subtitle: "Defense"
	quest.C3000000000000EA.quest_desc: ["Original effect: Increases the DEF of Defender and Supporter Operators by +10% for each Defender or Supporter Operator in the combat squad.", "Description: Use the hardest shield to block the sharpest spear. I guarantee you that the spear will break first, trust me.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000EA.title: "Obtain Fortification Contract Resolution"
	quest.C3000000000000F2.title: "Castles Offspring"
	quest.C3000000000000F2.quest_subtitle: "Defense"
	quest.C3000000000000F2.quest_desc: ["Original effect: All friendly units have +300 DEF and +30 RES 100 seconds after deployment", "Description: With enough time, this box will become a whole new stage.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F2.title: "Obtain Castles Offspring"
	quest.C3000000000000FC.title: "Extra Pungent Coffee Beans"
	quest.C3000000000000FC.quest_subtitle: "Defense"
	quest.C3000000000000FC.quest_desc: ["Original effect: +1 Squad Size Limit, +1 Deployment Limit, +1 Objective Shield", "Description: Coffee growers feed their beans to a rare, unusual-smelling breed of fowlbeast before extracting and processing them from its excrement. The unique aroma produced by the beast's gastric acid fermentation triples the price of the coffee beans.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000FC.title: "Obtain Extra Pungent Coffee Beans"
	quest.C300000000000108.title: "Medicine Sticks"
	quest.C300000000000108.quest_subtitle: "Defense"
	quest.C300000000000108.quest_desc: ["Original effect: All friendly units gain 2 layers of Shield when deployed", "Description: In ancient times, whenever Great Yan's armies fought, they would march forward carrying these. Mulberry drew inspiration from this and made an edible plaster, excellent for working out the masseter muscle and revitalizing one's spirit.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000108.title: "Obtain Medicine Sticks"
	quest.C300000000000117.title: "Iron Guard Moving Fortress"
	quest.C300000000000117.quest_subtitle: "Defense"
	quest.C300000000000117.quest_desc: ["Original effect: Defender Operators have +100% ATK, +100% DEF, and +1 Block for 15 seconds after deployment", "Description: Nobody can break through their defenses, and even fewer are able to escape from their assault. If every combatant has a mission, then that mission is to change the situation on the battlefield the moment they enter the fray.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000117.title: "Obtain Iron Guard Moving Fortress"
	quest.C300000000000119.title: "Healer S Path Restore Sanity"
	quest.C300000000000119.quest_subtitle: "Defense"
	quest.C300000000000119.quest_desc: ["Original effect: Friendly units within the attack range of Medic Operators gain Status Resistance", "Description: Making one's body as solid as a nomadic city is a bit of a romanticized description, but our medics are ready to put that idea into practice.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000119.title: "Obtain Healer S Path Restore Sanity"
	quest.C300000000000121.title: "Terrain Map"
	quest.C300000000000121.quest_subtitle: "Defense"
	quest.C300000000000121.quest_desc: ["Original effect: 【结构化】可同时部署人数+1，所有我方单位的防御力+4%\n【半结构化】可同时部署人数+1，所有我方单位的防御力+5%\n【非结构化】可同时部署人数+1，所有我方单位的防御力+6%\n【混沌化】可同时部署人数+1，所有我方单位的防御力+8%", "Description: 一份颇有年代感的手绘地图，图上的名称和对应地形都有较大更易，比例尺似乎也有些问题。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000121.title: "Obtain Terrain Map"
	quest.C300000000000123.title: "Night Talk In The Woods"
	quest.C300000000000123.quest_subtitle: "Defense"
	quest.C300000000000123.quest_desc: ["Original effect: 【结构化】可同时部署人数+2，所有我方单位的防御力+6%\n【半结构化】可同时部署人数+2，所有我方单位的防御力+7%\n【非结构化】可同时部署人数+2，所有我方单位的防御力+8%\n【混沌化】可同时部署人数+2，所有我方单位的防御力+10%", "Description: 疗养庭院为有外勤任务的干员特调的香薰套装，提炼十五种植物成分，尝试一百七十二种组合。风踏进山林，万物低语，人可好眠。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000123.title: "Obtain Night Talk In The Woods"
	quest.C300000000000127.title: "Multipurpose Hair Clip"
	quest.C300000000000127.quest_subtitle: "Defense"
	quest.C300000000000127.quest_desc: ["Original effect: +1 Key, +1 Die Roll, +1 Objective Shield", "Description: Its materials are clearly damage-resistant, but are its other functions as impressive as what the Kazimierzian merchant boasted? Come to think of it, why does a bobby pin need so many extra features anyway?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000127.title: "Obtain Multipurpose Hair Clip"
	quest.C30000000000012D.title: "Defender 2"
	quest.C30000000000012D.quest_subtitle: "Defense"
	quest.C30000000000012D.quest_desc: ["Original effect: +5 Objective Shield", "Description: A mass-produced defensive-type drone. It doesn't make sense how it only seems to be useful in the hands of the enemy.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000012D.title: "Obtain Defender 2"
	quest.C30000000000014F.title: "Determination"
	quest.C30000000000014F.quest_subtitle: "Defense"
	quest.C30000000000014F.quest_desc: ["Original effect: All Operators gain Block +2, DEF and HP +120%, and RES +20; leads the exploration towards a different conclusion", "Description: Mizuki's humanity has not faded. He has accepted the Seaborn as a human, and he can transform back from a Seaborn to a human.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000014F.title: "Obtain Determination"
	quest.C30000000000015E.title: "Wrankwood Safety Suit"
	quest.C30000000000015E.quest_subtitle: "Defense"
	quest.C30000000000015E.quest_desc: ["Original effect: For each Cursed Curio you have, all allied units gain DEF +25%, RES +10", "Description: Used at Wrankwood studios for high-difficulty shoots. Inspired by military gear. FEater once refused to wear it while shooting a collaborative project.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000015E.title: "Obtain Wrankwood Safety Suit"
	quest.C300000000000163.title: "Broken Wand Solving"
	quest.C300000000000163.quest_subtitle: "Defense"
	quest.C300000000000163.quest_desc: ["Original effect: For every [Caster] Operator on the field, enemy RES -12", "Description: A caster's greatest enemy is another caster.\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000163.title: "Obtain Broken Wand Solving"
	quest.C300000000000164.title: "Iron Guard Wall"
	quest.C300000000000164.quest_subtitle: "Defense"
	quest.C300000000000164.quest_desc: ["Original effect: [Defender] Operators gain DEF +40%, RES +10", "Description: No one is stupid enough to ram a wall with their body, right?\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000164.title: "Obtain Iron Guard Wall"
	quest.C300000000000165.title: "Iron Guard Tower"
	quest.C300000000000165.quest_subtitle: "Defense"
	quest.C300000000000165.quest_desc: ["Original effect: [Defender] Operators gain DEF +70%, RES +20, Elemental Injury taken -60%", "Description: It rises into the clouds, looking down at the enemies jumping up and down by its feet.\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000165.title: "Obtain Iron Guard Tower"
	quest.C300000000000166.title: "Survivor Contract"
	quest.C300000000000166.quest_subtitle: "Defense"
	quest.C300000000000166.quest_desc: ["Original effect: At the start of battle, a random Operator gains +20% ATK and DEF, plus an additional +20% at the end of each battle", "Description: A very long contract, in which every term and condition is the result of experience, leaving no room for chance or sentiment. Satisfy them all to be the final survivor.\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000166.title: "Obtain Survivor Contract"
	quest.C300000000000167.title: "Fosterer Genotype"
	quest.C300000000000167.quest_subtitle: "Defense"
	quest.C300000000000167.quest_desc: ["Original effect: An Operator with Rejection will assimilate 2 nearby normal Operators. When assimilation is complete, the Operator with Rejection temporarily gains [Evolution]: Rejection has no effect, gains 35% Sanctuary, attacks ignore 35% RES and DEF", "Description: Collective evolution is driven by individual mutation. Individual problems are solved by collective intelligence. Lu is highly confident in this model. If the Fosterer Project has enough time, perhaps...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000167.title: "Obtain Fosterer Genotype"
	quest.C300000000000168.title: "Spectrum Analyzer"
	quest.C300000000000168.quest_subtitle: "Defense"
	quest.C300000000000168.quest_desc: ["Original effect: Anti-Interference Index +1, +2 Objective Shield", "Description: Please be careful regarding the abnormal phenomena in Sami. The results from measuring electromagnetic radiation and analyzing the specimen's micro-crystals are completely incompatible.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000168.title: "Obtain Spectrum Analyzer"
	quest.C300000000000175.title: "Finshell Shield"
	quest.C300000000000175.quest_subtitle: "Defense"
	quest.C300000000000175.quest_desc: ["Original effect: All allied ranged units gain 3 layers of Shield on deployment", "Description: The stacks of distant trauma cannot surpass the layers of protection built by the body.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000175.title: "Obtain Finshell Shield"
	quest.C30000000000017B.title: "Lakebed Aegis"
	quest.C30000000000017B.quest_subtitle: "Defense"
	quest.C30000000000017B.quest_desc: ["Original effect: Objective Shield +1; all allied units gain Max HP +60% if you have any Objective Shield at the beginning of a battle", "Description: Three decades ago, a child dropped his toy wooden shield into the lake. Three decades later, he bores through the frozen lake, retrieves his shield, and embarks on a hero's journey.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000017B.title: "Obtain Lakebed Aegis"
	quest.C30000000000017C.title: "Ancient Fresco"
	quest.C30000000000017C.quest_subtitle: "Defense"
	quest.C30000000000017C.quest_desc: ["Original effect: When an enemy enters or is freed from Levitation and/or Weightless, they take 1000 Arts damage and are Silenced for 10 seconds", "Description: Walk out of the cave, and raise your head. This has never been right, even since antiquity.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000017C.title: "Obtain Ancient Fresco"
	quest.C30000000000017D.title: "Galleria Stellaria S Splendor"
	quest.C30000000000017D.quest_subtitle: "Defense"
	quest.C30000000000017D.quest_desc: ["Original effect: When an enemy enters or is freed from Levitation and/or Weightless, they take 2000 Arts damage and take 30% more damage for 10 seconds", "Description: At that moment, the light of truth shone onto the earth.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000017D.title: "Obtain Galleria Stellaria S Splendor"
	quest.C30000000000018B.title: "Hunters Insight"
	quest.C30000000000018B.quest_subtitle: "Defense"
	quest.C30000000000018B.quest_desc: ["Original effect: All Operators ignore 50% DEF and RES when attacking [Collapsals], and Slow them for 0.5 sec", "Description: Before her will is completely wrested away, the girl begs the rescuer approaching her: 'Let me draw the bowstring, let me defeat it, let me never fear.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000018B.title: "Obtain Hunters Insight"
	quest.C300000000000191.title: "Sprouted Stick"
	quest.C300000000000191.quest_subtitle: "Defense"
	quest.C300000000000191.quest_desc: ["Original effect: Gain +2 Objective Shield when entering Bosky Passage or Lost and Found nodes", "Description: It accompanied a sturdy and swarthy Kuranta out of the country of sand, accompanied him, the Director of Rhine Lab's Scientific Investigation Section, into the silverwhite plains. Even though it was separated from its owner in an accident, it can still bring its wielder a revelation about survival.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000191.title: "Obtain Sprouted Stick"
	quest.C3000000000001A0.title: "Blindness"
	quest.C3000000000001A0.quest_subtitle: "Defense"
	quest.C3000000000001A0.quest_desc: ["Original effect: When Anti-Interference Index is at 0 to 1, moving horizontally or vertically will randomly grant you Objective Shield, Originium Ingot, Hope, Anti-Interference Index, or Foldartal", "Description: These days, there is no one capable of determining if they still retain the structure of a Sarkaz Royal Court, or if they still have a King within. The final memory that everyone can recall is the moment when a certain Cyclopes took off the black crown atop their head.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A0.title: "Obtain Blindness"
	quest.C3000000000001A2.title: "Amma S Affection"
	quest.C3000000000001A2.quest_subtitle: "Defense"
	quest.C3000000000001A2.quest_desc: ["Original effect: All allied units gain +1% HP, ATK, and DEF; occasionally something wonderful will happen", "Description: It does love you, as is evident from the weight in your pocket, but Its love is fleeting and fickle, and you never know if what you retrieve from your pocket will be proof of Its protection or a handful of melted snow.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A2.title: "Obtain Amma S Affection"
	quest.C3000000000001AC.title: "Iron Guard Rampart"
	quest.C3000000000001AC.quest_subtitle: "Defense"
	quest.C3000000000001AC.quest_desc: ["Original effect: For every Defender Operator on the field, all allies take 10% less physical damage (stacks up to 8 times)", "Description: Gather sand to form a tower, and gaze upon enemies from above.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001AC.title: "Obtain Iron Guard Rampart"
	quest.C3000000000001AE.title: "Broken Wand Harmony"
	quest.C3000000000001AE.quest_subtitle: "Defense"
	quest.C3000000000001AE.quest_desc: ["Original effect: For every Caster Operator on the field, all allies deal +12% Arts damage (stacks up to 8 times)", "Description: The solos have their merits, but a chorus can destroy everything.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001AE.title: "Obtain Broken Wand Harmony"
	quest.C3000000000001B7.title: "Shattered Alliance Treaty"
	quest.C3000000000001B7.quest_subtitle: "Defense"
	quest.C3000000000001B7.quest_desc: ["Original effect: All Operators receive 50% less damage from Sarkaz and Possessed enemies", "Description: What are the Sarkaz in the eyes of others? Perhaps this object can explain everything.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001B7.title: "Obtain Shattered Alliance Treaty"
	quest.C3000000000001C9.title: "Broken Wand Undulation"
	quest.C3000000000001C9.quest_subtitle: "Defense"
	quest.C3000000000001C9.quest_desc: ["Original effect: For every Caster Operator on the field, all allied units deal +12% Arts damage (Stacks up to 8 times)", "Description: Tuned to the same frequency; together we'll play the melody.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C9.title: "Obtain Broken Wand Undulation"
	quest.C3000000000001D9.title: "Disaster S Origin"
	quest.C3000000000001D9.quest_subtitle: "Defense"
	quest.C3000000000001D9.quest_desc: ["Original effect: All enemies take +20% Arts damage and +100% Elemental Injury", "Description: The Sarkaz dug through the Targangils Prime Vein and Originium crystals spurted forth from Kazdel. Their fall was inevitable, so they wanted everything on this great land to be buried together with them.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D9.title: "Obtain Disaster S Origin"
	quest.C3000000000001DA.title: "Slave Hunter"
	quest.C3000000000001DA.quest_subtitle: "Defense"
	quest.C3000000000001DA.quest_desc: ["Original effect: Units that become Levitated, Weightless, or are shifted will take 50% more damage for 10 seconds", "Description: After obtaining Nasti's designs, the Sarkaz put them to use in war right away. They flew into the sky, dominating the Ancients with waves of wrath, and the never-ending war entered a new stage.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001DA.title: "Obtain Slave Hunter"
	quest.C3000000000001E2.title: "Song To Make A Tenacious Mind"
	quest.C3000000000001E2.quest_subtitle: "Defense"
	quest.C3000000000001E2.quest_desc: ["Original effect: Every Inspirer used grants +1 Shield", "Description: The song tells of a Djall born with the ability to sense fear. She was candid with what she sensed, but everyone was still wary. She later honed her skills to defeat foes without this power, yet remained known as the 'Arch-liar'.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E2.title: "Obtain Song To Make A Tenacious Mind"
	quest.C3000000000001EE.title: "Crystal Mystery"
	quest.C3000000000001EE.quest_subtitle: "Defense"
	quest.C3000000000001EE.quest_desc: ["Original effect: All low ground Operators have +600 DEF but are Frozen for 15 seconds after deployment; only active in Bizarre Fragments", "Description: 'The Rotproofers' descendants, called 'Ice Gargoyles,' complemented the Diαblos with their icy powers and cool heads, skillfully covering each other's flaws. But they were deceived by Kalnawdika and never resurfaced after going underground to stop the Black Flow.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001EE.title: "Obtain Crystal Mystery"
	quest.C3000000000001FD.title: "Framework Of The End"
	quest.C3000000000001FD.quest_subtitle: "Defense"
	quest.C3000000000001FD.quest_desc: ["Original effect: All Operators have +2 DP Cost; all enemies take 20% less Physical and Arts damage", "Description: Catastrophes and war, as far as the eye can see. When help cannot stop death, when medical treatment becomes only an accomplice to hatred, Amiya carries on with the only option left: the futile, mechanical act of 'saving lives'.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FD.title: "Obtain Framework Of The End"
	quest.C300000000000201.title: "Holy City S Embrace"
	quest.C300000000000201.quest_subtitle: "Defense"
	quest.C300000000000201.quest_desc: ["Original effect: Takes 35% less damage from [Sarkaz] enemies", "Description: 'O holy Kazdel! May you bless my bullets as you have blessed our eternal covenant; may you bridge my gun to my target just as you have bridged the Sankta and the Sarkaz!'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000201.title: "Obtain Holy City S Embrace"
	quest.C300000000000203.title: "Great Banshee S Veil"
	quest.C300000000000203.quest_subtitle: "Defense"
	quest.C300000000000203.quest_desc: ["Original effect: All enemies take +10% Arts damage and +50% Elemental Injury", "Description: The former Lord of the Banshees always seemed amicable, as if that were her only side... until she pulled out her bone pen, sang softly, and impaled agonizing wails into the minds of every intruder.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000203.title: "Obtain Great Banshee S Veil"
	quest.C300000000000204.title: "Fearless Blade"
	quest.C300000000000204.quest_subtitle: "Defense"
	quest.C300000000000204.quest_desc: ["Original effect: When the battle begins, the Operator with the highest DP Cost gains +50% ATK and DEF", "Description: Before Kazdel's gates he stood, an impregnable bulwark. Gaulish artilleries, Leithanian casters, and Victorian Knights all took their shots at him. Yet, even when the gates fell and the coalition retreated, the Goliath did not yield an inch.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000204.title: "Obtain Fearless Blade"
	quest.C300000000000206.title: "Gul Dul S Silence"
	quest.C300000000000206.quest_subtitle: "Defense"
	quest.C300000000000206.quest_desc: ["Original effect: All enemies gain +3000 DEF, but lose 100 DEF upon taking damage (Stacks up to 30 times)", "Description: He stood at Kazdel's highest point and turned to stone. The Elder Hegemons retreated upon witnessing his black crown, while the Sarkaz rejoiced. This spectacle they named 'King of Sarkaz' endured for a long time—until the day the Sarkaz forgot their King, and pushed the statue down with their own hands.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000206.title: "Obtain Gul Dul S Silence"
	quest.C300000000000218.title: "Visage Of Crowned Fates"
	quest.C300000000000218.quest_subtitle: "Defense"
	quest.C300000000000218.quest_desc: ["Original effect: Shield +3; converts all remaining max Life Points into an equivalent amount of Shield before reducing max Life Points to 1", "Description: Each King bears a unique fate and form.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000218.title: "Obtain Visage Of Crowned Fates"
	quest.C300000000000221.title: "Ah Meng"
	quest.C300000000000221.quest_subtitle: "Defense"
	quest.C300000000000221.quest_desc: ["Original effect: All enemies take +100% Elemental Damage", "Description: During the calamity of the bestial Sui's awakening a century ago, the Sui Regulators used specially trained beckbeasts to track and eliminate geists. This ceramic sculpture commemorates the beckbeasts' sacrifice.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000221.title: "Obtain Ah Meng"
	quest.C300000000000229.title: "Walleye"
	quest.C300000000000229.quest_subtitle: "Defense"
	quest.C300000000000229.quest_desc: ["Original effect: Allied Operators take 50% less Physical and Arts damage from sources outside their Attack Range", "Description: Its consciousness still remains. Its steps stay trapped within the wall. It shields you from wind and calamity, and watches your departure.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000229.title: "Obtain Walleye"
	quest.C30000000000024F.title: "Plucked Flower"
	quest.C30000000000024F.quest_subtitle: "Defense"
	quest.C30000000000024F.quest_desc: ["Original effect: Melee Operators have +3 DP Cost, but gain +1 Block and +50% DEF", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
