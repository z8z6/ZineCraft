	quest.C3000000000002A4.title: "Dragon S Molt"
	quest.C3000000000002A4.quest_subtitle: "Defense"
	quest.C3000000000002A4.quest_desc: ["Original effect: 我方每有1个未起飞的单位，所有单位的防御力+10%", "Description: 从这张完整的蛇蜕中，仍能窥见它的所有者曾盘踞于地面称霸的模样，但胜负已定，落败者需付出代价。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002A4.title: "Obtain Dragon S Molt"
	quest.C3000000000002A6.title: "Fire In Ice"
	quest.C3000000000002A6.quest_subtitle: "Defense"
	quest.C3000000000002A6.quest_desc: ["Original effect: 敌人受到的元素损伤和元素伤害+75%", "Description: 火一直在燃烧，冰却一直未融。看起来很热，摸起来却是冷的，正如你在黑流树海中所见的一切。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002A6.title: "Obtain Fire In Ice"
	quest.C3000000000002AE.title: "Special Operations Footage"
	quest.C3000000000002AE.quest_subtitle: "Defense"
	quest.C3000000000002AE.quest_desc: ["Original effect: 我方单位的生命、攻击力、防御力+40%，指挥经验+20%", "Description: 录制影像的人活下来了，下一位观看影像的特勤调查员，祝你好运。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002AE.title: "Obtain Special Operations Footage"
	quest.C3000000000002BC.title: "Hand Of Purge And Assault"
	quest.C3000000000002BC.quest_subtitle: "Defense"
	quest.C3000000000002BC.quest_desc: ["Original effect: 敌人进入秘术师、神射手、猎手的攻击范围内时，受到一次攻击力300%的法术或物理伤害和50%的法术或物理脆弱（持续3秒）", "Description: 视域之内，寸草不生。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002BC.title: "Obtain Hand Of Purge And Assault"
