	quest.C3000000000000D4.title: "Stand In Actor"
	quest.C3000000000000D4.quest_subtitle: "No.212 · Special Rules"
	quest.C3000000000000D4.quest_desc: ["Original effect: All friendly units have +3% ATK, DEF, and Max HP", "Description: The playwright never approved of his inauguration of these shows. No matter, though. The master of ceremonies is not discouraged. He has as many understudies at his disposal.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D4.title: "Obtain Stand In Actor"
	quest.C3000000000000DB.title: "Victory Horn"
	quest.C3000000000000DB.quest_subtitle: "No.219 · Special Rules"
	quest.C3000000000000DB.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 100%", "Description: Blow the horn, cry out, and scatter our foes with its roar!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DB.title: "Obtain Victory Horn"
	quest.C3000000000000DC.title: "Flash Camera"
	quest.C3000000000000DC.quest_subtitle: "No.220 · Special Rules"
	quest.C3000000000000DC.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 110%", "Description: Every photo shot by this camera is washed out in white, with only the victim's twisted expression faintly visible.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DC.title: "Obtain Flash Camera"
	quest.C3000000000000DD.title: "Therapy Tape"
	quest.C3000000000000DD.quest_subtitle: "No.221 · Special Rules"
	quest.C3000000000000DD.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 150%", "Description: He tried to stop you from listening. He said it was dangerous. He said you should not stay. Do you understand now? You are listening to his song.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DD.title: "Obtain Therapy Tape"
	quest.C3000000000000E2.title: "Angelinas Inspiration"
	quest.C3000000000000E2.quest_subtitle: "No.226 · Special Rules"
	quest.C3000000000000E2.quest_desc: ["Original effect: All enemy units have Movement Speed -15%, and their weight is reduced by one rank", "Description: The girl has no qualms about sharing her Originium Arts. She believes that you will use it for the right reasons.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E2.title: "Obtain Angelinas Inspiration"
	quest.C3000000000000F1.title: "Painful Happiness"
	quest.C3000000000000F1.quest_subtitle: "No.PCS03 · Special Rules"
	quest.C3000000000000F1.quest_desc: ["Original effect: All enemy units have -15% HP and Movement Speed", "Description: Oripathy is spreading among the troupe members. Some collapsed, some broke out crying, some were overjoyed, and some turned their attention to writing. It was at such a time that the young man received his coming-of-age present. He will sing his very last song as an actor.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F1.title: "Obtain Painful Happiness"
	quest.C3000000000000F4.title: "Eventide Terror"
	quest.C3000000000000F4.quest_subtitle: "No.PCS06 · Special Rules"
	quest.C3000000000000F4.quest_desc: ["Original effect: Deals Stun on all enemy units for 5 seconds every time an enemy unit enters the Protection Objective", "Description: There will come a day of darkness that not even light can save. The leader of the troupe has prepared a fine wine to properly appreciate human despair.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F4.title: "Obtain Eventide Terror"

