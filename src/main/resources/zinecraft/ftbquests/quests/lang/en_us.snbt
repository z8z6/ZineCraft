	quest.C300000000000179.title: "Rock Horn"
	quest.C300000000000179.quest_subtitle: "Offense"
	quest.C300000000000179.quest_desc: ["Original effect: All Operators gain ATK +20% for every Operator in the adjacent 4 tiles", "Description: If you want to gather up manpower in Sami, blowing a trumpet is definitely the best way to do it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
