	quest.C30000000000009D.quest_desc: ["Original effect: Increases the SP regen rate of Offensive and Defensive Recovery skills by 1 SP per 3.5s.", "Description: A cheap distilled spirit originally produced in Bolívar. It has a strong taste and is widely praised by Columbia's explorers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009D.title: "Obtain Barrens Tequila"
	quest.C30000000000009E.title: "Captain Morgans Wine"
