	quest.C30000000000013B.quest_desc: ["Original effect: All Operators lose 15 SP when deployed", "Description: The subject of the portrait is an Ægir who used to be well-known in Iberia. His inventions and feats once made the country shine, but when the tide drowned out the golden light, his fate was sealed.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000013B.title: "Obtain Portrait Of Breogan"
	quest.C300000000000145.title: "The Knight S Corpus"
	quest.C300000000000145.quest_subtitle: "Offense"
	quest.C300000000000145.quest_desc: ["Original effect: [Tide-Hunt Knight] has -80% DEF", "Description: Resisting does not come without a price. The knight's body had long since become riddled with wounds, but he paid no heed. He will fight until the bitter end, even should his body be smashed to pieces.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000145.title: "Obtain The Knight S Corpus"
