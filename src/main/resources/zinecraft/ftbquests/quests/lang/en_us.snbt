	quest.C300000000000072.quest_desc: ["Original effect: Caster Operators have +25% ATK.", "Description: Those who gaze up at the great spires in Leithanien often see some strange or even celestial phenomena.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
