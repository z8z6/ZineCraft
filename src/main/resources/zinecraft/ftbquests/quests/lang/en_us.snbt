	quest.C3000000000000CB.title: "Whiteflower"
	quest.C3000000000000CB.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000CB.quest_desc: ["Original effect: When the battle begins, randomize all allied operators' Deployment Cost", "Description: An artifact left behind by a 'Crimson Troupe' member. The stage name 'White Solanum' belonged to a famous Leithanian opera actress. Supposedly, the actress revered as the 'Whiteflower that stands atop the high tower' had complex relationships with many of the tower's nobles, and she even tried to spark a few scuffles among them.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000CB.title: "Obtain Whiteflower"
	quest.C3000000000000CC.title: "Shadow"
	quest.C3000000000000CC.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000CC.quest_desc: ["Original effect: Increase the probability of Temporary Recruitment when using Recruitment Voucher", "Description: An artifact left behind by a 'Crimson Troupe' member. The rumor has it that, before he joined the troupe, the 'Shadow' was a Siracusan stage caster famous for his superb illusionary techniques. It is also said that he killed many members of the family during his performances with his Originium Arts.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000CC.title: "Obtain Shadow"
	quest.C3000000000000D1.title: "Useless Scissors"
	quest.C3000000000000D1.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000D1.quest_desc: ["Original effect: Immediately adds +11 Originium Ingots and +3 Hope", "Description: This pair of scissors has been used for far, far too long. So long that it can no longer cut anything tangible, and so long that it can cut all things intangible to shreds.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D1.title: "Obtain Useless Scissors"
	quest.C3000000000000D3.title: "Mantle Of The Wrongly Condemned"
	quest.C3000000000000D3.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000D3.quest_desc: ["Original effect: All friendly units have +2 DP Cost.", "Description: The crazed Caster of the tower organized a special banquet. All the guests who were present at the reception hall out of courtesy became witnesses when the curtain rose.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D3.title: "Obtain Mantle Of The Wrongly Condemned"
	quest.C3000000000000D6.title: "Dance Of The Condemned"
	quest.C3000000000000D6.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000D6.quest_desc: ["Original effect: Operator redeployment time -10%", "Description: They have trapped themselves in this place. Ah, peace and quiet. No one can interrupt this creation now.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D6.title: "Obtain Dance Of The Condemned"
	quest.C3000000000000DF.title: "Tear Of The Departed"
	quest.C3000000000000DF.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000DF.quest_desc: ["Original effect: All Operators gain 50% Sanctuary when affected by a negative status such as stun, cold or freeze", "Description: Forged with honesty and perseverance. No flame has burned in Whitesmith's furnace ever since.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
