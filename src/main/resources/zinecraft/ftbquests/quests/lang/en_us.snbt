	quest.C30000000000009A.title: "Ball Juice"
	quest.C30000000000009A.quest_subtitle: "Offense"
	quest.C30000000000009A.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.25/s", "Description: They call it fruit juice, but it's actually alcohol. The bottle itself states that minors are forbidden from drinking it. Its Victorian place of origin once fell within Gaul's territory.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009A.title: "Obtain Ball Juice"
	quest.C30000000000009B.title: "Fowlbeast Liver Pate"
	quest.C30000000000009B.quest_subtitle: "Offense"
	quest.C30000000000009B.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.35/s", "Description: A small jar of fowlbeast liver pâté. Bright and vividly colorful, it is eaten only by nobles.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009B.title: "Obtain Fowlbeast Liver Pate"
	quest.C30000000000009C.title: "Dreaming Essence"
	quest.C30000000000009C.quest_subtitle: "Offense"
	quest.C30000000000009C.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.5/s", "Description: Supposedly the Banshees make their aromatics only for their beloved. A single drop is enough to enchant just about anyone, bringing out any artist's inspiration and creativity.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009C.title: "Obtain Dreaming Essence"
