	quest.C3000000000000B1.quest_subtitle: "Special Rules"
	quest.C3000000000000B1.quest_desc: ["Original effect: All enemy units have +40% ATK, DEF, and Max HP", "Description: The currents of steel and iron gush forth on the barren plains. From afar surge an inviolable, absolute will. Wheresoever my hands reach, there stands Ursus.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
