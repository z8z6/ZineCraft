	task.C4000000000000B8.title: "Obtain Gaul Mantle Reforged"
	quest.C3000000000000BB.title: "Sigil Of Tragodia"
	quest.C3000000000000BB.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000BB.quest_desc: ["Original effect: All enemy units have +30% ATK, DEF, and Max HP; Deployment Limit -2", "Description: A symbol that can be seen everywhere within the Crimson Troupe. It burns the troupe leader and his pursuit for the arts into the eyes of all those who lay their eyes upon it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000BB.title: "Obtain Sigil Of Tragodia"
