	quest.C3000000000000BC.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000BC.quest_desc: ["Original effect: All enemy units have +35% ATK, DEF, and Max HP; Deployment Limit -3, but gain Deployment Limit +2 whenever you enter the Downtime Recreation node", "Description: A symbol that can be seen everywhere within the Crimson Troupe. It burns the troupe leader and his pursuit for the arts into the eyes of all those who lay their eyes upon it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000BC.title: "Obtain Sigil Of Tragodia Reforged"
	quest.C3000000000000BD.title: "Playwrights Manuscript Victoria"
	quest.C3000000000000BD.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000000BD.quest_desc: ["Original effect: All enemy units have +10% ATK, DEF, and Max HP; Operators cost +1 Hope to recruit (effect lasts for 1 recruit)", "Description: 'The Feline's crown shatters into pieces—'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
