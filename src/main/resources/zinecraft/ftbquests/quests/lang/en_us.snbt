	quest.C300000000000172.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000172.quest_desc: ["Original effect: The DP Cost and Redeployment Time of all Operators is randomly changed", "Description: There is no direction you can head to avoid misfortune.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000172.title: "Obtain Clairvoyant S Reveal"
