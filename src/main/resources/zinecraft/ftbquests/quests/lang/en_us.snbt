	quest.C3000000000000BA.title: "Half Refined Diamond Reforged"
	quest.C3000000000000BA.quest_subtitle: "Special Rules"
	quest.C3000000000000BA.quest_desc: ["Original effect: All enemy units have +30% ATK, DEF, and Max HP; Gain -70% Command EXP from battles; Dreadful Foe nodes grant 15x Command EXP", "Description: Half of it shines radiantly in the name of art, while the other half is stained in a madder red color that signifies madness. This is the 'Phantom' that the troupe leader has always dreamt of.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000BA.title: "Obtain Half Refined Diamond Reforged"
	quest.C3000000000000D2.title: "Blank Suicide Note"
	quest.C3000000000000D2.quest_subtitle: "Special Rules"
	quest.C3000000000000D2.quest_desc: ["Original effect: Neutralizes Big Sad Lock's Self-Healing abilities", "Description: His only wish was to escape the madman who wanted control over him. Now, he got his wish.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D2.title: "Obtain Blank Suicide Note"
	quest.C3000000000000D4.title: "Stand In Actor"
	quest.C3000000000000D4.quest_subtitle: "Special Rules"
	quest.C3000000000000D4.quest_desc: ["Original effect: All friendly units have +3% ATK, DEF, and Max HP", "Description: The playwright never approved of his inauguration of these shows. No matter, though. The master of ceremonies is not discouraged. He has as many understudies at his disposal.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D4.title: "Obtain Stand In Actor"
	quest.C3000000000000DB.title: "Victory Horn"
	quest.C3000000000000DB.quest_subtitle: "Special Rules"
	quest.C3000000000000DB.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 100%", "Description: Blow the horn, cry out, and scatter our foes with its roar!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DB.title: "Obtain Victory Horn"
	quest.C3000000000000DC.title: "Flash Camera"
	quest.C3000000000000DC.quest_subtitle: "Special Rules"
	quest.C3000000000000DC.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 110%", "Description: Every photo shot by this camera is washed out in white, with only the victim's twisted expression faintly visible.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DC.title: "Obtain Flash Camera"
	quest.C3000000000000DD.title: "Therapy Tape"
	quest.C3000000000000DD.quest_subtitle: "Special Rules"
	quest.C3000000000000DD.quest_desc: ["Original effect: Duration of single instance status effects such as stun, cold or freeze is increased by 150%", "Description: He tried to stop you from listening. He said it was dangerous. He said you should not stay. Do you understand now? You are listening to his song.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DD.title: "Obtain Therapy Tape"
	quest.C3000000000000E2.title: "Angelinas Inspiration"
	quest.C3000000000000E2.quest_subtitle: "Special Rules"
	quest.C3000000000000E2.quest_desc: ["Original effect: All enemy units have Movement Speed -15%, and their weight is reduced by one rank", "Description: The girl has no qualms about sharing her Originium Arts. She believes that you will use it for the right reasons.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E2.title: "Obtain Angelinas Inspiration"
	quest.C3000000000000F1.title: "Painful Happiness"
	quest.C3000000000000F1.quest_subtitle: "Special Rules"
	quest.C3000000000000F1.quest_desc: ["Original effect: All enemy units have -15% HP and Movement Speed", "Description: Oripathy is spreading among the troupe members. Some collapsed, some broke out crying, some were overjoyed, and some turned their attention to writing. It was at such a time that the young man received his coming-of-age present. He will sing his very last song as an actor.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F1.title: "Obtain Painful Happiness"
	quest.C3000000000000F4.title: "Eventide Terror"
	quest.C3000000000000F4.quest_subtitle: "Special Rules"
	quest.C3000000000000F4.quest_desc: ["Original effect: Deals Stun on all enemy units for 5 seconds every time an enemy unit enters the Protection Objective", "Description: There will come a day of darkness that not even light can save. The leader of the troupe has prepared a fine wine to properly appreciate human despair.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000F4.title: "Obtain Eventide Terror"
	quest.C300000000000115.title: "Uncle Vought Total Care Kit"
	quest.C300000000000115.quest_subtitle: "Special Rules"
	quest.C300000000000115.quest_desc: ["Original effect: All friendly ranged units take 40% less Elemental Injury", "Description: A complete care kit produced by the Columbian old salon product manufacturer, 'Uncle Vought.' Provence has modeled for this product. 'Take good care of your tail and your ears - after all, they're your second face.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000115.title: "Obtain Uncle Vought Total Care Kit"
	quest.C300000000000116.title: "Ursus Felt Rug"
	quest.C300000000000116.quest_subtitle: "Special Rules"
	quest.C300000000000116.quest_desc: ["Original effect: All friendly melee units take 40% less Elemental Injury", "Description: The people of Ursus will spread this special felt rug across their cellars when storing grains for the winter, in order to absorb water and prevent moisture. When the cellar becomes a hiding place, it also helps shelter the occupants from the wind and snow for a while.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000116.title: "Obtain Ursus Felt Rug"
	quest.C300000000000129.title: "Portable Scriptures"
	quest.C300000000000129.quest_subtitle: "Special Rules"
	quest.C300000000000129.quest_desc: ["Original effect: +2 Die Rolls", "Description: The few Iberian faithfuls who can still read often carry around a pocket-sized version of the Scriptures with them, taking it out to glance over a few lines during the brief lulls in their struggles for survival. It offers but a modicum of peace.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000129.title: "Obtain Portable Scriptures"
	quest.C30000000000012A.title: "Inquisitor S Scripture Cloth"
	quest.C30000000000012A.quest_subtitle: "Special Rules"
	quest.C30000000000012A.quest_desc: ["Original effect: Gain +1 Die Roll after each battle", "Description: As part of the decorations adorning an Inquisitor's clothing, this ribbon is inlaid with the Scriptures. Their hearts are firm and unwavering, and these accessories reinforce that image.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000012A.title: "Obtain Inquisitor S Scripture Cloth"
	quest.C30000000000012B.title: "Deep Sea Sire Sculpture"
	quest.C30000000000012B.quest_subtitle: "Special Rules"
	quest.C30000000000012B.quest_desc: ["Original effect: +6 Die Rolls", "Description: The Church of the Deep cultists believe that gods sleep in the depths of the ocean, and the teeming Sea Terrors seem to confirm their beliefs. Seeing as that is indeed the truth, they no longer have any reason to hesitate.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000012B.title: "Obtain Deep Sea Sire Sculpture"
	quest.C30000000000012C.title: "Duck Lord S Golden Brick"
	quest.C30000000000012C.quest_subtitle: "Special Rules"
	quest.C30000000000012C.quest_desc: ["Original effect: Upgrades your die", "Description: 'How can someone completely rid themselves of misfortune?' \n'You have a gold brick in your hand, don't you? Shove it up misfortune's mouth.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000012C.title: "Obtain Duck Lord S Golden Brick"
	quest.C300000000000134.title: "Cathedral Puzzle"
	quest.C300000000000134.quest_subtitle: "Special Rules"
	quest.C300000000000134.quest_desc: ["Original effect: When obtained, randomly gain 1 Revelation", "Description: Every time a piece of the puzzle falls, the Iberian Cathedral becomes more complete. In these times of decay, there is ample comfort to be found in simply being able to piece together one of history's most glorious wonders.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000134.title: "Obtain Cathedral Puzzle"
	quest.C300000000000135.title: "Support Replenishment Station"
	quest.C300000000000135.quest_subtitle: "Special Rules"
	quest.C300000000000135.quest_desc: ["Original effect: Bring a Portable Supply Station along to each battle", "Description: An emergency Portable Supply Station provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000135.title: "Obtain Support Replenishment Station"
	quest.C300000000000136.title: "Support Landmine Set"
	quest.C300000000000136.quest_subtitle: "Special Rules"
	quest.C300000000000136.quest_desc: ["Original effect: Bring 3 Interference Mines along to each battle", "Description: An emergency set of Interference Mines provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000136.title: "Obtain Support Landmine Set"
	quest.C300000000000137.title: "Support Mr Boom"
	quest.C300000000000137.quest_subtitle: "Special Rules"
	quest.C300000000000137.quest_desc: ["Original effect: Bring 2 Mr. Booms along to each battle", "Description: An emergency Mr. Boom provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000137.title: "Obtain Support Mr Boom"
	quest.C300000000000138.title: "Support Escape Crane"
	quest.C300000000000138.quest_subtitle: "Special Rules"
	quest.C300000000000138.quest_desc: ["Original effect: Bring 2 Snowsant's Safe Escape Cranes along to each battle", "Description: An emergency Snowsant's Safe Escape Crane provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000138.title: "Obtain Support Escape Crane"
	quest.C300000000000139.title: "Support Riot Pile"
	quest.C300000000000139.quest_subtitle: "Special Rules"
	quest.C300000000000139.quest_desc: ["Original effect: Bring 2 Riot Piles along to each battle", "Description: An emergency set of Riot Piles provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000139.title: "Obtain Support Riot Pile"
	quest.C30000000000013A.title: "Support First Aid Kit"
	quest.C30000000000013A.quest_subtitle: "Special Rules"
	quest.C30000000000013A.quest_desc: ["Original effect: Bring 3 First-aid Kits to each battle", "Description: An emergency First-aid Kit provided to field operators.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000013A.title: "Obtain Support First Aid Kit"
	quest.C300000000000143.title: "Regressed Rocinante"
	quest.C300000000000143.quest_subtitle: "Special Rules"
	quest.C300000000000143.quest_desc: ["Original effect: [Tide-Hunt Knight] will no longer appear on the battlefield", "Description: Only a hero can ride it. When the hero dies, so too does its life end.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000143.title: "Obtain Regressed Rocinante"
	quest.C300000000000146.title: "Last Refrain"
	quest.C300000000000146.quest_subtitle: "Special Rules"
	quest.C300000000000146.quest_desc: ["Original effect: When obtained, randomly gain 2 Revelations", "Description: Cry, cry, for where are the Abyssal Hunters now? \nAlas, alas, there is nothing in the ocean but the sound of the tide.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000146.title: "Obtain Last Refrain"
	quest.C300000000000148.title: "Little Gran Faro"
	quest.C300000000000148.quest_subtitle: "Special Rules"
	quest.C300000000000148.quest_desc: ["Original effect: Deals Stun on all enemy units for 5 seconds every time an enemy unit enters the Protection Objective", "Description: The illumination device produced after reverse engineering the Eye of Iberia. It is powerful enough to penetrate layers of dark clouds, as well as temporarily repel powerful enemies.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000148.title: "Obtain Little Gran Faro"
	quest.C30000000000014A.title: "Glory Pack"
	quest.C30000000000014A.quest_subtitle: "Special Rules"
	quest.C30000000000014A.quest_desc: ["Original effect: When an Operator is defeated, it will Stun all enemies in the four adjacent tiles for 6 seconds", "Description: A special betting method set up by the organizers for the duration of the knight competition season. Choose from a variety of complementary betting packages to minimize your losses on any particular match.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000014A.title: "Obtain Glory Pack"
	quest.C30000000000017E.title: "Cloud Moving Totem"
	quest.C30000000000017E.quest_subtitle: "Special Rules"
	quest.C30000000000017E.quest_desc: ["Original effect: All enemies have -15% Movement Speed, and the Weightless effect further drops their Weight Level by 2", "Description: The Sami tribe that believes in the King of Fowlbeasts created this totem. It is said that a sincere call will stir its wings, raising a storm and making the earth tremble.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000017E.title: "Obtain Cloud Moving Totem"
	quest.C300000000000185.title: "Full Auto Maintenance Station"
	quest.C300000000000185.quest_subtitle: "Special Rules"
	quest.C300000000000185.quest_desc: ["Original effect: Anti-Interference Index +2, but +2 Collapse value", "Description: It's a little dirty, but can run on complete full-auto. And, for reasons no one knows, even runs from morning to night when no one's using it. Raythean Industries claims to have never designed such a product.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000185.title: "Obtain Full Auto Maintenance Station"
	quest.C300000000000188.title: "Wandering Caster S Nostalgia"
	quest.C300000000000188.quest_subtitle: "Special Rules"
	quest.C300000000000188.quest_desc: ["Original effect: When entering Secluded Passage, -3 Collapse value", "Description: Someone has copied these notes down in a desperate attempt to remember them. The melody performed by the blade cutting through the air is strangely harmonious, but does not follow the equal temperament of music at all.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000188.title: "Obtain Wandering Caster S Nostalgia"
	quest.C30000000000018D.title: "Ancient Tree Fruit"
	quest.C30000000000018D.quest_subtitle: "Special Rules"
	quest.C30000000000018D.quest_desc: ["Original effect: Immediately obtain 3 random trinkets", "Description: The children of Sami made their wishes into tree seeds, and buried them in the snow. When the tree bears fruit, the first four are taken, and the smallest is left for future generations to make their wishes. The remaining fruits are tributes to Sami, praying for answers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000018D.title: "Obtain Ancient Tree Fruit"
	quest.C300000000000193.title: "Guiding Vinedoll"
	quest.C300000000000193.quest_subtitle: "Special Rules"
	quest.C300000000000193.quest_desc: ["Original effect: Anti-Interference Index has a chance to not decrease when traveling through a vertical path", "Description: The shamans often make these little puppets out of vines to navigate the forest. Even though they are not very accurate, striking true can conserve a lot of the survey equipment's energy.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000193.title: "Obtain Guiding Vinedoll"
	quest.C300000000000194.title: "Broken Ursus Blade"
	quest.C300000000000194.quest_subtitle: "Special Rules"
	quest.C300000000000194.quest_desc: ["Original effect: Gain Command EXP +10% for each level of Collapsal Paradigm", "Description: It was not for a lack of determination; his willpower is beyond question. It was only that, at that moment of self-determination, his body instinctively committed an irreversible mistake.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000194.title: "Obtain Broken Ursus Blade"
	quest.C300000000000195.title: "Slytooth Forest Destroyer"
	quest.C300000000000195.quest_subtitle: "Special Rules"
	quest.C300000000000195.quest_desc: ["Original effect: Battles have a chance to drop an extra 1 Foldartal", "Description: When it discovered that humans were willing to exchange tree fruits for wood chips, this musbeast began to unscrupulously devour the forest bark for more chips. It may not have expected that many of those chips would embody Sami's supreme will.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000195.title: "Obtain Slytooth Forest Destroyer"
	quest.C300000000000196.title: "Support Fog Machine"
	quest.C300000000000196.quest_subtitle: "Special Rules"
	quest.C300000000000196.quest_desc: ["Original effect: Bring a Broken Fog Machine along to each battle", "Description: An emergency Fog Machine provided to field operators that appears to be broken.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000196.title: "Obtain Support Fog Machine"
	quest.C300000000000197.title: "Altar Type Radar"
	quest.C300000000000197.quest_subtitle: "Special Rules"
	quest.C300000000000197.quest_desc: ["Original effect: Bring 1 Altar-type Radar to each battle", "Description: Wireless locating device that can be quickly deployed and withdrawn to avoid friendly casualties. After returning from Chernobog, engineers have worked to understand the principles behind the device, overcoming the harm they once caused.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000197.title: "Obtain Altar Type Radar"
	quest.C300000000000198.title: "R 45 Portable Gramophone"
	quest.C300000000000198.quest_subtitle: "Special Rules"
	quest.C300000000000198.quest_desc: ["Original effect: Bring 1 R-45 Portable 'Gramophone' to each battle", "Description: Originium Arts conductor prototype, part of Engineering's attempt to create a transmission protocol that operators with lower Originium Arts Assimilation can use. Criticized by some Leithanians as lacking in elegance.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000198.title: "Obtain R 45 Portable Gramophone"
	quest.C300000000000199.title: "Ornamental Giant Mushroom"
	quest.C300000000000199.quest_subtitle: "Special Rules"
	quest.C300000000000199.quest_desc: ["Original effect: Bring 2 Ornamental Giant Mushrooms to each battle", "Description: Manmade shelter that provides cover from the weather. Blatantly artificial, it fails to blend into the environment even in the jungles of Sargon.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000199.title: "Obtain Ornamental Giant Mushroom"
	quest.C30000000000019A.title: "Field Device Lud 99x"
	quest.C30000000000019A.quest_subtitle: "Special Rules"
	quest.C30000000000019A.quest_desc: ["Original effect: Field Device LUD-99X appears in all battles", "Description: Every operator seems to have a different idea about what this is. Some saw a stool, others a crowbar. Meanwhile, Closure and most engineering operators insist that its serial number is assigned to a conceptual model that has never been produced. Nor will it ever be.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000019A.title: "Obtain Field Device Lud 99x"
	quest.C30000000000019C.title: "Self Driving Recon Cart"
	quest.C30000000000019C.quest_subtitle: "Special Rules"
	quest.C30000000000019C.quest_desc: ["Original effect: Bring 1 Recon Self-Driver Launchpoint to each battle", "Description: Autonomous device that can collect data and record video in areas too dangerous for operators to enter. Like most Durin designs, it spent a large portion of its development cycle as a toy for operators before field testing was conducted.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000019C.title: "Obtain Self Driving Recon Cart"
	quest.C3000000000001B3.title: "Minoan Ode"
	quest.C3000000000001B3.quest_subtitle: "Special Rules"
	quest.C3000000000001B3.quest_desc: ["Original effect: All Allies permanently gain HP +3% for every Emergency Ops cleared (stacks up to 15 times)", "Description: 'Is there a feat more worthy of praise than an expedition into no man's land? Now, yes! Go forth into the north, and write the next chapter of your saga!'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001B3.title: "Obtain Minoan Ode"
	quest.C3000000000001B6.title: "Northwind Construct"
	quest.C3000000000001B6.quest_subtitle: "Special Rules"
	quest.C3000000000001B6.quest_desc: ["Original effect: [Machine] and [Arts Creations] enemies will be immediately Frozen with their first attack for 15 seconds", "Description: Though she often fails, she is still committed to helping those who would challenge their tragic fates.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001B6.title: "Obtain Northwind Construct"
	quest.C3000000000001BC.title: "Bag Of Plans"
	quest.C3000000000001BC.quest_subtitle: "Special Rules"
	quest.C3000000000001BC.quest_desc: ["Original effect: Immediately obtain 3 Plans", "Description: Ideas like 'build a bridge here', 'grow flowers there', or 'blow this wall open' are perfect for sitting inside bags so they can be easily retrieved when needed.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001BC.title: "Obtain Bag Of Plans"
	quest.C3000000000001BD.title: "Gift Of Remembrance"
	quest.C3000000000001BD.quest_subtitle: "Special Rules"
	quest.C3000000000001BD.quest_desc: ["Original effect: Toil Limit +5", "Description: Water from the Convallis that never loses its shimmer, personally bottled by Laqeramaline Duqa Convalliss days after the miracle. The 'tear-weaving Convallis Hostess' happily gifted these vials to her dear ones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001BD.title: "Obtain Gift Of Remembrance"
	quest.C3000000000001BE.title: "Cursed War Chronicles"
	quest.C3000000000001BE.quest_subtitle: "Special Rules"
	quest.C3000000000001BE.quest_desc: ["Original effect: Toil Limit +2; Toil Limit +1 after each perfectly cleared battle", "Description: Hidden in the deepest corner of the library, this war chronicle ensnares hapless readers with its countless battles and campaigns, unraveling their minds as they resist. Eventually, the elder revenant tore out the rogue revenant in the book and sealed it in his bones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001BE.title: "Obtain Cursed War Chronicles"
	quest.C3000000000001C0.title: "Nameless Totem"
	quest.C3000000000001C0.quest_subtitle: "Special Rules"
	quest.C3000000000001C0.quest_desc: ["Original effect: Obtain 3 different Thoughts", "Description: This totem once stood at a crossroads, where those who approached would trample the vague outline of a revenant until their feet bled and they died from exhaustion. Eventually, the elder revenant shattered the token with a stomp and sealed the rogue revenant in his bones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C0.title: "Obtain Nameless Totem"
	quest.C3000000000001C5.title: "Gravity Defying Machine"
	quest.C3000000000001C5.quest_subtitle: "Special Rules"
	quest.C3000000000001C5.quest_desc: ["Original effect: All enemies have -2 Weight", "Description: Nasti Lunorey's magnum opus lifted the Sarkaz from the land that had tormented them for thousands of years. Now, though they float in ethereal clouds, they remain firmly rooted in the sky.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C5.title: "Obtain Gravity Defying Machine"
	quest.C3000000000001C6.title: "Halo"
	quest.C3000000000001C6.quest_subtitle: "Special Rules"
	quest.C3000000000001C6.quest_desc: ["Original effect: All [Sarkaz] enemies have -30% Movement Speed", "Description: 'When I entered that door, my elder brother had already sprouted a halo and wings of light. As he turned around and greeted me, his words were like a key, freeing me from the suffering in my heart. And then, I responded aloud, the halo completely connected, and I received my revelation.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C6.title: "Obtain Halo"
	quest.C3000000000001CD.title: "Hand Of Rending"
	quest.C3000000000001CD.quest_subtitle: "Special Rules"
	quest.C3000000000001CD.quest_desc: ["Original effect: Reaper, Soloblade, and Fighter Operators ignore 70% of the target's DEF; If you have Bend Spears - Rending, they also recover 2.5% of Max HP per second", "Description: Mountains shatter, stones devoured.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001CD.title: "Obtain Hand Of Rending"
	quest.C3000000000001E4.title: "Personal Paintbrush"
	quest.C3000000000001E4.quest_subtitle: "Special Rules"
	quest.C3000000000001E4.quest_desc: ["Original effect: Plans have -1 Toil", "Description: A haunted brush that compels its owners to paint with their own blood. The masterpiece mesmerizes beholders into adding another stroke the same way. Eventually, the elder revenant found the brush, along with many paintings, and sealed the rogue revenant in his bones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E4.title: "Obtain Personal Paintbrush"
	quest.C3000000000001E6.title: "Word Carving Knife"
	quest.C3000000000001E6.quest_subtitle: "Special Rules"
	quest.C3000000000001E6.quest_desc: ["Original effect: <Spines of Epoch> and <Spikes of Weeping> have -50% DEF", "Description: Once the standard tool of Sarkaz stonemasons. It is said carving prayers on weeping spikes can calm the revenants' resentment. The knife is still sharp, but no one remembers the prayers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E6.title: "Obtain Word Carving Knife"
	quest.C3000000000001ED.title: "Blood Tax Mystery"
	quest.C3000000000001ED.quest_subtitle: "Special Rules"
	quest.C3000000000001ED.quest_desc: ["Original effect: All allied and enemy units have -35% Max HP; only active in Bizarre Fragments", "Description: 'Duq'arael ultimately failed. He stepped forward bravely, but did not manage to stop his brother Danso. The deep red chains then tethered all life on this land, so we now leave a trail of blood with every step we take. This blood tax is to repay the baseless debt we owe.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001ED.title: "Obtain Blood Tax Mystery"
	quest.C3000000000001F1.title: "Foresight Mystery"
	quest.C3000000000001F1.quest_subtitle: "Special Rules"
	quest.C3000000000001F1.quest_desc: ["Original effect: Gain +20% Command EXP from battles, extra enemies will appear in battle; only active in Bizarre Fragments", "Description: 'Lone eye, self-gouged; exile, a favor from the Liches. Mur'rannag endured this to prevent a future seen in visions. Since then, newborn Cyclopes started having two eyes like regular Sarkaz, but the prophecy was documented and would still come true.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F1.title: "Obtain Foresight Mystery"
	quest.C3000000000001F3.title: "Tranquil Mystery"
	quest.C3000000000001F3.quest_subtitle: "Special Rules"
	quest.C3000000000001F3.quest_desc: ["Original effect: All allied and enemy units have -25% ATK, only effective in Bizarre Fragments", "Description: 'From the peak of Mount Anius to the heart of Lake Hyperion sit numerous monasteries of 'those without roots'. They work when their bells ring and rest otherwise. These bells seem to originate from the source of all things, and their rings resonate through eternity, beckoning all those seeking westward to turn back and ordering those sweeping eastward to lay down their arms. And thus, the nations of Victoria and Kazdel have enjoyed peace that lasts to this day.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F3.title: "Obtain Tranquil Mystery"
	quest.C3000000000001F7.title: "Ten Rings"
	quest.C3000000000001F7.quest_subtitle: "Special Rules"
	quest.C3000000000001F7.quest_desc: ["Original effect: Shadows of the Lord -50% Max HP", "Description: Amiya hoped to change the land with her own power rather than relying on the King of Sarkaz. She refused their kindness and journeyed through Terra's nations with unmatched resilience and resolution, saving lives and calling for peace until Oripathy claimed her life.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F7.title: "Obtain Ten Rings"
	quest.C3000000000001FB.title: "Prophetic Image"
	quest.C3000000000001FB.quest_subtitle: "Special Rules"
	quest.C3000000000001FB.quest_desc: ["Original effect: Finale Cadence will appear in battles", "Description: You must have heard this before: 'I see you, black crown on your head, melting millions of lives, into nothing but memories.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FB.title: "Obtain Prophetic Image"
	quest.C30000000000021A.title: "Expunger Of Hatred"
	quest.C30000000000021A.quest_subtitle: "Special Rules"
	quest.C30000000000021A.quest_desc: ["Original effect: +5 Mental Toil; if Deathmatch is used in a perfect clear, obtain a Deathmatch after the battle", "Description: This weapon was forged by those unwilling to be blinded by hatred. It reveals a path: When the fear born of violence overpowers all hatred, then maybe, there exists a glimpse of the first light of peace.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000021A.title: "Obtain Expunger Of Hatred"
	quest.C300000000000228.title: "Remnant Spring"
	quest.C300000000000228.quest_subtitle: "Special Rules"
	quest.C300000000000228.quest_desc: ["Original effect: Enemies inflict Cold for 6 seconds on surrounding enemies when defeated", "Description: What Xian came by and gifted a branch of spring?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000228.title: "Obtain Remnant Spring"
	quest.C300000000000238.title: "Charcoal Mask"
	quest.C300000000000238.quest_subtitle: "Special Rules"
	quest.C300000000000238.quest_desc: ["Original effect: Enemies blocked for the first time are inflicted with Fear for 5s", "Description: The mask of an ancient Yanese hero. Records tell of his courage and caution, and how his yells could split rivers into two.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000238.title: "Obtain Charcoal Mask"
	quest.C30000000000023F.title: "Ignited Beastkite"
	quest.C30000000000023F.quest_subtitle: "Special Rules"
	quest.C30000000000023F.quest_desc: ["Original effect: Obtain 1 Candle when entering Sui's Remnant Consciousness", "Description: A kite based off a Feranmut. Candles set the ribbons alight, and it always burns, but the kite stays intact. Fly it on a regular day, and borrow its light to gain an extra step when you step into the Sui's consciousness.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000023F.title: "Obtain Ignited Beastkite"
	quest.C300000000000240.title: "Interdependent Luck"
	quest.C300000000000240.quest_subtitle: "Special Rules"
	quest.C300000000000240.quest_desc: ["Original effect: Obtain 1 Coupon when a Risk Coin is added to Coin Coffer", "Description: If you encounter a half-completed poem inside the Garden of Grotesqueries, press this peach wood ornament over it. Minor disasters may be inevitable, but misfortune and fortune are interdependent. Never respond or complete a poem, EVER.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000240.title: "Obtain Interdependent Luck"
	quest.C30000000000024C.title: "Remnant Flames And Dreams"
	quest.C30000000000024C.quest_subtitle: "Special Rules"
	quest.C30000000000024C.quest_desc: ["Original effect: Gain +15% Command EXP from battles for every Risk coin currently tossed", "Description: Thunder bellows a sudden storm as war drums into the sky. Golden infantry rush forth from your dreams.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000024C.title: "Obtain Remnant Flames And Dreams"
	quest.C300000000000288.title: "Waking Tower"
	quest.C300000000000288.quest_subtitle: "Special Rules"
	quest.C300000000000288.quest_desc: ["Original effect: Awakens an Hour of Sui", "Description: The Hour of Sui is inexorable, but Liu'er came up with this tower that changes the Hour of Sui, with the help of the Sui proxies.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000288.title: "Obtain Waking Tower"
	quest.C30000000000028A.title: "Little Ba Jie Sticker"
	quest.C30000000000028A.quest_subtitle: "Special Rules"
	quest.C30000000000028A.quest_desc: ["Original effect: Chance to toss extra Tongbao", "Description: Sticker of the Garden of Grotesqueries mascot, often sold in a set with Tongbao. Sometimes throws out its friends that want to leave the Coin Coffer.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000028A.title: "Obtain Little Ba Jie Sticker"
	quest.C30000000000028C.title: "Swaddled Pegasus"
	quest.C30000000000028C.quest_subtitle: "Special Rules"
	quest.C30000000000028C.quest_desc: ["Original effect: 每次进入新区域时，初始行动力+1", "Description: 愿新生的它不再折翼。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000028C.title: "Obtain Swaddled Pegasus"
	quest.C30000000000028F.title: "Swaddled Hydra"
	quest.C30000000000028F.quest_subtitle: "Special Rules"
	quest.C30000000000028F.quest_desc: ["Original effect: 所有敌人的攻击和生命+30%，每进入新区域时我方攻击力和生命+10%", "Description: 愿新生的它不再痛苦。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000028F.title: "Obtain Swaddled Hydra"
	quest.C3000000000002A7.title: "Valley Prayer"
	quest.C3000000000002A7.quest_subtitle: "Special Rules"
	quest.C3000000000002A7.quest_desc: ["Original effect: 我方凋亡、灼燃、神经和侵蚀损伤的爆发效果增强", "Description: 尘土阖上她的眼睛，溪流为她拭去泪水。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002A7.title: "Obtain Valley Prayer"
	quest.C3000000000002CC.title: "Light Pack"
	quest.C3000000000002CC.quest_subtitle: "Special Rules"
	quest.C3000000000002CC.quest_desc: ["Original effect: 零件箱容量+4", "Description: “如果我们站着不动也能填饱肚子就好了。”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002CC.title: "Obtain Light Pack"
	quest.C3000000000002D0.title: "Wheel Regained"
	quest.C3000000000002D0.quest_subtitle: "Special Rules"
	quest.C3000000000002D0.quest_desc: ["Original effect: 加工品使用次数耗尽时，获得一个随机加工品", "Description: 我们将要去截获，一段飞奔而逃的树桩。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D0.title: "Obtain Wheel Regained"
	quest.C3000000000002D1.title: "Sustenance"
	quest.C3000000000002D1.quest_subtitle: "Special Rules"
	quest.C3000000000002D1.quest_desc: ["Original effect: 加工品的最后一次移动不再消耗行动力", "Description: 果实如锤砸在我身，每一块淤青都是你贪婪的形状。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D1.title: "Obtain Sustenance"
	quest.C3000000000002D2.title: "Bone In The Bag"
	quest.C3000000000002D2.quest_subtitle: "Special Rules"
	quest.C3000000000002D2.quest_desc: ["Original effect: 立刻获得3个随机的普通加工品", "Description: 它的生命如此短暂，到死都没有离开孕育它的温床。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D2.title: "Obtain Bone In The Bag"
	quest.C3000000000002D3.title: "Little Hand In The Woods"
	quest.C3000000000002D3.quest_subtitle: "Special Rules"
	quest.C3000000000002D3.quest_desc: ["Original effect: 立刻获得3个随机的普通自然物", "Description: 象征吉兆的植物，迷信的玻利瓦尔人相信，遇到林中小手后会立刻获得财富。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D3.title: "Obtain Little Hand In The Woods"
	quest.C3000000000002D4.title: "Blood Child"
	quest.C3000000000002D4.quest_subtitle: "Special Rules"
	quest.C3000000000002D4.quest_desc: ["Original effect: 获得自然物，直到零件箱被填满", "Description: “我有很多很多的孩子，但孙辈却越来越少。”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D4.title: "Obtain Blood Child"
	quest.C3000000000002DC.title: "Plant Pulp"
	quest.C3000000000002DC.quest_subtitle: "Special Rules"
	quest.C3000000000002DC.quest_desc: ["Original effect: 完成1场【追猎】作战后，获得【犬植浆】", "Description: 以黑流树海中的树木汁液为基底制作的简易药水，可以掩盖自身的气味。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002DC.title: "Obtain Plant Pulp"
}
