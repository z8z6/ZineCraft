{
	chapter.5A494E4543524146.title: "Zinecraft: Terra Expedition"
	quest.1000000000000001.title: "Expedition Handbook"
	quest.1000000000000001.quest_subtitle: "Dimensions, national biomes, and weapons"
	quest.1000000000000001.quest_desc: ["New players spawn directly in Terra. This chapter guides you through its nineteen national biomes, to the sole Sami stargate and onward to the Overworld, followed by Zinecraft sword, firearm, and staff training.\n\nCheck the task below to begin."]
	quest.1000000000000002.title: "Travel to the Sami Stargate"
	quest.1000000000000002.quest_desc: ["Travel to zinecraft:sami_frozen_forest. Terra's sole stargate is fixed in Sami near X=-23008, Z=-40000; JourneyMap displays Sami's national border and name."]
	quest.1000000000000003.title: "Activate and Reach the Overworld"
	quest.1000000000000003.quest_desc: ["Craft Protocol Originium from Originite, a Crystalline Circuit, and an Integrated Device. Hold it and right-click the Stargate Protocol Controller. The cyan event horizon forms only after authorization; the reusable key is not consumed. Enter it for one-way travel to the minecraft:overworld spawn area."]

	quest.2000000000000001.title: "Aegir Abyssal Sea"
	quest.2000000000000001.quest_desc: ["Abyssal-slate seabeds and pressure-tile enclaves inhabited by dolphins, with Aegir-themed settlements and landmarks."]
	quest.2000000000000002.title: "Bolivar Plain"
	quest.2000000000000002.quest_desc: ["War-scoured soil plains with parrots, Dossoles-stucco districts, and regional landmarks."]
	quest.2000000000000003.title: "Higashi Shadow Rift"
	quest.2000000000000003.quest_desc: ["A dim shadow-loam mountain forest inhabited by foxes, with plastered machiya towns and a rift shrine."]
	quest.2000000000000004.title: "Durin Underground Garden"
	quest.2000000000000004.quest_desc: ["Garden moss and glow squid illuminate an underground garden where colorful Ideal City panels hide among the caves."]
	quest.2000000000000005.title: "Columbia Sandstone Wilds"
	quest.2000000000000005.quest_desc: ["Canyon soil, armadillos, panel-built frontier towns, and research facilities define the Columbian frontier."]
	quest.2000000000000006.title: "Kazimierz Knightland"
	quest.2000000000000006.quest_desc: ["Dry steppe turf supports horses and knightly boroughs crowned by arena masonry."]
	quest.2000000000000007.title: "Kazdel Scarred Wastes"
	quest.2000000000000007.quest_desc: ["Scarred ash wastes hold cave spiders, armored Sarkaz settlements, and Babel-themed ruins."]
	quest.2000000000000008.title: "Laterano Holy Fields"
	quest.2000000000000008.quest_desc: ["Bright alluvial-chalk fields surround bees, marble monastery towns, and Laterano citizens who carry firearms by default."]
	quest.2000000000000009.title: "Leithanien Twilight Forest"
	quest.2000000000000009.quest_desc: ["Twilight humus forests hold wolves, resonant-brick musical towns, and twin-tower landmarks."]
	quest.200000000000000A.title: "Rim Billiton Mining Badlands"
	quest.200000000000000A.quest_desc: ["Mine-tailings fields contain husks, corrugated-steel camps, rail facilities, and industrial drilling landmarks."]
	quest.200000000000000B.title: "Minos Sunlit Hills"
	quest.200000000000000B.quest_desc: ["Sunbaked-earth hills host goats, heroic-masonry city-states, and monuments inspired by the Twelve Heroes."]
	quest.200000000000000C.title: "Sargon Rocky Desert"
	quest.200000000000000C.quest_desc: ["Camels, adobe oasis towns, and caravan routes cross the desert crust, concealing Golden City-inspired landmarks."]
	quest.200000000000000D.title: "Sami Frozen Forest"
	quest.200000000000000D.quest_desc: ["Polar bears and ritual-stone snow-priest villages inhabit frost-moss taiga around mysterious ancient altars."]
	quest.200000000000000E.title: "Victoria Misty Highlands"
	quest.200000000000000E.quest_desc: ["Moorland-soil highlands remain shrouded in mist around sheep, industrial-brick boroughs, steam works, and defenses."]
	quest.200000000000000F.title: "Ursus Frozen Steppe"
	quest.200000000000000F.quest_desc: ["Permafrost covers the northern plateau, where strays roam among imperial-masonry towns, mines, and Sarcophagus facilities."]
	quest.2000000000000010.title: "Kjerag Snowy Peaks"
	quest.2000000000000010.quest_desc: ["Rabbits inhabit sacred-snowstone ridges dotted with monastery-stone villages, trade routes, and Karlan architecture."]
	quest.2000000000000011.title: "Siracusa Rainy Woodland"
	quest.2000000000000011.quest_desc: ["Rain-darkened woods contain spiders, family-masonry towns, theatres, and courts reflecting local order."]
	quest.2000000000000012.title: "Yan Mountain Grove"
	quest.2000000000000012.quest_desc: ["Pandas roam mountain soil around blue-brick Shangshu towns, pavilions, tea houses, and Yumen beacons."]
	quest.2000000000000013.title: "Iberia Salt Delta"
	quest.2000000000000013.quest_desc: ["Salt winds scour salt-crusted gravel while drowned haunt coastal-masonry towns watched over by lighthouses."]
	quest.2000000000000020.title: "Terra Geographer"
	quest.2000000000000020.quest_desc: ["You have visited all nineteen national biomes. Confirm the completed survey and claim your expedition experience."]

	quest.3000000000000001.title: "Training Loadout"
	quest.3000000000000001.quest_subtitle: "Claim a test sword, rifle, ammunition, and staff"
	quest.3000000000000001.quest_desc: ["Zinecraft's server-side action system controls weapon hits, damage, ammunition, and skill effects. Claim the training equipment, then complete the three basic drills."]
	quest.3000000000000002.title: "Sword Drill"
	quest.3000000000000002.quest_desc: ["Hold the Test Sword in your main hand and left-click to perform a light attack with wind-up and active frames. Practise on a safe target, then confirm completion."]
	quest.3000000000000003.title: "Firearm Drill"
	quest.3000000000000003.quest_desc: ["The Test Rifle holds 12 rounds. Left-click to fire, right-click to toggle aiming, and press R to reload from Test Cartridges in your inventory. Fire and reload once, then confirm completion."]
	quest.3000000000000004.title: "Staff Drill"
	quest.3000000000000004.quest_desc: ["Left-click the Test Staff to cast Arcane Bolt and right-click to cast Mending Light. Both effects execute server-side on the action's active frame. Practise both, then confirm completion."]
	quest.3000000000000005.title: "TaCZ Firearm Adapter"
	quest.3000000000000005.quest_subtitle: "Optional: requires external TaCZ gun-pack resources"
	quest.3000000000000005.quest_desc: ["Zinecraft loads compatible TaCZ gun packs and maps every gun to a component-backed zinecraft:tacz_gun. Left-click fires, right-click aims, R reloads, B selects fire mode, X inspects, and V performs firearm melee.\n\nThis quest is optional and does not block progression when no gun-pack resources are installed."]
	quest.3000000000000006.title: "Basic Weapons Certification"
	quest.3000000000000006.quest_desc: ["Sword, firearm, and staff training are complete. Confirm your certification and claim the experience reward; the TaCZ adapter remains an independent optional challenge."]

	task.1100000000000001.title: "Begin the Terra expedition"
	task.2100000000000020.title: "Submit the complete survey"
	task.3100000000000001.title: "Claim the training equipment"
	task.3100000000000003.title: "I completed the light-attack drill"
	task.3100000000000005.title: "I fired and reloaded the rifle"
	task.3100000000000007.title: "I practised both staff spells"
	task.3100000000000009.title: "I tested the TaCZ firearm actions"
	task.310000000000000A.title: "Submit basic weapons certification"

	chapter.54455252414E4554.title: "Terra Nation Relations"
	quest.4000000000000000.title: "Network Legend"
	quest.4000000000000000.quest_subtitle: "Select a national emblem to inspect diplomacy and state power"
	quest.4000000000000000.quest_desc: ["Each node represents a nation. A line marks a significant bilateral relation backed by explicit PRTS evidence in TerraNationRelations. No line means the neutral default is in use or that the current sources are not explicit enough.\n\nState values: prosperity / stability / military / openness / aggression. Relation values: favor / war desire / trade / tension / trust. Most values use 0–100; favor and trust use -100–100.\n\nImportant: line colors only show FTB quest progress, not diplomatic sentiment. State and relation scores are gameplay-oriented initial estimates; the factual basis comes from PRTS.\n\nCheck the task to mark the legend as read."]
	task.4100000000000000.title: "I understand the network legend"

	quest.4000000000000001.title: "Aegir"
	quest.4000000000000001.quest_subtitle: "Prosperity 72 / Stability 50 / Military 80 / Openness 10 / Aggression 15"
	quest.4000000000000001.quest_desc: ["State: technologically advanced beneath the sea, but closed to land nations.\n\nKey relation:\n• Iberia: -25 / 10 / 18 / 52 / -45 (technology transfer; estrangement after the Profound Silence)"]
	quest.4000000000000002.title: "Bolivar"
	quest.4000000000000002.quest_subtitle: "Prosperity 35 / Stability 20 / Military 45 / Openness 55 / Aggression 55"
	quest.4000000000000002.quest_desc: ["State: prolonged division and proxy conflict severely suppress stability and prosperity.\n\nKey relations:\n• Columbia: -55 / 72 / 25 / 85 / -65 (active and proxy conflict)\n• Leithanien: 25 / 22 / 55 / 55 / 15 (investment and proxy conflict)"]
	quest.4000000000000003.title: "Higashi"
	quest.4000000000000003.quest_subtitle: "Prosperity 62 / Stability 40 / Military 60 / Openness 45 / Aggression 40"
	quest.4000000000000003.quest_desc: ["State: internally complex and historically pressured by the northern power.\n\nKey relation:\n• Ursus: -60 / 68 / 12 / 82 / -70 (historic war and border tension)"]
	quest.4000000000000004.title: "Durin"
	quest.4000000000000004.quest_subtitle: "Prosperity 82 / Stability 80 / Military 35 / Openness 55 / Aggression 15"
	quest.4000000000000004.quest_desc: ["State: wealthy and stable underground cities with little appetite for military expansion.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000005.title: "Columbia"
	quest.4000000000000005.quest_subtitle: "Prosperity 88 / Stability 72 / Military 85 / Openness 90 / Aggression 65"
	quest.4000000000000005.quest_desc: ["State: powerful economy, technology, and military, combining openness with clear expansionism.\n\nKey relations:\n• Bolivar: -55 / 72 / 25 / 85 / -65 (proxy conflict)\n• Leithanien: -40 / 52 / 35 / 72 / -45 (proxy rivalry)\n• Kjerag: 32 / 8 / 72 / 20 / 25 (investment and trade)\n• Victoria: -28 / 28 / 62 / 58 / -30 (trade and border tension)"]
	quest.4000000000000006.title: "Kazimierz"
	quest.4000000000000006.quest_subtitle: "Prosperity 78 / Stability 65 / Military 72 / Openness 75 / Aggression 45"
	quest.4000000000000006.quest_desc: ["State: commercially prosperous and militarily capable, under lasting northern border pressure.\n\nKey relation:\n• Ursus: -65 / 78 / 12 / 85 / -72 (historic war and border tension)"]
	quest.4000000000000007.title: "Kazdel"
	quest.4000000000000007.quest_subtitle: "Prosperity 30 / Stability 30 / Military 88 / Openness 35 / Aggression 70"
	quest.4000000000000007.quest_desc: ["State: low prosperity and stability, but very high military capability and conflict pressure.\n\nKey relations:\n• Victoria: -65 / 48 / 8 / 72 / -78 (historic war and occupation)\n• Laterano → Kazdel: -72 / 18 / 2 / 75 / -80 (diplomatic exclusion; one-way policy)"]
	quest.4000000000000008.title: "Laterano"
	quest.4000000000000008.quest_subtitle: "Prosperity 85 / Stability 88 / Military 78 / Openness 82 / Aggression 12"
	quest.4000000000000008.quest_desc: ["State: highly prosperous and stable, frequently acting as an international witness and mediator.\n\nKey relations:\n• Iberia: 20 / 4 / 42 / 22 / 18 (religious ties and mediation)\n• Kazdel: -72 / 18 / 2 / 75 / -80 (diplomatic exclusion; Laterano's one-way policy)"]
	quest.4000000000000009.title: "Leithanien"
	quest.4000000000000009.quest_subtitle: "Prosperity 80 / Stability 70 / Military 82 / Openness 65 / Aggression 35"
	quest.4000000000000009.quest_desc: ["State: strong across all major measures and influential through investment and proxies.\n\nKey relations:\n• Bolivar: 25 / 22 / 55 / 55 / 15 (investment and proxy conflict)\n• Columbia: -40 / 52 / 35 / 72 / -45 (proxy rivalry)\n• Kjerag: 28 / 6 / 65 / 16 / 24 (investment and trade)"]
	quest.400000000000000A.title: "Rim Billiton"
	quest.400000000000000A.quest_subtitle: "Prosperity 72 / Stability 75 / Military 45 / Openness 85 / Aggression 20"
	quest.400000000000000A.quest_desc: ["State: an open, active mining economy with low military expansionism.\n\nKey relation:\n• Kjerag: 42 / 4 / 80 / 12 / 38 (investment and trade)"]
	quest.400000000000000B.title: "Minos"
	quest.400000000000000B.quest_subtitle: "Prosperity 60 / Stability 68 / Military 62 / Openness 55 / Aggression 30"
	quest.400000000000000B.quest_desc: ["State: broadly moderate and stable, with mid-range national power.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.400000000000000C.title: "Sargon"
	quest.400000000000000C.quest_subtitle: "Prosperity 65 / Stability 60 / Military 70 / Openness 70 / Aggression 40"
	quest.400000000000000C.quest_desc: ["State: vast and trade-oriented, with upper-middle military power and conflict pressure.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.400000000000000D.title: "Sami"
	quest.400000000000000D.quest_subtitle: "Prosperity 38 / Stability 70 / Military 75 / Openness 25 / Aggression 15"
	quest.400000000000000D.quest_desc: ["State: closed to outsiders but capable in defence, with little appetite for offensive war.\n\nKey relation:\n• Ursus: -58 / 72 / 8 / 80 / -68 (historic war and border tension)"]
	quest.400000000000000E.title: "Victoria"
	quest.400000000000000E.quest_subtitle: "Prosperity 76 / Stability 40 / Military 90 / Openness 72 / Aggression 55"
	quest.400000000000000E.quest_desc: ["State: militarily powerful and economically open, but internally unstable.\n\nKey relations:\n• Kazdel: -65 / 48 / 8 / 72 / -78 (historic war and occupation)\n• Kjerag: 38 / 6 / 62 / 16 / 32 (investment and trade)\n• Columbia: -28 / 28 / 62 / 58 / -30 (trade and border tension)"]
	quest.400000000000000F.title: "Ursus"
	quest.400000000000000F.quest_subtitle: "Prosperity 55 / Stability 38 / Military 92 / Openness 30 / Aggression 85"
	quest.400000000000000F.quest_desc: ["State: exceptionally high military power and aggression, with low openness and internal stability.\n\nKey relations:\n• Kazimierz: -65 / 78 / 12 / 85 / -72\n• Sami: -58 / 72 / 8 / 80 / -68\n• Higashi: -60 / 68 / 12 / 82 / -70\nAll three are marked by historic war and border tension."]
	quest.4000000000000010.title: "Kjerag"
	quest.4000000000000010.quest_subtitle: "Prosperity 58 / Stability 72 / Military 48 / Openness 52 / Aggression 20"
	quest.4000000000000010.quest_desc: ["State: stable and reluctant to wage war, gradually opening through reform.\n\nKey relations:\n• Victoria: 38 / 6 / 62 / 16 / 32\n• Columbia: 32 / 8 / 72 / 20 / 25\n• Leithanien: 28 / 6 / 65 / 16 / 24\n• Rim Billiton: 42 / 4 / 80 / 12 / 38\nAll four primarily involve investment and trade."]
	quest.4000000000000011.title: "Siracusa"
	quest.4000000000000011.quest_subtitle: "Prosperity 70 / Stability 55 / Military 65 / Openness 72 / Aggression 45"
	quest.4000000000000011.quest_desc: ["State: open and commercially active, with family rule producing both order and conflict.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000012.title: "Yan"
	quest.4000000000000012.quest_subtitle: "Prosperity 88 / Stability 88 / Military 90 / Openness 60 / Aggression 20"
	quest.4000000000000012.quest_desc: ["State: highly prosperous, stable, and militarily powerful, with low offensive aggression.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000013.title: "Iberia"
	quest.4000000000000013.quest_subtitle: "Prosperity 32 / Stability 52 / Military 65 / Openness 15 / Aggression 25"
	quest.4000000000000013.quest_desc: ["State: prosperity and openness fell sharply after the Profound Silence, while some military strength remains.\n\nKey relations:\n• Aegir: -48 / 24 / 12 / 68 / -62 (technology transfer and diplomatic exclusion)\n• Laterano: 20 / 4 / 42 / 22 / 18 (religious ties and mediation)"]

	chapter_group.4E4154494F4E5347.title: "Terra Nation Archive"
	chapter.4E4154494F4E5343.title: "Nineteen Nations and Landmarks"
	quest.5000000000000000.title: "Reading Guide"
	quest.5000000000000000.quest_subtitle: "PRTS source material and Zinecraft gameplay implementations are kept distinct"
	quest.5000000000000000.quest_desc: ["This chapter follows the nineteen nations currently listed by the PRTS Terra Compendium. Each node identifies its source entry, then lists the biome, repeatable settlement, and two world-unique landmarks implemented by Zinecraft.\n\nThese buildings and landscapes are Minecraft gameplay adaptations, not official Arknights scene reproductions."]
	task.5100000000000000.title: "I understand the source and adaptation boundary"
	quest.5000000000000001.title: "Aegir"
	quest.5000000000000001.quest_subtitle: "Nation source and pressure-resistant architecture"
	quest.5000000000000001.quest_desc: ["PRTS entry: Terra Compendium geography/Aegir.\n\nZinecraft: aegir_abyssal_sea; aegir_subsea_enclave; aegir_volcanic_beacon and aegir_abyssal_observatory."]
	quest.5000000000000002.title: "Bolivar"
	quest.5000000000000002.quest_subtitle: "Northwestern plains, Dossoles, and prolonged conflict"
	quest.5000000000000002.quest_desc: ["PRTS records Bolivar as a northwestern Terra nation bordering Columbia, with conflict arising from overlapping Originium mining areas in the Crystalline Era.\n\nZinecraft: bolivar_plain; bolivar_dossoles_district; bolivar_dossoles_yacht and bolivar_race_checkpoint."]
	quest.5000000000000003.title: "Higashi"
	quest.5000000000000003.quest_subtitle: "Nation source and rift-town architecture"
	quest.5000000000000003.quest_desc: ["PRTS entry: Terra Compendium geography/Higashi.\n\nZinecraft: higashi_shadow_rift; higashi_sokogawa_town; higashi_rift_shrine and higashi_sokogawa_watchtower."]
	quest.5000000000000004.title: "Durin"
	quest.5000000000000004.quest_subtitle: "Underground nation source and Ideal City architecture"
	quest.5000000000000004.quest_desc: ["PRTS entry: Terra Compendium geography/Durin.\n\nZinecraft: durin_underground_garden; durin_ideal_city_block; durin_dome_station and durin_water_park."]
	quest.5000000000000005.title: "Columbia"
	quest.5000000000000005.quest_subtitle: "Nation source and frontier architecture"
	quest.5000000000000005.quest_desc: ["PRTS entry: Terra Compendium geography/Columbia.\n\nZinecraft: columbia_sandstone_wilds; columbia_frontier_town; columbia_frontier_lab and columbia_prison_outpost."]
	quest.5000000000000006.title: "Kazimierz"
	quest.5000000000000006.quest_subtitle: "Knight nation source and arena architecture"
	quest.5000000000000006.quest_desc: ["PRTS entry: Terra Compendium geography/Kazimierz.\n\nZinecraft: kazimierz_knightland; kazimierz_knight_borough; kazimierz_arena_gate and kazimierz_knight_monument."]
	quest.5000000000000007.title: "Kazdel"
	quest.5000000000000007.quest_subtitle: "Sarkaz nation source and scarred architecture"
	quest.5000000000000007.quest_desc: ["PRTS entry: Terra Compendium geography/Kazdel.\n\nZinecraft: kazdel_scarred_wastes; kazdel_sarkaz_settlement; kazdel_babel_ruins and kazdel_sarkaz_camp."]
	quest.5000000000000008.title: "Laterano"
	quest.5000000000000008.quest_subtitle: "Nation source and holy-city architecture"
	quest.5000000000000008.quest_desc: ["PRTS entry: Laterano.\n\nZinecraft: laterano_holy_fields; laterano_monastery_town; laterano_revelation_tower and laterano_ambrosius_chapel, plus the underground Laterano Host."]
	quest.5000000000000009.title: "Leithanien"
	quest.5000000000000009.quest_subtitle: "Nation source and musical architecture"
	quest.5000000000000009.quest_desc: ["PRTS entry: Terra Compendium geography/Leithanien.\n\nZinecraft: leithanien_twilight_forest; leithanien_music_town; leithanien_twin_spires and leithanien_concert_hall."]
	quest.500000000000000A.title: "Rim Billiton"
	quest.500000000000000A.quest_subtitle: "Mining nation source and industrial architecture"
	quest.500000000000000A.quest_desc: ["PRTS entry: Terra Compendium geography/Rim Billiton.\n\nZinecraft: rim_billiton_mining_badlands; rim_billiton_mining_camp; rim_billiton_mining_derrick and rim_billiton_rail_depot."]
	quest.500000000000000B.title: "Minos"
	quest.500000000000000B.quest_subtitle: "Nation source and heroic architecture"
	quest.500000000000000B.quest_desc: ["PRTS entry: Terra Compendium geography/Minos.\n\nZinecraft: minos_sunlit_hills; minos_heroic_polis; minos_heroes_temple and minos_heroes_plaza."]
	quest.500000000000000C.title: "Sargon"
	quest.500000000000000C.quest_subtitle: "Nation source and oasis architecture"
	quest.500000000000000C.quest_desc: ["PRTS entry: Terra Compendium geography/Sargon.\n\nZinecraft: sargon_rocky_desert; sargon_oasis_town; sargon_golden_bazaar and sargon_long_spring_well."]
	quest.500000000000000D.title: "Sami"
	quest.500000000000000D.quest_subtitle: "Nation source and snow-priest architecture"
	quest.500000000000000D.quest_desc: ["PRTS entry: Terra Compendium geography/Sami.\n\nZinecraft: sami_frozen_forest; sami_snowpriest_village; sami_cyclops_altar and sami_snowpriest_lodge."]
	quest.500000000000000E.title: "Victoria"
	quest.500000000000000E.quest_subtitle: "Nation source and industrial architecture"
	quest.500000000000000E.quest_desc: ["PRTS entry: Terra Compendium geography/Victoria.\n\nZinecraft: victoria_misty_highlands; victoria_industrial_borough; victoria_defence_cannon and victoria_steam_station."]
	quest.500000000000000F.title: "Ursus"
	quest.500000000000000F.quest_subtitle: "Nation source and northern architecture"
	quest.500000000000000F.quest_desc: ["PRTS entry: Terra Compendium geography/Ursus.\n\nZinecraft: ursus_frozen_steppe; ursus_northern_town; ursus_sarcophagus_station and ursus_northern_mine_tower."]
	quest.5000000000000010.title: "Kjerag"
	quest.5000000000000010.quest_subtitle: "Snow-realm source and Karlan architecture"
	quest.5000000000000010.quest_desc: ["PRTS entry: Terra Compendium geography/Kjerag.\n\nZinecraft: kjerag_snowy_peaks; kjerag_mountain_village; kjerag_karlan_monastery and kjerag_sacred_plaza."]
	quest.5000000000000011.title: "Siracusa"
	quest.5000000000000011.quest_subtitle: "Nation source and family architecture"
	quest.5000000000000011.quest_desc: ["PRTS entry: Siracusa.\n\nZinecraft: siracusa_rainy_woodland; siracusa_family_town; siracusa_family_court and siracusa_family_theatre."]
	quest.5000000000000012.title: "Yan"
	quest.5000000000000012.quest_subtitle: "Nation source and Shangshu/Yumen architecture"
	quest.5000000000000012.quest_desc: ["PRTS entry: Terra Compendium geography/Yan.\n\nZinecraft: yan_mountain_grove; yan_shangshu_town; yan_yumen_beacon and yan_shangshu_pavilion."]
	quest.5000000000000013.title: "Iberia"
	quest.5000000000000013.quest_subtitle: "Nation source and coastal architecture"
	quest.5000000000000013.quest_desc: ["PRTS entry: Terra Compendium geography/Iberia.\n\nZinecraft: iberia_salt_delta; iberia_coastal_town; iberia_eye_lighthouse and iberia_saltwind_chapel."]

	chapter_group.444556454C4F5047.title: "Development and Mods"
	chapter.4445564D4F445343.title: "Development Mod Guide"
	quest.6000000000000000.title: "Zinecraft Development Environment"
	quest.6000000000000000.quest_subtitle: "Required, transitive, and development-only mods"
	quest.6000000000000000.quest_desc: ["This chapter lists the primary mods loaded by the current Gradle development runtime. Required dependencies provide gameplay and data; transitive dependencies arrive through those mods; development helpers are present in runClient but are not bundled into the Zinecraft JAR."]
	task.6100000000000000.title: "I understand the dependency categories"
	quest.6000000000000001.title: "Platform and World Generation"
	quest.6000000000000001.quest_desc: ["Minecraft 1.21.1; NeoForge 21.1.244; TerraBlender 4.1.0.8. NeoForge supplies the mod platform, while TerraBlender supports biome and world-generation integration."]
	quest.6000000000000002.title: "Create Ecosystem"
	quest.6000000000000002.quest_desc: ["Create 6.0.10, Ponder 1.0.82, Flywheel 1.0.6, and Registrate 1.3.0+67. Create supplies kinetic content; Ponder handles tutorial scenes; Flywheel and Registrate support rendering and registration."]
	quest.6000000000000003.title: "Quest System"
	quest.6000000000000003.quest_desc: ["FTB Quests 2101.1.27, with FTB Library and FTB Teams supplying UI, data, and team progression. Zinecraft installs bundled quest templates under config/ftbquests/quests."]
	quest.6000000000000004.title: "Accessories and Collectibles"
	quest.6000000000000004.quest_desc: ["Curios 9.5.1+1.21.1 supplies accessory capability. Zinecraft Integrated Strategies collectibles use the relic slot, currently configured with twenty player slots."]
	quest.6000000000000005.title: "Configuration and Libraries"
	quest.6000000000000005.quest_desc: ["Cloth Config 15.0.140 supplies configuration UI support. Architectury and Common Networking are loaded transitively. The project source and runtime now use Java throughout, without an additional language runtime."]
	quest.6000000000000006.title: "Development-only Helpers"
	quest.6000000000000006.quest_desc: ["JEI 19.27.0.340, Just Enough Resources 1.6.0.17, AppleSkin 3.0.9, Jade 15.10.5, Just Enough Characters 4.5.22, JourneyMap 6.0.1, Nature's Compass 3.4.0, and Explorer's Compass 3.4.0. They support item/resource lookup, food information, block inspection, Pinyin search, map-based testing, and biome/structure location."]


	chapter.534B494C4C534348.title: "Operator Skills"
	quest.D100000000000000.title: "Operator Skill Training"
	quest.D100000000000000.quest_subtitle: "Review skill data and Ponder demonstrations"
	quest.D100000000000000.quest_desc: ["This chapter contains the nine currently registered Operator skill items.", "Hover over a skill item and hold the Ponder key to view its mechanics demonstration.", "Demonstrations explain the Minecraft interpretation and do not directly apply server-side damage."]
	task.D200000000000000.title: "Read the skill training guide"
	quest.D300000000000001.title: "Myrtle: Support β"
	quest.D300000000000001.quest_subtitle: "Vanguard · Auto Recovery · Manual"
	quest.D300000000000001.quest_desc: ["Initial SP 13 · SP Cost 22 · Duration 8s", "Stops attacking and gradually recovers deployment points during the skill.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000001.title: "Obtain Support β"
	task.D500000000000001.title: "Confirm the demonstration was viewed"
	quest.D300000000000002.title: "SilverAsh: Truesilver Slash"
	quest.D300000000000002.quest_subtitle: "Guard · Auto Recovery · Manual"
	quest.D300000000000002.quest_desc: ["Initial SP 75 · SP Cost 90 · Duration 30s", "Reduces DEF, greatly increases ATK and range, and attacks up to six targets.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000002.title: "Obtain Truesilver Slash"
	task.D500000000000002.title: "Confirm the demonstration was viewed"
	quest.D300000000000003.title: "Exusiai: Overloading Mode"
	quest.D300000000000003.quest_subtitle: "Sniper · Auto Recovery · Auto Trigger"
	quest.D300000000000003.quest_desc: ["Initial SP 20 · SP Cost 30 · Duration 15s", "Activates automatically, changes attacks to five-shot bursts, and shortens the interval.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000003.title: "Obtain Overloading Mode"
	task.D500000000000003.title: "Confirm the demonstration was viewed"
	quest.D300000000000004.title: "Wiš'adel: Explosive Dawn"
	quest.D300000000000004.quest_subtitle: "Sniper · Auto Recovery · Manual Toggled"
	quest.D300000000000004.quest_desc: ["Initial SP 40 · SP Cost 50 · Ammo skill", "Immediately summons 2 Revenant's Shadows in attack range (up to 3 at a time; they remain after the skill expires). ATK +180%, Attack Interval is greatly increased, attacks deal 220% ATK, splash area is greatly increased, and Talent 1 trigger chance is increased to 100%. Skill activation grants 6 ammo and the skill ends when all ammo are used (can be manually deactivated).", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000004.title: "Obtain Explosive Dawn"
	task.D500000000000004.title: "Confirm the demonstration was viewed"
	quest.D300000000000005.title: "Eyjafjalla: Volcano"
	quest.D300000000000005.quest_subtitle: "Caster · Auto Recovery · Manual"
	quest.D300000000000005.quest_desc: ["Initial SP 55 · SP Cost 80 · Duration 15s", "Expands range and rapidly launches lava at up to six enemies in range.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000005.title: "Obtain Volcano"
	task.D500000000000005.title: "Confirm the demonstration was viewed"
	quest.D300000000000006.title: "Saria: Calcification"
	quest.D300000000000006.quest_subtitle: "Defender · Auto Recovery · Manual"
	quest.D300000000000006.quest_desc: ["Initial SP 70 · SP Cost 80 · Duration 30s", "Continuously heals nearby allies while slowing enemies and amplifying Arts damage.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000006.title: "Obtain Calcification"
	task.D500000000000006.title: "Confirm the demonstration was viewed"
	quest.D300000000000007.title: "Nightingale: Sanctuary"
	quest.D300000000000007.quest_subtitle: "Medic · Auto Recovery · Manual"
	quest.D300000000000007.quest_desc: ["Initial SP 115 · SP Cost 120 · Duration 60s", "Expands healing range and grants allies Arts resistance and Arts evasion.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000007.title: "Obtain Sanctuary"
	task.D500000000000007.title: "Confirm the demonstration was viewed"
	quest.D300000000000008.title: "Suzuran: Foxfire Haze"
	quest.D300000000000008.quest_subtitle: "Supporter · Auto Recovery · Manual"
	quest.D300000000000008.quest_desc: ["Initial SP 50 · SP Cost 70 · Duration 35s", "Stops attacking, expands range, slows enemies, and continuously restores allies.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000008.title: "Obtain Foxfire Haze"
	task.D500000000000008.title: "Confirm the demonstration was viewed"
	quest.D300000000000009.title: "Projekt Red: Wolfpack"
	quest.D300000000000009.quest_subtitle: "Specialist · Passive · On Deployment"
	quest.D300000000000009.quest_desc: ["Initial SP 0 · SP Cost 0 · No duration", "On deployment, damages all nearby ground enemies and stuns them for three seconds.", "Obtain the skill item, view its Ponder demonstration, then confirm manually."]
	task.D400000000000009.title: "Obtain Wolfpack"
	task.D500000000000009.title: "Confirm the demonstration was viewed"

	chapter.434F4C4C45435449.title: "Collectible Encyclopedia"
	quest.C100000000000001.title: "Offense"
	quest.C100000000000001.quest_subtitle: "Contains 67 collectibles."
	quest.C100000000000001.quest_desc: ["Primarily improves damage or attack speed, or reduces enemy defenses.", "Contains 67 collectibles."]
	task.C200000000000001.title: "Read category guide"
	quest.C300000000000031.title: "Worn Out Group Photo"
	quest.C300000000000031.quest_subtitle: "No.049 · Offense"
	quest.C300000000000031.quest_desc: ["Original effect: All enemy units have -12% DEF.", "Description: Do you know someone in the photo?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000031.title: "Obtain Worn Out Group Photo"
	quest.C300000000000032.title: "Writers Tongue"
	quest.C300000000000032.quest_subtitle: "No.050 · Offense"
	quest.C300000000000032.quest_desc: ["Original effect: All enemy units have -21% DEF.", "Description: The playwright penned his creations with a quill and his own blood, and for himself he devised an ending in which he perishes in a sea of flames.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000032.title: "Obtain Writers Tongue"
	quest.C300000000000033.title: "Rosmontiss Embrace"
	quest.C300000000000033.quest_subtitle: "No.051 · Offense"
	quest.C300000000000033.quest_desc: ["Original effect: All enemy units have -30% DEF.", "Description: 'Who will be the judge?'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000033.title: "Obtain Rosmontiss Embrace"
	quest.C30000000000003A.title: "Emperors Favor"
	quest.C30000000000003A.quest_subtitle: "No.058 · Offense"
	quest.C30000000000003A.quest_desc: ["Original effect: All friendly melee units have +15% ATK.", "Description: A very sharp letter opener. It was one of the favorite possessions of the last Ursus emperor, and as such it was very rarely used to actually open letters.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003A.title: "Obtain Emperors Favor"
	quest.C30000000000003B.title: "Royal Rapier"
	quest.C30000000000003B.quest_subtitle: "No.059 · Offense"
	quest.C30000000000003B.quest_desc: ["Original effect: All friendly melee units have +25% ATK.", "Description: A highly decorative rapier for nobles. Used by Gaulish nobles first and foremost, though perhaps a little fragile for a military weapon.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003B.title: "Obtain Royal Rapier"
	quest.C30000000000003C.title: "Vieux Vanguards Blade"
	quest.C30000000000003C.quest_subtitle: "No.060 · Offense"
	quest.C30000000000003C.quest_desc: ["Original effect: All friendly melee units have +35% ATK.", "Description: Prior to its downfall, Gaul first witnessed the sacrifices of its Vieux Vanguards.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003C.title: "Obtain Vieux Vanguards Blade"
	quest.C30000000000003D.title: "Necklace Of The Presence"
	quest.C30000000000003D.quest_subtitle: "No.061 · Offense"
	quest.C30000000000003D.quest_desc: ["Original effect: All friendly ranged units have +15% ATK.", "Description: Faith hangs ten centimeters above your heart, spoken words flow into your blood, and bullets slide into your magazine.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003D.title: "Obtain Necklace Of The Presence"
	quest.C30000000000003E.title: "Silver Forks"
	quest.C30000000000003E.quest_subtitle: "No.062 · Offense"
	quest.C30000000000003E.quest_desc: ["Original effect: All friendly ranged units have +25% ATK.", "Description: One for dealing with actors who botch their performances, one for dealing with incompetent playwrights, and one for anyone who needs it. The Chief will not tolerate any mistakes on the table.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003E.title: "Obtain Silver Forks"
	quest.C30000000000003F.title: "Damaged Revolver Cylinder"
	quest.C30000000000003F.quest_subtitle: "No.063 · Offense"
	quest.C30000000000003F.quest_desc: ["Original effect: All friendly ranged units have +35% ATK.", "Description: She never capitulated, even after enduring countless trials and tribulations. Her muzzle belched tongues of flame that burned like an angry sun, and the glow above her head was brighter than the daylight itself. Buried here is Outcast, our friend.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003F.title: "Obtain Damaged Revolver Cylinder"
	quest.C30000000000005E.title: "Blunt Claws Burst"
	quest.C30000000000005E.quest_subtitle: "No.094 · Offense"
	quest.C30000000000005E.quest_desc: ["Original effect: Vanguard Operators start with +15 SP.", "Description: He's already done all the reserve squad's work for them. What else do you expect?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000005E.title: "Obtain Blunt Claws Burst"
	quest.C30000000000005F.title: "Blunt Claws Proficiency"
	quest.C30000000000005F.quest_subtitle: "No.095 · Offense"
	quest.C30000000000005F.quest_desc: ["Original effect: The SP Cost of Vanguard Operators' skills is decreased by -35%.", "Description: As an operator who often enters the battlefield before anyone else, you cannot fathom what they have been through.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000005F.title: "Obtain Blunt Claws Proficiency"
	quest.C300000000000063.title: "Bend Spears Acuity"
	quest.C300000000000063.quest_subtitle: "No.099 · Offense"
	quest.C300000000000063.quest_desc: ["Original effect: Guard Operators have +25% ATK.", "Description: 'This is the 7th blade you've broken this month.' 'But I cut down eight enemies this month.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000063.title: "Obtain Bend Spears Acuity"
	quest.C300000000000064.title: "Bend Spears Bloodbath"
	quest.C300000000000064.quest_subtitle: "No.100 · Offense"
	quest.C300000000000064.quest_desc: ["Original effect: Guard Operators restore 2 SP after each attack.", "Description: Soldiers who get bolder as time passes are rare. Most need some form of psychological counseling to alleviate the trauma of war.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000064.title: "Obtain Bend Spears Bloodbath"
	quest.C300000000000066.title: "Bend Spears Deathmatch"
	quest.C300000000000066.quest_subtitle: "No.102 · Offense"
	quest.C300000000000066.quest_desc: ["Original effect: Guard Operators have -40% DEF, but gain +40% ATK and +30 ASPD.", "Description: I wouldn't really recommend learning those skills from Blaze.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000066.title: "Obtain Bend Spears Deathmatch"
	quest.C300000000000068.title: "Iron Guard Invasion"
	quest.C300000000000068.quest_subtitle: "No.104 · Offense"
	quest.C300000000000068.quest_desc: ["Original effect: Defender Operators have +60% ATK.", "Description: Defensive actions for the sake of teammates or strategic purposes often make people forget about their original aggressiveness.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000068.title: "Obtain Iron Guard Invasion"
	quest.C30000000000006A.title: "Iron Guard Advance"
	quest.C30000000000006A.quest_subtitle: "No.106 · Offense"
	quest.C30000000000006A.quest_desc: ["Original effect: Defender Operators have -1 Block (will not be reduced below 1), but gain +40% ATK and +40 ASPD.", "Description: In exchange for an opportunity to attack, the shattered ranks made one more advance.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006A.title: "Obtain Iron Guard Advance"
	quest.C30000000000006B.title: "Iron Guard Impenetrable"
	quest.C30000000000006B.quest_subtitle: "No.107 · Offense"
	quest.C30000000000006B.quest_desc: ["Original effect: Defender Operators restore 2 SP after being attacked.", "Description: Every blow they endure will turn into anger and be returned severalfold.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006B.title: "Obtain Iron Guard Impenetrable"
	quest.C30000000000006D.title: "Fatal Bolts Precision"
	quest.C30000000000006D.quest_subtitle: "No.109 · Offense"
	quest.C30000000000006D.quest_desc: ["Original effect: Sniper Operators have +20% ATK.", "Description: In an era when Originium Arts were not as robust as they are now, Yan had a saying, 'a pierced willow leaf from a hundred paces,' to praise others for their mastery of archery.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006D.title: "Obtain Fatal Bolts Precision"
	quest.C30000000000006E.title: "Fatal Bolts Synergy"
	quest.C30000000000006E.quest_subtitle: "No.110 · Offense"
	quest.C30000000000006E.quest_desc: ["Original effect: Increases the SP regen rate of Sniper Operators by +0.5/s", "Description: The more intimate a sniper is with her weapon, the less likely she is to be betrayed by it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006E.title: "Obtain Fatal Bolts Synergy"
	quest.C30000000000006F.title: "Fatal Bolts Crossfire"
	quest.C30000000000006F.quest_subtitle: "No.111 · Offense"
	quest.C30000000000006F.quest_desc: ["Original effect: Sniper Operators have -40% HP, but gain +40% ATK.", "Description: The dense crossfire also exposes snipers to great danger. The next battle boils down to a game of vision.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006F.title: "Obtain Fatal Bolts Crossfire"
	quest.C300000000000070.title: "Fatal Bolts Divine Speed"
	quest.C300000000000070.quest_subtitle: "No.112 · Offense"
	quest.C300000000000070.quest_desc: ["Original effect: Sniper Operators have +70 ASPD.", "Description: It is said that the legendary archer of ancient Victoria can almost shoot a continuous stream of arrows.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000070.title: "Obtain Fatal Bolts Divine Speed"
	quest.C300000000000072.title: "Broken Wand Arts Weaving"
	quest.C300000000000072.quest_subtitle: "No.114 · Offense"
	quest.C300000000000072.quest_desc: ["Original effect: Caster Operators have +25% ATK.", "Description: Those who gaze up at the great spires in Leithanien often see some strange or even celestial phenomena.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000072.title: "Obtain Broken Wand Arts Weaving"
	quest.C300000000000073.title: "Broken Wand Chanting"
	quest.C300000000000073.quest_subtitle: "No.115 · Offense"
	quest.C300000000000073.quest_desc: ["Original effect: Caster Operators have +40 ASPD.", "Description: Though the relationship between music and Arts is marvelous indeed, umm, this is not an excuse for some peoples' tone-deafness.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000073.title: "Obtain Broken Wand Chanting"
	quest.C300000000000074.title: "Broken Wand Concentration"
	quest.C300000000000074.quest_subtitle: "No.116 · Offense"
	quest.C300000000000074.quest_desc: ["Original effect: Increases the SP regen rate of Caster Operators by +0.4/s", "Description: 'When a caster intends to go all out, they will display a completely different temperament — even if we're talking about something like Miss Skyfire's grumpiness.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000074.title: "Obtain Broken Wand Concentration"
	quest.C300000000000075.title: "Broken Wand Malediction"
	quest.C300000000000075.quest_subtitle: "No.117 · Offense"
	quest.C300000000000075.quest_desc: ["Original effect: Caster Operators have -40% HP, but deal +70% Arts damage", "Description: It is virtually impossible to identify when the Sarkaz first encountered Originium, and the origins of these ancient Arts have long been separated from actual reality and common sense.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000075.title: "Obtain Broken Wand Malediction"
	quest.C300000000000077.title: "Stalwart Aid Secondary Front"
	quest.C300000000000077.quest_subtitle: "No.119 · Offense"
	quest.C300000000000077.quest_desc: ["Original effect: Units summoned by Supporter Operators have +50% ATK.", "Description: 'Um, I can understand the derivatives of combining mechanics with Originium Arts, but there might be something else...'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000077.title: "Obtain Stalwart Aid Secondary Front"
	quest.C300000000000078.title: "Stalwart Aid Diligence"
	quest.C300000000000078.quest_subtitle: "No.120 · Offense"
	quest.C300000000000078.quest_desc: ["Original effect: The SP Cost of Supporter Operators' skills is decreased by -40%.", "Description: Operators tend to give it their all, even to tasks that might seem trivial. The reality is, those tasks are not trivial at all.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000078.title: "Obtain Stalwart Aid Diligence"
	quest.C30000000000007C.title: "Healers Path Self Treating"
	quest.C30000000000007C.quest_subtitle: "No.124 · Offense"
	quest.C30000000000007C.quest_desc: ["Original effect: Increases the SP regen rate of Medic Operators by +0.3/s", "Description: Who says healers can't heal themselves? They simply pop some pills before continuing to help others.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007C.title: "Obtain Healers Path Self Treating"
	quest.C30000000000007D.title: "Healers Path Potency"
	quest.C30000000000007D.quest_subtitle: "No.125 · Offense"
	quest.C30000000000007D.quest_desc: ["Original effect: Medic Operators have +40% ATK.", "Description: Nobody else dared to attempt such a radical treatment — except Warfarin. She never made a single mistake.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007D.title: "Obtain Healers Path Potency"
	quest.C30000000000007E.title: "Healers Path Keen Hands"
	quest.C30000000000007E.quest_subtitle: "No.126 · Offense"
	quest.C30000000000007E.quest_desc: ["Original effect: Medic Operators have +50 ASPD.", "Description: Compared to the feat of snatching a life from the grip of death, what is three days of coma afterwards?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007E.title: "Obtain Healers Path Keen Hands"
	quest.C300000000000081.title: "Rusted Blade Execution"
	quest.C300000000000081.quest_subtitle: "No.129 · Offense"
	quest.C300000000000081.quest_desc: ["Original effect: Specialist Operators have +30 ASPD.", "Description: Projekt Red has a knife. She has a knife.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000081.title: "Obtain Rusted Blade Execution"
	quest.C300000000000085.title: "Hand Of Spikes"
	quest.C300000000000085.quest_subtitle: "No.133 · Offense"
	quest.C300000000000085.quest_desc: ["Original effect: Protector, Arts Protector, and Duelist Operators deal Arts damage equal to 100% of their own DEF on enemy units they block", "Description: Let the enemy make his move. He will be his own downfall.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000085.title: "Obtain Hand Of Spikes"
	quest.C300000000000087.title: "Hand Of Buckler"
	quest.C300000000000087.quest_subtitle: "No.135 · Offense"
	quest.C300000000000087.quest_desc: ["Original effect: Decel Binder, Hexer, and Abjurer Operators' attacks deal extra Arts damage equal to 3% of the target's HP", "Description: Drop by drop, bit by bit. It is unstoppable.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000087.title: "Obtain Hand Of Buckler"
	quest.C300000000000088.title: "Hand Of Diffusion"
	quest.C300000000000088.quest_subtitle: "No.136 · Offense"
	quest.C300000000000088.quest_desc: ["Original effect: Splash Caster, Chain Caster, and Blast Caster Operators recover 2 SP every time they attack an enemy unit", "Description: The more enemies you strike, the more power you take hold of.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000088.title: "Obtain Hand Of Diffusion"
	quest.C30000000000008A.title: "Hand Of Superspeed"
	quest.C30000000000008A.quest_subtitle: "No.138 · Offense"
	quest.C30000000000008A.quest_desc: ["Original effect: Executor, Ambusher, and Dollkeeper Operators gain +100 ASPD when there are no friendly units in the eight adjacent tiles", "Description: You swing your hand, leaving not even an afterimage.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000008A.title: "Obtain Hand Of Superspeed"
	quest.C300000000000095.title: "Ancient Gaulish Silver Coin"
	quest.C300000000000095.quest_subtitle: "No.149 · Offense"
	quest.C300000000000095.quest_desc: ["Original effect: All Operators start with +6 SP.", "Description: A coin once circulated in the now fallen nation 'Gaul.' It is in very good shape, making it highly valuable as a collector's item.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000095.title: "Obtain Ancient Gaulish Silver Coin"
	quest.C300000000000096.title: "Elysee Purse"
	quest.C300000000000096.quest_subtitle: "No.150 · Offense"
	quest.C300000000000096.quest_desc: ["Original effect: All Operators start with +8 SP.", "Description: A purse used by high-class ladies who shop on the Élysée. Mousse has a purse like this.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000096.title: "Obtain Elysee Purse"
	quest.C300000000000097.title: "Bank Of Gaul Check"
	quest.C300000000000097.quest_subtitle: "No.151 · Offense"
	quest.C300000000000097.quest_desc: ["Original effect: All Operators start with +12 SP.", "Description: An extravagant checkbook plated in gold and silver. Can no longer be cashed.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000097.title: "Obtain Bank Of Gaul Check"
	quest.C300000000000098.title: "Second Economic Reform Act"
	quest.C300000000000098.quest_subtitle: "No.152 · Offense"
	quest.C300000000000098.quest_desc: ["Original effect: All Operators start with +18 SP.", "Description: With this bill as the starting point, Gaul formally began its path to become a hegemonic empire.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000098.title: "Obtain Second Economic Reform Act"
	quest.C300000000000099.title: "Vanilla Soda"
	quest.C300000000000099.quest_subtitle: "No.153 · Offense"
	quest.C300000000000099.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.2/s", "Description: Bolívar's cheap specialty drink dates back hundreds of years. It is mixed with a variety of spices, and is known for not being very good.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
