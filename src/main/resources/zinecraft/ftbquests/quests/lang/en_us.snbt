	quest.C300000000000088.quest_subtitle: "Offense"
	quest.C300000000000088.quest_desc: ["Original effect: Splash Caster, Chain Caster, and Blast Caster Operators recover 2 SP every time they attack an enemy unit", "Description: The more enemies you strike, the more power you take hold of.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000088.title: "Obtain Hand Of Diffusion"
	quest.C30000000000008A.title: "Hand Of Superspeed"
	quest.C30000000000008A.quest_subtitle: "Offense"
	quest.C30000000000008A.quest_desc: ["Original effect: Executor, Ambusher, and Dollkeeper Operators gain +100 ASPD when there are no friendly units in the eight adjacent tiles", "Description: You swing your hand, leaving not even an afterimage.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
