	quest.C300000000000245.title: "Big Bob S Certificate"
	quest.C300000000000245.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000245.quest_desc: ["Original effect: For every 3 Ingots owned, +1 Starting DP", "Description: 'BIG BOB IS WATCHING YOU.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000245.title: "Obtain Big Bob S Certificate"
	quest.C300000000000246.title: "Round Woodwheel"
	quest.C300000000000246.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000246.quest_desc: ["Original effect: +5 Starting DP, with additional +10 for every Vanguard in Squad", "Description: Round boulders rolling down from the mounts shattered the Catastrophe-formed Originium clusters, providing people with their first inspiration for rapid movement.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000246.title: "Obtain Round Woodwheel"
	quest.C300000000000248.title: "Screeching Blowgun"
	quest.C300000000000248.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000248.quest_desc: ["Original effect: When an Operator loses 30% HP, inflicts Fear on all enemies within Attack Range for 10s", "Description: If blood gets into this blowgun meant for sounding signals and warnings, the screeching, deafening sound it makes when fired sends anyone who hears it running at once.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000248.title: "Obtain Screeching Blowgun"
	quest.C30000000000024A.title: "Varied Fortune"
	quest.C30000000000024A.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000024A.quest_desc: ["Original effect: Whenever you toss 3 Flower Coins, gain 8 Originium Ingots and 1 Hope", "Description: At dawn fowlbeasts cry, the sky a painting. Spring comes, and clouds cover sweet osmanthus. South wind blows winter, frost turned to flowers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000024A.title: "Obtain Varied Fortune"
	quest.C30000000000024B.title: "Brewed Realm"
	quest.C30000000000024B.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000024B.quest_desc: ["Original effect: For every Flower Coin in Coffer, all Operators +10% ATK and +20% HP", "Description: Cheap wine, fine liquor, all fine as long as you drink a ladle. Rush like a river, right into the gourd. A whole realm within, its taste's truly unique.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000024B.title: "Obtain Brewed Realm"
	quest.C300000000000250.title: "Plucked Risk"
	quest.C300000000000250.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000250.quest_desc: ["Original effect: All Melee Operators restore HP equal to 5% of their Max HP every second after deployment for 20s", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000250.title: "Obtain Plucked Risk"
	quest.C300000000000255.title: "Seen Flower"
	quest.C300000000000255.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000255.quest_desc: ["Original effect: On skill activation, Operators gain a Barrier equal to 10% of their Max HP that lasts for 10s (Does not stack)", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000255.title: "Obtain Seen Flower"
	quest.C300000000000265.title: "Rampart Burdenbeast"
	quest.C300000000000265.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000265.quest_desc: ["Original effect: +15 cost limit, when DP is at 99 or higher, enemies on the surrounding 12 tiles around an Objective Point lose Invisibility and have -35% hit rate", "Description: Stalwart warriors spread out and surround people gathered on burdenbeast backs as they journey toward a paradise free from any Catastrophes. This was the first 'nomadic city'.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000265.title: "Obtain Rampart Burdenbeast"
	quest.C300000000000268.title: "Coin Geists"
	quest.C300000000000268.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000268.quest_desc: ["Original effect: When the battle begins, randomize all allied Operators' Deployment Cost", "Description: Eight coins turned into one geist, but they retain their own minds. Even when one grabs the thread binding them together, they may stay defiant.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000268.title: "Obtain Coin Geists"
	quest.C30000000000026B.title: "Soldier Shadow"
	quest.C30000000000026B.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000026B.quest_desc: ["Original effect: Every time the rightmost Operator from the Deployment Waiting Zone is deployed, all deployed Operators gain a Barrier scaled to DP spent", "Description: This shadow puppet was created to honor a soldier who defended the city. Legends say they led a party in a border defense for a hundred days, and when the city fell, they stood on its walls before the sands swallowed them up. When Yumen city was built, a commemorative state was also made.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000026B.title: "Obtain Soldier Shadow"
	quest.C30000000000027A.title: "Smoky Candle"
	quest.C30000000000027A.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000027A.quest_desc: ["Original effect: Turns an Operator into a Candleguest", "Description: An ash candle created from the Hall of Candles's fireworks. It dissipates when lit, but with the past seen in the fleeting smoke, it lights an eternal flame within one's heart.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000027A.title: "Obtain Smoky Candle"
	quest.C300000000000283.title: "Silk Knot"
	quest.C300000000000283.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000283.quest_desc: ["Original effect: Operator Max HP +40% when there are other Operators in the 8 surrounding tiles", "Description: Yi's wedding gift to a staff couple, made to unravel when either is unfaithful. The couple left a long time ago, but nothing has changed with the knot.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000283.title: "Obtain Silk Knot"
	quest.C300000000000290.title: "Swaddled Bai Ze"
	quest.C300000000000290.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000290.quest_desc: ["Original effect: 干员招募时，出现临时招募的概率提升", "Description: 愿新生的它不再孤独。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000290.title: "Obtain Swaddled Bai Ze"
	quest.C300000000000294.title: "False Wings"
	quest.C300000000000294.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000294.quest_desc: ["Original effect: 我方干员击倒敌人时，获得3秒迷彩", "Description: “那棵树还剩最后一片叶子，我们能挺过这个冬天……”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000294.title: "Obtain False Wings"
	quest.C300000000000298.title: "Sanctuary"
	quest.C300000000000298.quest_subtitle: "Squad and Recruitment"
	quest.C300000000000298.quest_desc: ["Original effect: 高台干员部署时立刻获得最大生命100%的屏障", "Description: 他们的汗水如树海的雨水般落下，但好在他们有遮挡雨水的叶子来遮挡烈日。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000298.title: "Obtain Sanctuary"
	quest.C30000000000029C.title: "Another S Bonds"
	quest.C30000000000029C.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000029C.quest_desc: ["Original effect: 所有干员部署费用-50%，部署后损失70%的当前生命（退场前仅生效一次）", "Description: 你从泥土中挖出了它，它却在为这片土地复仇。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000029C.title: "Obtain Another S Bonds"
	quest.C30000000000029D.title: "Bloodstained Dictionary"
	quest.C30000000000029D.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000029D.quest_desc: ["Original effect: 所有干员生命值低于10%时，仅一次立刻获得最大生命100%的屏障", "Description: 它曾为一名正在学习书写的真正玻利瓦尔游击队员挡下致命一击，遗憾的是它的拥有者没能撑太久，也没能认识更多词。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000029D.title: "Obtain Bloodstained Dictionary"
	quest.C30000000000029E.title: "Liquid Fertilizer"
	quest.C30000000000029E.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000029E.quest_desc: ["Original effect: 我方干员攻击时流失50点生命（至少保留1点），获得100屏障（此效果获得的屏障最大为100%生命上限）", "Description: 它所到之处皆是丰收，但代价呢？总之不是收获者来付出。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000029E.title: "Obtain Liquid Fertilizer"
	quest.C30000000000029F.title: "Spicy Cocoa"
	quest.C30000000000029F.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000029F.quest_desc: ["Original effect: 干员生命值越低，攻击力越高，30%生命值时达到最大可提升攻击力（+150%）", "Description: 辣椒和可可结合的饮品，单听原料想象不出结合出来的口感，但在多索雷斯的游客当中很受欢迎。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000029F.title: "Obtain Spicy Cocoa"
	quest.C3000000000002A5.title: "Celestial Master S Brocade Pouch"
	quest.C3000000000002A5.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002A5.quest_desc: ["Original effect: 首次部署炎国干员时，在其位置召唤一只【炎佑】", "Description: 遇事不决，可掏出天师赠与的锦囊。锦囊不一定会提供建议，但至少可提供武力支援。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002A5.title: "Obtain Celestial Master S Brocade Pouch"
	quest.C3000000000002B1.title: "Bluntclaw First Move"
	quest.C3000000000002B1.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002B1.quest_desc: ["Original effect: 先锋干员开启技能时，立刻获得3点部署费用", "Description: 争分夺秒，志在夺取有利位置。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B1.title: "Obtain Bluntclaw First Move"
	quest.C3000000000002B3.title: "Iron Guard Light Step"
	quest.C3000000000002B3.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002B3.quest_desc: ["Original effect: 重装干员首次部署费用-75%", "Description: 丢掉繁琐的行囊后，守护者坚韧依旧。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B3.title: "Obtain Iron Guard Light Step"
	quest.C3000000000002B4.title: "Worn Crossbow Divine Accuracy"
	quest.C3000000000002B4.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002B4.quest_desc: ["Original effect: 狙击干员攻击面前直线上的敌人时，攻击力提升至140%", "Description: 锁定直线目标一直是狙击干员的强项，在此基础上，多加火力也照样稳健。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B4.title: "Obtain Worn Crossbow Divine Accuracy"
	quest.C3000000000002B6.title: "Healer Terrain Strategy"
	quest.C3000000000002B6.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002B6.quest_desc: ["Original effect: 医疗干员攻击范围内的地面干员阻挡数+1，可叠加", "Description: 其他干员总是喜欢围绕在医疗干员身边，听医者讲述关于即时疗愈的新方案。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B6.title: "Obtain Healer Terrain Strategy"
	quest.C3000000000002B9.title: "Hand Of Fortification"
	quest.C3000000000002B9.quest_subtitle: "Squad and Recruitment"
	quest.C3000000000002B9.quest_desc: ["Original effect: 铁卫、哨戒铁卫、不屈者部署时和技能结束后攻击力和最大生命+100%，加成在60秒内递减；拥有铁卫-轻行时，生命高于50%时阻挡数+3", "Description: 坚守不移，抵抗到底。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
