	quest.C300000000000095.quest_subtitle: "Offense"
	quest.C300000000000095.quest_desc: ["Original effect: All Operators start with +6 SP.", "Description: A coin once circulated in the now fallen nation 'Gaul.' It is in very good shape, making it highly valuable as a collector's item.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
