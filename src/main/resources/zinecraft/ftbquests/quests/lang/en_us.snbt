	quest.C3000000000000C6.quest_desc: ["Original effect: All enemy units have -15 ASPD.", "Description: A familiar face but a different vibe. Perhaps you have met this person?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
