	quest.C30000000000007D.quest_subtitle: "Offense"
	quest.C30000000000007D.quest_desc: ["Original effect: Medic Operators have +40% ATK.", "Description: Nobody else dared to attempt such a radical treatment — except Warfarin. She never made a single mistake.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
