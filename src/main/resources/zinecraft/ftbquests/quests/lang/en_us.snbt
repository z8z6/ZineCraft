	quest.C30000000000008D.title: "Red Bow Tie"
	quest.C30000000000008D.quest_subtitle: "Squad and Recruitment"
	quest.C30000000000008D.quest_desc: ["Original effect: Hope +2, Deployment Limit +1", "Description: The first present Phantom gave Miss.Christine. She is really fond of it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000008D.title: "Obtain Red Bow Tie"
