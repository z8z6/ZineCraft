	quest.C300000000000097.quest_desc: ["Original effect: All Operators start with +12 SP.", "Description: An extravagant checkbook plated in gold and silver. Can no longer be cashed.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
