	quest.C3000000000000A7.title: "Golden Chalice"
	quest.C3000000000000A7.quest_subtitle: "No.167 · Offense"
	quest.C3000000000000A7.quest_desc: ["Original effect: For each 5 Originium Ingots in possession, all friendly units have +7 ASPD", "Description: Saints, knights, and pietists. All of them are madmen. Dear God, even the chalice itself is made of pure gold!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A7.title: "Obtain Golden Chalice"
	quest.C3000000000000A8.title: "Spinach Pack"
	quest.C3000000000000A8.quest_subtitle: "No.168 · Offense"
	quest.C3000000000000A8.quest_desc: ["Original effect: All friendly units have +60% ATK for one second after their skill becomes active", "Description: Many Cautus out there believe that popping the contents of this can into their mouths will grant them immense strength. The marketing's effectiveness is a classic success story in the industry.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
