	chapter.434F4C4C45435449.title: "Collectible Encyclopedia"
	quest.C100000000000001.title: "Offense"
	quest.C100000000000001.quest_subtitle: "Contains 193 collectibles."
	quest.C100000000000001.quest_desc: ["Primarily improves damage or attack speed, or reduces enemy defenses.", "Contains 193 collectibles."]
	task.C200000000000001.title: "Read category guide"
	quest.C300000000000031.title: "Worn Out Group Photo"
	quest.C300000000000031.quest_subtitle: "Offense"
	quest.C300000000000031.quest_desc: ["Original effect: All enemy units have -12% DEF.", "Description: Do you know someone in the photo?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000031.title: "Obtain Worn Out Group Photo"
	quest.C300000000000032.title: "Writers Tongue"
	quest.C300000000000032.quest_subtitle: "Offense"
	quest.C300000000000032.quest_desc: ["Original effect: All enemy units have -21% DEF.", "Description: The playwright penned his creations with a quill and his own blood, and for himself he devised an ending in which he perishes in a sea of flames.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000032.title: "Obtain Writers Tongue"
	quest.C300000000000033.title: "Rosmontiss Embrace"
	quest.C300000000000033.quest_subtitle: "Offense"
	quest.C300000000000033.quest_desc: ["Original effect: All enemy units have -30% DEF.", "Description: 'Who will be the judge?'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000033.title: "Obtain Rosmontiss Embrace"
	quest.C30000000000003A.title: "Emperors Favor"
	quest.C30000000000003A.quest_subtitle: "Offense"
	quest.C30000000000003A.quest_desc: ["Original effect: All friendly melee units have +15% ATK.", "Description: A very sharp letter opener. It was one of the favorite possessions of the last Ursus emperor, and as such it was very rarely used to actually open letters.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003A.title: "Obtain Emperors Favor"
	quest.C30000000000003B.title: "Royal Rapier"
	quest.C30000000000003B.quest_subtitle: "Offense"
	quest.C30000000000003B.quest_desc: ["Original effect: All friendly melee units have +25% ATK.", "Description: A highly decorative rapier for nobles. Used by Gaulish nobles first and foremost, though perhaps a little fragile for a military weapon.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003B.title: "Obtain Royal Rapier"
	quest.C30000000000003C.title: "Vieux Vanguards Blade"
	quest.C30000000000003C.quest_subtitle: "Offense"
	quest.C30000000000003C.quest_desc: ["Original effect: All friendly melee units have +35% ATK.", "Description: Prior to its downfall, Gaul first witnessed the sacrifices of its Vieux Vanguards.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003C.title: "Obtain Vieux Vanguards Blade"
	quest.C30000000000003D.title: "Necklace Of The Presence"
	quest.C30000000000003D.quest_subtitle: "Offense"
	quest.C30000000000003D.quest_desc: ["Original effect: All friendly ranged units have +15% ATK.", "Description: Faith hangs ten centimeters above your heart, spoken words flow into your blood, and bullets slide into your magazine.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003D.title: "Obtain Necklace Of The Presence"
	quest.C30000000000003E.title: "Silver Forks"
	quest.C30000000000003E.quest_subtitle: "Offense"
	quest.C30000000000003E.quest_desc: ["Original effect: All friendly ranged units have +25% ATK.", "Description: One for dealing with actors who botch their performances, one for dealing with incompetent playwrights, and one for anyone who needs it. The Chief will not tolerate any mistakes on the table.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003E.title: "Obtain Silver Forks"
	quest.C30000000000003F.title: "Damaged Revolver Cylinder"
	quest.C30000000000003F.quest_subtitle: "Offense"
	quest.C30000000000003F.quest_desc: ["Original effect: All friendly ranged units have +35% ATK.", "Description: She never capitulated, even after enduring countless trials and tribulations. Her muzzle belched tongues of flame that burned like an angry sun, and the glow above her head was brighter than the daylight itself. Buried here is Outcast, our friend.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000003F.title: "Obtain Damaged Revolver Cylinder"
	quest.C30000000000005E.title: "Blunt Claws Burst"
	quest.C30000000000005E.quest_subtitle: "Offense"
	quest.C30000000000005E.quest_desc: ["Original effect: Vanguard Operators start with +15 SP.", "Description: He's already done all the reserve squad's work for them. What else do you expect?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000005E.title: "Obtain Blunt Claws Burst"
	quest.C30000000000005F.title: "Blunt Claws Proficiency"
	quest.C30000000000005F.quest_subtitle: "Offense"
	quest.C30000000000005F.quest_desc: ["Original effect: The SP Cost of Vanguard Operators' skills is decreased by -35%.", "Description: As an operator who often enters the battlefield before anyone else, you cannot fathom what they have been through.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000005F.title: "Obtain Blunt Claws Proficiency"
	quest.C300000000000063.title: "Bend Spears Acuity"
	quest.C300000000000063.quest_subtitle: "Offense"
	quest.C300000000000063.quest_desc: ["Original effect: Guard Operators have +25% ATK.", "Description: 'This is the 7th blade you've broken this month.' 'But I cut down eight enemies this month.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000063.title: "Obtain Bend Spears Acuity"
	quest.C300000000000064.title: "Bend Spears Bloodbath"
	quest.C300000000000064.quest_subtitle: "Offense"
	quest.C300000000000064.quest_desc: ["Original effect: Guard Operators restore 2 SP after each attack.", "Description: Soldiers who get bolder as time passes are rare. Most need some form of psychological counseling to alleviate the trauma of war.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000064.title: "Obtain Bend Spears Bloodbath"
	quest.C300000000000066.title: "Bend Spears Deathmatch"
	quest.C300000000000066.quest_subtitle: "Offense"
	quest.C300000000000066.quest_desc: ["Original effect: Guard Operators have -40% DEF, but gain +40% ATK and +30 ASPD.", "Description: I wouldn't really recommend learning those skills from Blaze.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000066.title: "Obtain Bend Spears Deathmatch"
	quest.C300000000000068.title: "Iron Guard Invasion"
	quest.C300000000000068.quest_subtitle: "Offense"
	quest.C300000000000068.quest_desc: ["Original effect: Defender Operators have +60% ATK.", "Description: Defensive actions for the sake of teammates or strategic purposes often make people forget about their original aggressiveness.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000068.title: "Obtain Iron Guard Invasion"
	quest.C30000000000006A.title: "Iron Guard Advance"
	quest.C30000000000006A.quest_subtitle: "Offense"
	quest.C30000000000006A.quest_desc: ["Original effect: Defender Operators have -1 Block (will not be reduced below 1), but gain +40% ATK and +40 ASPD.", "Description: In exchange for an opportunity to attack, the shattered ranks made one more advance.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006A.title: "Obtain Iron Guard Advance"
	quest.C30000000000006B.title: "Iron Guard Impenetrable"
	quest.C30000000000006B.quest_subtitle: "Offense"
	quest.C30000000000006B.quest_desc: ["Original effect: Defender Operators restore 2 SP after being attacked.", "Description: Every blow they endure will turn into anger and be returned severalfold.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006B.title: "Obtain Iron Guard Impenetrable"
	quest.C30000000000006D.title: "Fatal Bolts Precision"
	quest.C30000000000006D.quest_subtitle: "Offense"
	quest.C30000000000006D.quest_desc: ["Original effect: Sniper Operators have +20% ATK.", "Description: In an era when Originium Arts were not as robust as they are now, Yan had a saying, 'a pierced willow leaf from a hundred paces,' to praise others for their mastery of archery.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006D.title: "Obtain Fatal Bolts Precision"
	quest.C30000000000006E.title: "Fatal Bolts Synergy"
	quest.C30000000000006E.quest_subtitle: "Offense"
	quest.C30000000000006E.quest_desc: ["Original effect: Increases the SP regen rate of Sniper Operators by +0.5/s", "Description: The more intimate a sniper is with her weapon, the less likely she is to be betrayed by it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000006E.title: "Obtain Fatal Bolts Synergy"
	quest.C30000000000006F.title: "Fatal Bolts Crossfire"
	quest.C30000000000006F.quest_subtitle: "Offense"
