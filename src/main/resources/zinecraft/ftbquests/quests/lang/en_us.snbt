	quest.C300000000000079.quest_desc: ["Original effect: Enemies within the attack range of Supporter Operators have -15% ATK.", "Description: There are many ways to weaken an enemy's offensive capabilities: corroding their weapons, psychological warfare, increasing their weight, and... giving them a stomachache.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000079.title: "Obtain Stalwart Aid Demoralize"
	quest.C30000000000007F.title: "Healers Path Restore Sanity"
	quest.C30000000000007F.quest_subtitle: "No.127 · Defense"
	quest.C30000000000007F.quest_desc: ["Original effect: Allied units within the attack range of Medic Operators gain Resistance.", "Description: Reinforce your thinking. In the domain of your mind, make even every weed impregnable.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007F.title: "Obtain Healers Path Restore Sanity"
	quest.C3000000000000A2.title: "Renowned Singer"
	quest.C3000000000000A2.quest_subtitle: "No.162 · Defense"
	quest.C3000000000000A2.quest_desc: ["Original effect: Enemies receive 600 Arts Damage per second when stunned, frozen, or bound", "Description: Who cares what it's singing? Make it stop! It's hurting my ears!", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A2.title: "Obtain Renowned Singer"
	quest.C3000000000000A3.title: "String Puppet"
	quest.C3000000000000A3.quest_subtitle: "No.163 · Defense"
	quest.C3000000000000A3.quest_desc: ["Original effect: Enemies receive 700 Arts Damage per second when stunned, frozen, or bound", "Description: The more you struggle and try to break free, the tighter the strings get. Do you really think you are still thinking rationally?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A3.title: "Obtain String Puppet"
	quest.C3000000000000A4.title: "Childrens Puppet"
	quest.C3000000000000A4.quest_subtitle: "No.164 · Defense"
	quest.C3000000000000A4.quest_desc: ["Original effect: Enemies receive 1000 Arts Damage per second when stunned, frozen, or bound", "Description: A simple puppet made by Iberian children using trinkets found on the seacoast. Supposedly just holding it tight will give you much richer dreams.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A4.title: "Obtain Childrens Puppet"
	quest.C3000000000000AB.title: "Civilight Eterna"
	quest.C3000000000000AB.quest_subtitle: "No.171 · Defense"
	quest.C3000000000000AB.quest_desc: ["Original effect: All enemies take +150% True damage.", "Description: A small, black crown.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000AB.title: "Obtain Civilight Eterna"
	quest.C3000000000000AF.title: "Royal Alliance Treaty"
	quest.C3000000000000AF.quest_subtitle: "No.175 · Defense"
	quest.C3000000000000AF.quest_desc: ["Original effect: All friendly units no longer receive any damage from Sarkaz enemies", "Description: The old Sarkaz courts sacrificed themselves to obtain their power. Ever since, the courts have come to terms with one another, banding together against their common enemy.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000AF.title: "Obtain Royal Alliance Treaty"
	quest.C3000000000000B3.title: "Victoria Crown"
	quest.C3000000000000B3.quest_subtitle: "No.179 · Defense"
	quest.C3000000000000B3.quest_desc: ["Original effect: All enemy units have +30% ATK, DEF, and Max HP; Boss units gain an additional +15% ATK, +15% DEF, and +30% Max HP", "Description: When the last Aslan to rule Victoria was sent to the guillotine, the angry masses rushed forward to trample his reign into dust.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B3.title: "Obtain Victoria Crown"
	quest.C3000000000000B4.title: "Victoria Crown Reforged"
	quest.C3000000000000B4.quest_subtitle: "No.180 · Defense"
	quest.C3000000000000B4.quest_desc: ["Original effect: All enemy units have +35% ATK, DEF, and Max HP; Leader enemies gain an additional +20% ATK, DEF and +50% Max HP, but these leader bonuses are halved when your squad has Operators from all 8 Classes", "Description: When the last Aslan to rule Victoria was sent to the guillotine, the angry masses rushed forward to trample his reign into dust.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B4.title: "Obtain Victoria Crown Reforged"
	quest.C3000000000000CE.title: "Numbness And Obscenity"
	quest.C3000000000000CE.quest_subtitle: "No.206 · Defense"
	quest.C3000000000000CE.quest_desc: ["Original effect: All friendly units have +5 RES", "Description: A famous art piece and the final piece created by an insane Leithanian sculptor two hundred years ago. The sculptor was known for his extraordinary talent and his participation in multiple cruel homicides. However, historical records show that few people took notice of his work. He was instead known for his features and beauty.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000CE.title: "Obtain Numbness And Obscenity"
	quest.C3000000000000DE.title: "Royal Brooch"
	quest.C3000000000000DE.quest_subtitle: "No.222 · Defense"
	quest.C3000000000000DE.quest_desc: ["Original effect: All allied units have RES +15, and gain one-time dodge after deployment", "Description: An ornament worn by Gaulish royalty, made from gold and inlaid with expensive Originium crystals. They are more than decoration: many of these brooches hide Originium circuits loaded with defensive Arts.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DE.title: "Obtain Royal Brooch"
	quest.C3000000000000E3.title: "Scouts Scope"
	quest.C3000000000000E3.quest_subtitle: "No.227 · Defense"
	quest.C3000000000000E3.quest_desc: ["Original effect: Enemies take increased damage from allied units as range increases (max 100%)", "Description: Lock on, aim, fire, and destroy the enemy's will to resist, all in the name of a better future that Scout will never see. Maybe you can do it for him.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E3.title: "Obtain Scouts Scope"
	quest.C3000000000000E8.title: "Assault Co Op Skirmish"
	quest.C3000000000000E8.quest_subtitle: "No.232 · Defense"
	quest.C3000000000000E8.quest_desc: ["Original effect: Increases the DEF of Vanguard and Guard Operators by +10% for each Vanguard or Guard Operator in the combat squad.", "Description: A sophisticated blocking technique is essential to protecting one's body.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E8.title: "Obtain Assault Co Op Skirmish"
	quest.C3000000000000EA.title: "Fortification Contract Resolution"
	quest.C3000000000000EA.quest_subtitle: "No.234 · Defense"
	quest.C3000000000000EA.quest_desc: ["Original effect: Increases the DEF of Defender and Supporter Operators by +10% for each Defender or Supporter Operator in the combat squad.", "Description: Use the hardest shield to block the sharpest spear. I guarantee you that the spear will break first, trust me.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
