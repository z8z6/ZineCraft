	quest.C30000000000009A.title: "Ball Juice"
	quest.C30000000000009A.quest_subtitle: "No.154 · Offense"
	quest.C30000000000009A.quest_desc: ["Original effect: Increases the SP regen rate of Auto Recovery skills by +0.25/s", "Description: They call it fruit juice, but it's actually alcohol. The bottle itself states that minors are forbidden from drinking it. Its Victorian place of origin once fell within Gaul's territory.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000009A.title: "Obtain Ball Juice"
	quest.C30000000000009B.title: "Fowlbeast Liver Pate"
