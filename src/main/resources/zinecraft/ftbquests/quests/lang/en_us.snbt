{
	chapter.5A494E4543524146.title: "Zinecraft: Terra Expedition"
	quest.1000000000000001.title: "Expedition Handbook"
	quest.1000000000000001.quest_subtitle: "Dimensions, national biomes, and weapons"
	quest.1000000000000001.quest_desc: ["This chapter guides you to an Overworld stargate, through the Terra dimension and its nineteen national biomes, and into Zinecraft sword, firearm, and staff training.\n\nCheck the task below to begin."]
	quest.1000000000000002.title: "Find a Snowy-Plains Stargate"
	quest.1000000000000002.quest_desc: ["Stargate ruins generate only in Overworld snowy plains. Find minecraft:snowy_plains, then look for a monumental dark arch with massive buttresses. An inactive arch has no event horizon."]
	quest.1000000000000003.title: "Protocol Activation and Transit"
	quest.1000000000000003.quest_desc: ["Craft Protocol Originium from Originite, a Crystalline Circuit, and an Integrated Device. Hold it and right-click the Stargate Protocol Controller on the pedestal outside the monumental arch. The cyan event horizon forms only after authorization; the Protocol Originium acts as a reusable key and is not consumed. Enter it to reach zinecraft:terra. A powered return gate is created automatically on the Terra side so you cannot become stranded."]

	quest.2000000000000001.title: "Aegir Abyssal Sea"
	quest.2000000000000001.quest_desc: ["Abyssal-slate seabeds and pressure-tile enclaves inhabited by dolphins, with Aegir-themed settlements and landmarks."]
	quest.2000000000000002.title: "Bolivar Plain"
	quest.2000000000000002.quest_desc: ["War-scoured soil plains with parrots, Dossoles-stucco districts, and regional landmarks."]
	quest.2000000000000003.title: "Higashi Shadow Rift"
	quest.2000000000000003.quest_desc: ["A dim shadow-loam mountain forest inhabited by foxes, with plastered machiya towns and a rift shrine."]
	quest.2000000000000004.title: "Durin Underground Garden"
	quest.2000000000000004.quest_desc: ["Garden moss and glow squid illuminate an underground garden where colorful Ideal City panels hide among the caves."]
	quest.2000000000000005.title: "Columbia Sandstone Wilds"
	quest.2000000000000005.quest_desc: ["Canyon soil, armadillos, panel-built frontier towns, and research facilities define the Columbian frontier."]
	quest.2000000000000006.title: "Kazimierz Knightland"
	quest.2000000000000006.quest_desc: ["Dry steppe turf supports horses and knightly boroughs crowned by arena masonry."]
	quest.2000000000000007.title: "Kazdel Scarred Wastes"
	quest.2000000000000007.quest_desc: ["Scarred ash wastes hold cave spiders, armored Sarkaz settlements, and Babel-themed ruins."]
	quest.2000000000000008.title: "Laterano Holy Fields"
	quest.2000000000000008.quest_desc: ["Bright alluvial-chalk fields surround bees, marble monastery towns, and Laterano citizens who carry firearms by default."]
	quest.2000000000000009.title: "Leithanien Twilight Forest"
	quest.2000000000000009.quest_desc: ["Twilight humus forests hold wolves, resonant-brick musical towns, and twin-tower landmarks."]
	quest.200000000000000A.title: "Rim Billiton Mining Badlands"
	quest.200000000000000A.quest_desc: ["Mine-tailings fields contain husks, corrugated-steel camps, rail facilities, and industrial drilling landmarks."]
	quest.200000000000000B.title: "Minos Sunlit Hills"
	quest.200000000000000B.quest_desc: ["Sunbaked-earth hills host goats, heroic-masonry city-states, and monuments inspired by the Twelve Heroes."]
	quest.200000000000000C.title: "Sargon Rocky Desert"
	quest.200000000000000C.quest_desc: ["Camels, adobe oasis towns, and caravan routes cross the desert crust, concealing Golden City-inspired landmarks."]
	quest.200000000000000D.title: "Sami Frozen Forest"
	quest.200000000000000D.quest_desc: ["Polar bears and ritual-stone snow-priest villages inhabit frost-moss taiga around mysterious ancient altars."]
	quest.200000000000000E.title: "Victoria Misty Highlands"
	quest.200000000000000E.quest_desc: ["Moorland-soil highlands remain shrouded in mist around sheep, industrial-brick boroughs, steam works, and defenses."]
	quest.200000000000000F.title: "Ursus Frozen Steppe"
	quest.200000000000000F.quest_desc: ["Permafrost covers the northern plateau, where strays roam among imperial-masonry towns, mines, and Sarcophagus facilities."]
	quest.2000000000000010.title: "Kjerag Snowy Peaks"
	quest.2000000000000010.quest_desc: ["Rabbits inhabit sacred-snowstone ridges dotted with monastery-stone villages, trade routes, and Karlan architecture."]
	quest.2000000000000011.title: "Siracusa Rainy Woodland"
	quest.2000000000000011.quest_desc: ["Rain-darkened woods contain spiders, family-masonry towns, theatres, and courts reflecting local order."]
	quest.2000000000000012.title: "Yan Mountain Grove"
	quest.2000000000000012.quest_desc: ["Pandas roam mountain soil around blue-brick Shangshu towns, pavilions, tea houses, and Yumen beacons."]
	quest.2000000000000013.title: "Iberia Salt Delta"
	quest.2000000000000013.quest_desc: ["Salt winds scour salt-crusted gravel while drowned haunt coastal-masonry towns watched over by lighthouses."]
	quest.2000000000000020.title: "Terra Geographer"
	quest.2000000000000020.quest_desc: ["You have visited all nineteen national biomes. Confirm the completed survey and claim your expedition experience."]

	quest.3000000000000001.title: "Training Loadout"
	quest.3000000000000001.quest_subtitle: "Claim a test sword, rifle, ammunition, and staff"
	quest.3000000000000001.quest_desc: ["Zinecraft's server-side action system controls weapon hits, damage, ammunition, and skill effects. Claim the training equipment, then complete the three basic drills."]
	quest.3000000000000002.title: "Sword Drill"
	quest.3000000000000002.quest_desc: ["Hold the Test Sword in your main hand and left-click to perform a light attack with wind-up and active frames. Practise on a safe target, then confirm completion."]
	quest.3000000000000003.title: "Firearm Drill"
	quest.3000000000000003.quest_desc: ["The Test Rifle holds 12 rounds. Left-click to fire, right-click to toggle aiming, and press R to reload from Test Cartridges in your inventory. Fire and reload once, then confirm completion."]
	quest.3000000000000004.title: "Staff Drill"
	quest.3000000000000004.quest_desc: ["Left-click the Test Staff to cast Arcane Bolt and right-click to cast Mending Light. Both effects execute server-side on the action's active frame. Practise both, then confirm completion."]
	quest.3000000000000005.title: "TaCZ Firearm Adapter"
	quest.3000000000000005.quest_subtitle: "Optional: requires external TaCZ gun-pack resources"
	quest.3000000000000005.quest_desc: ["Zinecraft loads compatible TaCZ gun packs and maps every gun to a component-backed zinecraft:tacz_gun. Left-click fires, right-click aims, R reloads, B selects fire mode, X inspects, and V performs firearm melee.\n\nThis quest is optional and does not block progression when no gun-pack resources are installed."]
	quest.3000000000000006.title: "Basic Weapons Certification"
	quest.3000000000000006.quest_desc: ["Sword, firearm, and staff training are complete. Confirm your certification and claim the experience reward; the TaCZ adapter remains an independent optional challenge."]

	task.1100000000000001.title: "Begin the Terra expedition"
	task.2100000000000020.title: "Submit the complete survey"
	task.3100000000000001.title: "Claim the training equipment"
	task.3100000000000003.title: "I completed the light-attack drill"
	task.3100000000000005.title: "I fired and reloaded the rifle"
	task.3100000000000007.title: "I practised both staff spells"
	task.3100000000000009.title: "I tested the TaCZ firearm actions"
	task.310000000000000A.title: "Submit basic weapons certification"

	chapter.54455252414E4554.title: "Terra Nation Relations"
	quest.4000000000000000.title: "Network Legend"
	quest.4000000000000000.quest_subtitle: "Select a national emblem to inspect diplomacy and state power"
	quest.4000000000000000.quest_desc: ["Each node represents a nation. A line marks a significant bilateral relation backed by explicit PRTS evidence in TerraNationRelations. No line means the neutral default is in use or that the current sources are not explicit enough.\n\nState values: prosperity / stability / military / openness / aggression. Relation values: favor / war desire / trade / tension / trust. Most values use 0–100; favor and trust use -100–100.\n\nImportant: line colors only show FTB quest progress, not diplomatic sentiment. State and relation scores are gameplay-oriented initial estimates; the factual basis comes from PRTS.\n\nCheck the task to mark the legend as read."]
	task.4100000000000000.title: "I understand the network legend"

	quest.4000000000000001.title: "Aegir"
	quest.4000000000000001.quest_subtitle: "Prosperity 72 / Stability 50 / Military 80 / Openness 10 / Aggression 15"
	quest.4000000000000001.quest_desc: ["State: technologically advanced beneath the sea, but closed to land nations.\n\nKey relation:\n• Iberia: -25 / 10 / 18 / 52 / -45 (technology transfer; estrangement after the Profound Silence)"]
	quest.4000000000000002.title: "Bolivar"
	quest.4000000000000002.quest_subtitle: "Prosperity 35 / Stability 20 / Military 45 / Openness 55 / Aggression 55"
	quest.4000000000000002.quest_desc: ["State: prolonged division and proxy conflict severely suppress stability and prosperity.\n\nKey relations:\n• Columbia: -55 / 72 / 25 / 85 / -65 (active and proxy conflict)\n• Leithanien: 25 / 22 / 55 / 55 / 15 (investment and proxy conflict)"]
	quest.4000000000000003.title: "Higashi"
	quest.4000000000000003.quest_subtitle: "Prosperity 62 / Stability 40 / Military 60 / Openness 45 / Aggression 40"
	quest.4000000000000003.quest_desc: ["State: internally complex and historically pressured by the northern power.\n\nKey relation:\n• Ursus: -60 / 68 / 12 / 82 / -70 (historic war and border tension)"]
	quest.4000000000000004.title: "Durin"
	quest.4000000000000004.quest_subtitle: "Prosperity 82 / Stability 80 / Military 35 / Openness 55 / Aggression 15"
	quest.4000000000000004.quest_desc: ["State: wealthy and stable underground cities with little appetite for military expansion.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000005.title: "Columbia"
	quest.4000000000000005.quest_subtitle: "Prosperity 88 / Stability 72 / Military 85 / Openness 90 / Aggression 65"
	quest.4000000000000005.quest_desc: ["State: powerful economy, technology, and military, combining openness with clear expansionism.\n\nKey relations:\n• Bolivar: -55 / 72 / 25 / 85 / -65 (proxy conflict)\n• Leithanien: -40 / 52 / 35 / 72 / -45 (proxy rivalry)\n• Kjerag: 32 / 8 / 72 / 20 / 25 (investment and trade)\n• Victoria: -28 / 28 / 62 / 58 / -30 (trade and border tension)"]
	quest.4000000000000006.title: "Kazimierz"
	quest.4000000000000006.quest_subtitle: "Prosperity 78 / Stability 65 / Military 72 / Openness 75 / Aggression 45"
	quest.4000000000000006.quest_desc: ["State: commercially prosperous and militarily capable, under lasting northern border pressure.\n\nKey relation:\n• Ursus: -65 / 78 / 12 / 85 / -72 (historic war and border tension)"]
	quest.4000000000000007.title: "Kazdel"
	quest.4000000000000007.quest_subtitle: "Prosperity 30 / Stability 30 / Military 88 / Openness 35 / Aggression 70"
	quest.4000000000000007.quest_desc: ["State: low prosperity and stability, but very high military capability and conflict pressure.\n\nKey relations:\n• Victoria: -65 / 48 / 8 / 72 / -78 (historic war and occupation)\n• Laterano → Kazdel: -72 / 18 / 2 / 75 / -80 (diplomatic exclusion; one-way policy)"]
	quest.4000000000000008.title: "Laterano"
	quest.4000000000000008.quest_subtitle: "Prosperity 85 / Stability 88 / Military 78 / Openness 82 / Aggression 12"
	quest.4000000000000008.quest_desc: ["State: highly prosperous and stable, frequently acting as an international witness and mediator.\n\nKey relations:\n• Iberia: 20 / 4 / 42 / 22 / 18 (religious ties and mediation)\n• Kazdel: -72 / 18 / 2 / 75 / -80 (diplomatic exclusion; Laterano's one-way policy)"]
	quest.4000000000000009.title: "Leithanien"
	quest.4000000000000009.quest_subtitle: "Prosperity 80 / Stability 70 / Military 82 / Openness 65 / Aggression 35"
	quest.4000000000000009.quest_desc: ["State: strong across all major measures and influential through investment and proxies.\n\nKey relations:\n• Bolivar: 25 / 22 / 55 / 55 / 15 (investment and proxy conflict)\n• Columbia: -40 / 52 / 35 / 72 / -45 (proxy rivalry)\n• Kjerag: 28 / 6 / 65 / 16 / 24 (investment and trade)"]
	quest.400000000000000A.title: "Rim Billiton"
	quest.400000000000000A.quest_subtitle: "Prosperity 72 / Stability 75 / Military 45 / Openness 85 / Aggression 20"
	quest.400000000000000A.quest_desc: ["State: an open, active mining economy with low military expansionism.\n\nKey relation:\n• Kjerag: 42 / 4 / 80 / 12 / 38 (investment and trade)"]
	quest.400000000000000B.title: "Minos"
	quest.400000000000000B.quest_subtitle: "Prosperity 60 / Stability 68 / Military 62 / Openness 55 / Aggression 30"
	quest.400000000000000B.quest_desc: ["State: broadly moderate and stable, with mid-range national power.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.400000000000000C.title: "Sargon"
	quest.400000000000000C.quest_subtitle: "Prosperity 65 / Stability 60 / Military 70 / Openness 70 / Aggression 40"
	quest.400000000000000C.quest_desc: ["State: vast and trade-oriented, with upper-middle military power and conflict pressure.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.400000000000000D.title: "Sami"
	quest.400000000000000D.quest_subtitle: "Prosperity 38 / Stability 70 / Military 75 / Openness 25 / Aggression 15"
	quest.400000000000000D.quest_desc: ["State: closed to outsiders but capable in defence, with little appetite for offensive war.\n\nKey relation:\n• Ursus: -58 / 72 / 8 / 80 / -68 (historic war and border tension)"]
	quest.400000000000000E.title: "Victoria"
	quest.400000000000000E.quest_subtitle: "Prosperity 76 / Stability 40 / Military 90 / Openness 72 / Aggression 55"
	quest.400000000000000E.quest_desc: ["State: militarily powerful and economically open, but internally unstable.\n\nKey relations:\n• Kazdel: -65 / 48 / 8 / 72 / -78 (historic war and occupation)\n• Kjerag: 38 / 6 / 62 / 16 / 32 (investment and trade)\n• Columbia: -28 / 28 / 62 / 58 / -30 (trade and border tension)"]
	quest.400000000000000F.title: "Ursus"
	quest.400000000000000F.quest_subtitle: "Prosperity 55 / Stability 38 / Military 92 / Openness 30 / Aggression 85"
	quest.400000000000000F.quest_desc: ["State: exceptionally high military power and aggression, with low openness and internal stability.\n\nKey relations:\n• Kazimierz: -65 / 78 / 12 / 85 / -72\n• Sami: -58 / 72 / 8 / 80 / -68\n• Higashi: -60 / 68 / 12 / 82 / -70\nAll three are marked by historic war and border tension."]
	quest.4000000000000010.title: "Kjerag"
	quest.4000000000000010.quest_subtitle: "Prosperity 58 / Stability 72 / Military 48 / Openness 52 / Aggression 20"
	quest.4000000000000010.quest_desc: ["State: stable and reluctant to wage war, gradually opening through reform.\n\nKey relations:\n• Victoria: 38 / 6 / 62 / 16 / 32\n• Columbia: 32 / 8 / 72 / 20 / 25\n• Leithanien: 28 / 6 / 65 / 16 / 24\n• Rim Billiton: 42 / 4 / 80 / 12 / 38\nAll four primarily involve investment and trade."]
	quest.4000000000000011.title: "Siracusa"
	quest.4000000000000011.quest_subtitle: "Prosperity 70 / Stability 55 / Military 65 / Openness 72 / Aggression 45"
	quest.4000000000000011.quest_desc: ["State: open and commercially active, with family rule producing both order and conflict.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000012.title: "Yan"
	quest.4000000000000012.quest_subtitle: "Prosperity 88 / Stability 88 / Military 90 / Openness 60 / Aggression 20"
	quest.4000000000000012.quest_desc: ["State: highly prosperous, stable, and militarily powerful, with low offensive aggression.\n\nNo significant bilateral relation with sufficiently explicit PRTS evidence is currently recorded; the system uses neutral defaults toward other nations."]
	quest.4000000000000013.title: "Iberia"
	quest.4000000000000013.quest_subtitle: "Prosperity 32 / Stability 52 / Military 65 / Openness 15 / Aggression 25"
	quest.4000000000000013.quest_desc: ["State: prosperity and openness fell sharply after the Profound Silence, while some military strength remains.\n\nKey relations:\n• Aegir: -48 / 24 / 12 / 68 / -62 (technology transfer and diplomatic exclusion)\n• Laterano: 20 / 4 / 42 / 22 / 18 (religious ties and mediation)"]

	chapter_group.4E4154494F4E5347.title: "Terra Nation Archive"
	chapter.4E4154494F4E5343.title: "Nineteen Nations and Landmarks"
	quest.5000000000000000.title: "Reading Guide"
	quest.5000000000000000.quest_subtitle: "PRTS source material and Zinecraft gameplay implementations are kept distinct"
	quest.5000000000000000.quest_desc: ["This chapter follows the nineteen nations currently listed by the PRTS Terra Compendium. Each node identifies its source entry, then lists the biome, repeatable settlement, and two world-unique landmarks implemented by Zinecraft.\n\nThese buildings and landscapes are Minecraft gameplay adaptations, not official Arknights scene reproductions."]
	task.5100000000000000.title: "I understand the source and adaptation boundary"
	quest.5000000000000001.title: "Aegir"
	quest.5000000000000001.quest_subtitle: "Nation source and pressure-resistant architecture"
	quest.5000000000000001.quest_desc: ["PRTS entry: Terra Compendium geography/Aegir.\n\nZinecraft: aegir_abyssal_sea; aegir_subsea_enclave; aegir_volcanic_beacon and aegir_abyssal_observatory."]
	quest.5000000000000002.title: "Bolivar"
	quest.5000000000000002.quest_subtitle: "Northwestern plains, Dossoles, and prolonged conflict"
	quest.5000000000000002.quest_desc: ["PRTS records Bolivar as a northwestern Terra nation bordering Columbia, with conflict arising from overlapping Originium mining areas in the Crystalline Era.\n\nZinecraft: bolivar_plain; bolivar_dossoles_district; bolivar_dossoles_yacht and bolivar_race_checkpoint."]
	quest.5000000000000003.title: "Higashi"
	quest.5000000000000003.quest_subtitle: "Nation source and rift-town architecture"
	quest.5000000000000003.quest_desc: ["PRTS entry: Terra Compendium geography/Higashi.\n\nZinecraft: higashi_shadow_rift; higashi_sokogawa_town; higashi_rift_shrine and higashi_sokogawa_watchtower."]
	quest.5000000000000004.title: "Durin"
	quest.5000000000000004.quest_subtitle: "Underground nation source and Ideal City architecture"
	quest.5000000000000004.quest_desc: ["PRTS entry: Terra Compendium geography/Durin.\n\nZinecraft: durin_underground_garden; durin_ideal_city_block; durin_dome_station and durin_water_park."]
	quest.5000000000000005.title: "Columbia"
	quest.5000000000000005.quest_subtitle: "Nation source and frontier architecture"
	quest.5000000000000005.quest_desc: ["PRTS entry: Terra Compendium geography/Columbia.\n\nZinecraft: columbia_sandstone_wilds; columbia_frontier_town; columbia_frontier_lab and columbia_prison_outpost."]
	quest.5000000000000006.title: "Kazimierz"
	quest.5000000000000006.quest_subtitle: "Knight nation source and arena architecture"
	quest.5000000000000006.quest_desc: ["PRTS entry: Terra Compendium geography/Kazimierz.\n\nZinecraft: kazimierz_knightland; kazimierz_knight_borough; kazimierz_arena_gate and kazimierz_knight_monument."]
	quest.5000000000000007.title: "Kazdel"
	quest.5000000000000007.quest_subtitle: "Sarkaz nation source and scarred architecture"
	quest.5000000000000007.quest_desc: ["PRTS entry: Terra Compendium geography/Kazdel.\n\nZinecraft: kazdel_scarred_wastes; kazdel_sarkaz_settlement; kazdel_babel_ruins and kazdel_sarkaz_camp."]
	quest.5000000000000008.title: "Laterano"
	quest.5000000000000008.quest_subtitle: "Nation source and holy-city architecture"
	quest.5000000000000008.quest_desc: ["PRTS entry: Laterano.\n\nZinecraft: laterano_holy_fields; laterano_monastery_town; laterano_revelation_tower and laterano_ambrosius_chapel, plus the underground Laterano Host."]
	quest.5000000000000009.title: "Leithanien"
	quest.5000000000000009.quest_subtitle: "Nation source and musical architecture"
	quest.5000000000000009.quest_desc: ["PRTS entry: Terra Compendium geography/Leithanien.\n\nZinecraft: leithanien_twilight_forest; leithanien_music_town; leithanien_twin_spires and leithanien_concert_hall."]
	quest.500000000000000A.title: "Rim Billiton"
	quest.500000000000000A.quest_subtitle: "Mining nation source and industrial architecture"
	quest.500000000000000A.quest_desc: ["PRTS entry: Terra Compendium geography/Rim Billiton.\n\nZinecraft: rim_billiton_mining_badlands; rim_billiton_mining_camp; rim_billiton_mining_derrick and rim_billiton_rail_depot."]
	quest.500000000000000B.title: "Minos"
	quest.500000000000000B.quest_subtitle: "Nation source and heroic architecture"
	quest.500000000000000B.quest_desc: ["PRTS entry: Terra Compendium geography/Minos.\n\nZinecraft: minos_sunlit_hills; minos_heroic_polis; minos_heroes_temple and minos_heroes_plaza."]
	quest.500000000000000C.title: "Sargon"
	quest.500000000000000C.quest_subtitle: "Nation source and oasis architecture"
	quest.500000000000000C.quest_desc: ["PRTS entry: Terra Compendium geography/Sargon.\n\nZinecraft: sargon_rocky_desert; sargon_oasis_town; sargon_golden_bazaar and sargon_long_spring_well."]
	quest.500000000000000D.title: "Sami"
	quest.500000000000000D.quest_subtitle: "Nation source and snow-priest architecture"
	quest.500000000000000D.quest_desc: ["PRTS entry: Terra Compendium geography/Sami.\n\nZinecraft: sami_frozen_forest; sami_snowpriest_village; sami_cyclops_altar and sami_snowpriest_lodge."]
	quest.500000000000000E.title: "Victoria"
	quest.500000000000000E.quest_subtitle: "Nation source and industrial architecture"
	quest.500000000000000E.quest_desc: ["PRTS entry: Terra Compendium geography/Victoria.\n\nZinecraft: victoria_misty_highlands; victoria_industrial_borough; victoria_defence_cannon and victoria_steam_station."]
	quest.500000000000000F.title: "Ursus"
	quest.500000000000000F.quest_subtitle: "Nation source and northern architecture"
	quest.500000000000000F.quest_desc: ["PRTS entry: Terra Compendium geography/Ursus.\n\nZinecraft: ursus_frozen_steppe; ursus_northern_town; ursus_sarcophagus_station and ursus_northern_mine_tower."]
	quest.5000000000000010.title: "Kjerag"
	quest.5000000000000010.quest_subtitle: "Snow-realm source and Karlan architecture"
	quest.5000000000000010.quest_desc: ["PRTS entry: Terra Compendium geography/Kjerag.\n\nZinecraft: kjerag_snowy_peaks; kjerag_mountain_village; kjerag_karlan_monastery and kjerag_sacred_plaza."]
	quest.5000000000000011.title: "Siracusa"
	quest.5000000000000011.quest_subtitle: "Nation source and family architecture"
	quest.5000000000000011.quest_desc: ["PRTS entry: Siracusa.\n\nZinecraft: siracusa_rainy_woodland; siracusa_family_town; siracusa_family_court and siracusa_family_theatre."]
	quest.5000000000000012.title: "Yan"
	quest.5000000000000012.quest_subtitle: "Nation source and Shangshu/Yumen architecture"
	quest.5000000000000012.quest_desc: ["PRTS entry: Terra Compendium geography/Yan.\n\nZinecraft: yan_mountain_grove; yan_shangshu_town; yan_yumen_beacon and yan_shangshu_pavilion."]
	quest.5000000000000013.title: "Iberia"
	quest.5000000000000013.quest_subtitle: "Nation source and coastal architecture"
	quest.5000000000000013.quest_desc: ["PRTS entry: Terra Compendium geography/Iberia.\n\nZinecraft: iberia_salt_delta; iberia_coastal_town; iberia_eye_lighthouse and iberia_saltwind_chapel."]

	chapter_group.444556454C4F5047.title: "Development and Mods"
	chapter.4445564D4F445343.title: "Development Mod Guide"
	quest.6000000000000000.title: "Zinecraft Development Environment"
	quest.6000000000000000.quest_subtitle: "Required, transitive, and development-only mods"
	quest.6000000000000000.quest_desc: ["This chapter lists the primary mods loaded by the current Gradle development runtime. Required dependencies provide gameplay and data; transitive dependencies arrive through those mods; development helpers are present in runClient but are not bundled into the Zinecraft JAR."]
	task.6100000000000000.title: "I understand the dependency categories"
	quest.6000000000000001.title: "Platform and World Generation"
	quest.6000000000000001.quest_desc: ["Minecraft 1.21.1; NeoForge 21.1.244; TerraBlender 4.1.0.8. NeoForge supplies the mod platform, while TerraBlender supports biome and world-generation integration."]
	quest.6000000000000002.title: "Create Ecosystem"
	quest.6000000000000002.quest_desc: ["Create 6.0.10, Ponder 1.0.82, Flywheel 1.0.6, and Registrate 1.3.0+67. Create supplies kinetic content; Ponder handles tutorial scenes; Flywheel and Registrate support rendering and registration."]
	quest.6000000000000003.title: "Quest System"
	quest.6000000000000003.quest_desc: ["FTB Quests 2101.1.27, with FTB Library and FTB Teams supplying UI, data, and team progression. Zinecraft installs bundled quest templates under config/ftbquests/quests."]
	quest.6000000000000004.title: "Accessories and Collectibles"
	quest.6000000000000004.quest_desc: ["Curios 9.5.1+1.21.1 supplies accessory capability. Zinecraft Integrated Strategies collectibles use the relic slot, currently configured with twenty player slots."]
	quest.6000000000000005.title: "Configuration and Libraries"
	quest.6000000000000005.quest_desc: ["Cloth Config 15.0.140 supplies configuration UI support. Architectury and Common Networking are loaded transitively. The project source and runtime now use Java throughout, without an additional language runtime."]
	quest.6000000000000006.title: "Development-only Helpers"
	quest.6000000000000006.quest_desc: ["JEI 19.27.0.340, Just Enough Resources 1.6.0.17, AppleSkin 3.0.9, Jade 15.10.5, Just Enough Characters 4.5.22, JourneyMap 6.0.1, Nature's Compass 3.4.0, and Explorer's Compass 3.4.0. They support item/resource lookup, food information, block inspection, Pinyin search, map-based testing, and biome/structure location."]
}
