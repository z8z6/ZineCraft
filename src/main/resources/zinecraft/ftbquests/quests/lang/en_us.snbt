	quest.C300000000000077.quest_subtitle: "Offense"
	quest.C300000000000077.quest_desc: ["Original effect: Units summoned by Supporter Operators have +50% ATK.", "Description: 'Um, I can understand the derivatives of combining mechanics with Originium Arts, but there might be something else...'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
