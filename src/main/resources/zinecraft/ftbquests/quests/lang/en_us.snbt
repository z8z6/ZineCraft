	quest.C3000000000002C4.title: "Support New Doctrine"
	quest.C3000000000002C4.quest_subtitle: "Defense"
	quest.C3000000000002C4.quest_desc: ["Original effect: 立即进阶一个【辅助】干员（不消耗希望），并使其：攻击范围内的敌人防御力和法术抗性-40%", "Description: 别试图为辅助干员指定行动点位，他们自己的策略往往比制定好的计划更有效。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002C4.title: "Obtain Support New Doctrine"
	quest.C3000000000002D5.title: "Traveling Companion"
	quest.C3000000000002D5.quest_subtitle: "Defense"
	quest.C3000000000002D5.quest_desc: ["Original effect: 应急助力节点中招募所需源石锭-50%，应急干员的生命值、攻击力和防御力+40%", "Description: “现在你是我们的一员了，让我们熟悉彼此的气味。”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D5.title: "Obtain Traveling Companion"
	quest.C3000000000002D7.title: "Hunter S Mark"
	quest.C3000000000002D7.quest_subtitle: "Defense"
	quest.C3000000000002D7.quest_desc: ["Original effect: 猎犬proto的攻击力-50%；每拥有1层【探测先锋】，我方法术抗性+10", "Description: 这并非兽主的恐惧，只是祂施舍给你的片刻喘息。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D7.title: "Obtain Hunter S Mark"
	quest.C100000000000004.title: "Survival"
	quest.C100000000000004.quest_subtitle: "Contains 45 collectibles."
	quest.C100000000000004.quest_desc: ["Primarily affects maximum health, objective life, or dodge.", "Contains 45 collectibles."]
	task.C200000000000004.title: "Read category guide"
	quest.C300000000000001.title: "Hot Water Kettle"
	quest.C300000000000001.quest_subtitle: "Survival"
	quest.C300000000000001.quest_desc: ["Original effect: Immediately gain +2 Life Points and +1 Hope", "Description: Some people often use the hot water kettle in the Rhodes Island Office to cook instant noodles in the middle of the night. That's not a very healthy lifestyle...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000001.title: "Obtain Hot Water Kettle"
	quest.C300000000000002.title: "Special Suppressor"
	quest.C300000000000002.quest_subtitle: "Survival"
	quest.C300000000000002.quest_desc: ["Original effect: Immediately gain +6 Life Points.", "Description: An enhanced suppressor developed by Rhodes Island that can better keep the infected from losing control of their Originium Arts.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000002.title: "Obtain Special Suppressor"
	quest.C300000000000003.title: "Stone Gargoyle"
	quest.C300000000000003.quest_subtitle: "Survival"
	quest.C300000000000003.quest_desc: ["Original effect: Immediately gain +6 Life Points.", "Description: A palm-sized sculpture. Supposedly they are handmade gifts given out by the Gargoyles as a sign of friendship.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000003.title: "Obtain Stone Gargoyle"
	quest.C300000000000004.title: "Vampires Bed"
	quest.C300000000000004.quest_subtitle: "Survival"
	quest.C300000000000004.quest_desc: ["Original effect: Immediately gain +8 Life Points.", "Description: A lavish-looking coffin that matches the castle's aesthetics well. However, Warfarin says this is merely a stereotype.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000004.title: "Obtain Vampires Bed"
	quest.C300000000000005.title: "Proof Of Longevity"
	quest.C300000000000005.quest_subtitle: "Survival"
	quest.C300000000000005.quest_desc: ["Original effect: Immediately gain +10 Life Points.", "Description: A tree branch that has withered and flourished. \nWhen it is withered, it grows anew. When it is thriving in its fullest, it fades away yet again.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000005.title: "Obtain Proof Of Longevity"
	quest.C30000000000004C.title: "Designers Ruler"
	quest.C30000000000004C.quest_subtitle: "Survival"
	quest.C30000000000004C.quest_desc: ["Original effect: All friendly units have +15% Physical Dodge", "Description: Carefully measured with data and experience, those who wear this armor are known to be several magnitudes luckier.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000004C.title: "Obtain Designers Ruler"
	quest.C30000000000004D.title: "Arts Killer"
	quest.C30000000000004D.quest_subtitle: "Survival"
	quest.C30000000000004D.quest_desc: ["Original effect: All friendly units have +15% Arts Dodge", "Description: Considering how Originium Arts and music go hand in hand in Leithanien, it's quite amazing someone came up with the bright idea of combating Arts with noise like this.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000004D.title: "Obtain Arts Killer"
	quest.C30000000000004E.title: "Dancers Bracelets"
	quest.C30000000000004E.quest_subtitle: "Survival"
	quest.C30000000000004E.quest_desc: ["Original effect: All friendly units have +10% Physical and Arts Dodge", "Description: The audience breaks into applause as the well-trained dancers waltz around the traps on stage. None of them are aware of the brushes with death the performers have just been through.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000004E.title: "Obtain Dancers Bracelets"
	quest.C300000000000093.title: "Durin Overground"
	quest.C300000000000093.quest_subtitle: "Survival"
	quest.C300000000000093.quest_desc: ["Original effect: Gain 1 Temporary Life Point at the beginning of each battle.", "Description: In this expedition account, we get a glimpse of how those who live underground see those who live on the surface.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000093.title: "Obtain Durin Overground"
	quest.C300000000000094.title: "Gaulish Toponym Origins"
	quest.C300000000000094.quest_subtitle: "Survival"
	quest.C300000000000094.quest_desc: ["Original effect: Gain 2 Temporary Life Points at the beginning of each battle.", "Description: A book of historical place names that Mint dug out of the Doctor's office. Calais-Blason is mentioned in the book.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000094.title: "Obtain Gaulish Toponym Origins"
	quest.C3000000000000AE.title: "End Of Times"
	quest.C3000000000000AE.quest_subtitle: "Survival"
	quest.C3000000000000AE.quest_desc: ["Original effect: For one time only during any battle prior to the final battle of the area, gain 1 Life Point and continue onto the next step instead of concluding the exploration upon mission failure", "Description: As long as a new cycle has not been reached, there is still time to fix your mistakes.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000AE.title: "Obtain End Of Times"
	quest.C3000000000000B5.title: "Leithanien Sceptre"
	quest.C3000000000000B5.quest_subtitle: "Survival"
	quest.C3000000000000B5.quest_desc: ["Original effect: All enemy units have +30% ATK, DEF, and Max HP; Entering a new node decreases Life Point by 1 (cannot be reduced beneath 1 this way)", "Description: It was not long ago that the Witch King's scepter flowed with daylight and the night sky.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B5.title: "Obtain Leithanien Sceptre"
	quest.C3000000000000CF.title: "Beauty And Ugliness In The Age Of Terra"
	quest.C3000000000000CF.quest_subtitle: "Survival"
	quest.C3000000000000CF.quest_desc: ["Original effect: For one time only during any battle prior to the final battle of the area, gain 10 Life Points and continue onto the next step instead of concluding the exploration upon mission failure", "Description: A legendary book published in Victoria fifteen years ago. The book describes the author's appreciation of aesthetics in simple terms, and it contains a comprehensive record of literary, artistic and musical knowledge and history. The book covers both the past and present and is an easy read, with many honoring it as the 'great art encyclopedia of our generation.' Yet it is rumored that the book's author was the leader of a certain small troupe and was murdered a few years ago by a hitman codenamed 'Blood Diamond.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000CF.title: "Obtain Beauty And Ugliness In The Age Of Terra"
	quest.C3000000000000DA.title: "Empresses Wish"
	quest.C3000000000000DA.quest_subtitle: "Survival"
	quest.C3000000000000DA.quest_desc: ["Original effect: All allied units have +15% Physical and Arts Dodge", "Description: The Twin Empresses tower above. When dawn and dusk are one, there shall be no more dissent in Leithanien.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000DA.title: "Obtain Empresses Wish"
	quest.C3000000000000FB.title: "Pete S Fruit Medley"
	quest.C3000000000000FB.quest_subtitle: "Survival"
	quest.C3000000000000FB.quest_desc: ["Original effect: 【结构化】可携带干员+3，所有我方单位的攻击力、防御力和生命值+3%\n【半结构化】可携带干员+3，所有我方单位的攻击力、防御力和生命值+4%\n【非结构化】可携带干员+3，所有我方单位的攻击力、防御力和生命值+5%\n【混沌化】可携带干员+3，所有我方单位的攻击力、防御力和生命值+7%", "Description: 皮特牌什锦水果糖，以丰富的口味和超高性价比在糖果市场上与约翰老妈糖果系列相抗衡。缪尔赛思的最爱。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000FB.title: "Obtain Pete S Fruit Medley"
	quest.C300000000000110.title: "King S Buckler"
	quest.C300000000000110.quest_subtitle: "Survival"
	quest.C300000000000110.quest_desc: ["Original effect: When Life Point is at 1, all Operators have +2 Block", "Description: Keep your eyes straight ahead, and let your stalwart heart resist all hardship.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000110.title: "Obtain King S Buckler"
	quest.C300000000000122.title: "Divine Conch"
	quest.C300000000000122.quest_subtitle: "Survival"
	quest.C300000000000122.quest_desc: ["Original effect: 【结构化】可同时部署人数+1，所有我方单位的生命值+4%\n【半结构化】可同时部署人数+1，所有我方单位的生命值+5%\n【非结构化】可同时部署人数+1，所有我方单位的生命值+6%\n【混沌化】可同时部署人数+1，所有我方单位的生命值+8%", "Description: 吹响它，那些你不曾见过、甚至不曾听闻的神明将回应你的声音。其实就是一个空心海螺。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000122.title: "Obtain Divine Conch"
	quest.C300000000000124.title: "Church Relief Meal Voucher"
	quest.C300000000000124.quest_subtitle: "Survival"
	quest.C300000000000124.quest_desc: ["Original effect: 【结构化】可同时部署人数+2，所有我方单位的生命值+6%\n【半结构化】可同时部署人数+2，所有我方单位的生命值+7%\n【非结构化】可同时部署人数+2，所有我方单位的生命值+8%\n【混沌化】可同时部署人数+2，所有我方单位的生命值+10%", "Description: 在没落的伊比利亚沿海城镇，某些教堂会定期提供救济餐，信徒们凭券领取。至于救济餐券的发放标准，是个秘密。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000124.title: "Obtain Church Relief Meal Voucher"
	quest.C30000000000013C.title: "Leviathan S Anabolism"
	quest.C30000000000013C.quest_subtitle: "Survival"
	quest.C30000000000013C.quest_desc: ["Original effect: All enemies gain +25% HP", "Description: Slowly did He fall into the deepest depths of the ocean. His blood, flesh, skin, and bones separated and dissolved—they were swept up by the sea's currents, absorbed by all life, and became sustenance for the propagation of the entire ocean.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000013C.title: "Obtain Leviathan S Anabolism"
	quest.C300000000000158.title: "Underground Scorch"
	quest.C300000000000158.quest_subtitle: "Survival"
	quest.C300000000000158.quest_desc: ["Original effect: At the end of operation, if no Life Point is lost, gain +6 Light", "Description: The people of the sea are unconcerned with what happens on land, and thus will never understand the warmth of the sun which reaches into the soul.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000158.title: "Obtain Underground Scorch"
	quest.C300000000000159.title: "Great Machinations"
	quest.C300000000000159.quest_subtitle: "Survival"
	quest.C300000000000159.quest_desc: ["Original effect: At the end of operation, if no Life Point is lost, gain +9 Light", "Description: 'Do not envy the sun on the surface. We can do better.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000159.title: "Obtain Great Machinations"
	quest.C30000000000015C.title: "King S Crystal"
	quest.C30000000000015C.quest_subtitle: "Survival"
	quest.C30000000000015C.quest_desc: ["Original effect: At the end of battle, -2 Life Points (will not go lower than 1), +1 Hope, +5 Originium Ingots", "Description: The Iberians' contact with the Seaborn goes back further than they can imagine, but they did not know what the Seaborn were back then.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000015C.title: "Obtain King S Crystal"
	quest.C30000000000016A.title: "Tranquil Spring Current"
	quest.C30000000000016A.quest_subtitle: "Survival"
	quest.C30000000000016A.quest_desc: ["Original effect: Gain +2 Anti-Interference Index, +3 Max Life Points, and +3 Hope", "Description: After escaping a siege of wind and snow by following the sound of water drops, this specimen has become a protective charm for the research team.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000016A.title: "Obtain Tranquil Spring Current"
	quest.C300000000000183.title: "Hand Of Outburst"
	quest.C300000000000183.quest_subtitle: "Survival"
	quest.C300000000000183.quest_desc: ["Original effect: Heavyshooter, Deadeye, and Besieger Operators deal increasing damage to enemies as the target's HP decreases, up to a maximum of 50%, and instantly defeat enemies below 20% HP", "Description: Smash open every single crack, or perhaps make the very first.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000183.title: "Obtain Hand Of Outburst"
	quest.C300000000000186.title: "Warning Fence"
	quest.C300000000000186.quest_subtitle: "Survival"
	quest.C300000000000186.quest_desc: ["Original effect: -2 Collapse value, +2 Max Life Points", "Description: The colorful decorations stand out in the snow, letting people imagine them clearly even in their dreams. The territory has no borders, but the roaming mind needs to know where fear is lurking.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000186.title: "Obtain Warning Fence"
	quest.C3000000000001A5.title: "Collapsal Seed"
	quest.C3000000000001A5.quest_subtitle: "Survival"
	quest.C3000000000001A5.quest_desc: ["Original effect: All friendly units have -15% ATK and -15% HP", "Description: Traces of Collapse remain here, refusing to be removed.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A5.title: "Obtain Collapsal Seed"
	quest.C3000000000001A7.title: "Profound Scorchmarks"
	quest.C3000000000001A7.quest_subtitle: "Survival"
	quest.C3000000000001A7.quest_desc: ["Original effect: -12 Max Life Point", "Description: The boundless energy burned away their body and soul, and they will never recover.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A7.title: "Obtain Profound Scorchmarks"
	quest.C3000000000001A8.title: "Hand Of Unyielding"
	quest.C3000000000001A8.quest_subtitle: "Survival"
	quest.C3000000000001A8.quest_desc: ["Original effect: Artificers, Merchants, and Geeks will grant 3 temporary Life Points after being deployed on the field for 30 seconds (Each Operator can only trigger this once per battle)", "Description: Nice to have, even nicer when in danger.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A8.title: "Obtain Hand Of Unyielding"
	quest.C3000000000001BA.title: "Black Hole Protocol"
	quest.C3000000000001BA.quest_subtitle: "Survival"
	quest.C3000000000001BA.quest_desc: ["Original effect: When DP is maxed out, all Operators gain Max HP +150%", "Description: This collaborative operation is unprecedented in the history books. The nations of Terra have invested a great deal of resources into the megastructure in the far north, and the NGO Rhodes Island has become the actual managing party in order to prevent the results from being concealed or tampered with.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001BA.title: "Obtain Black Hole Protocol"
	quest.C3000000000001D2.title: "Bridge Of Knowledge"
	quest.C3000000000001D2.quest_subtitle: "Survival"
	quest.C3000000000001D2.quest_desc: ["Original effect: Every Inspirer used grants all allied units +5% HP (Stacks up to 10 times)", "Description: It is said you need only hold it, and its vibrations will lead you to the Liches' Temple of Knowledge. Is that really true? It stays silent. Those who fail to question it will indeed never reach those doors.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D2.title: "Obtain Bridge Of Knowledge"
	quest.C3000000000001D3.title: "Mercenary S Accessory"
	quest.C3000000000001D3.quest_subtitle: "Survival"
	quest.C3000000000001D3.quest_desc: ["Original effect: Grants a random Operator +5% ATK, DEF, and Max HP, plus an additional +5% after each perfectly cleared battle (Stacks up to 10 times)", "Description: A small price to pay for pursuing perfection. Small because it hasn't really affected his reading and writing.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D3.title: "Obtain Mercenary S Accessory"
	quest.C3000000000001D4.title: "Children Of The Walls"
	quest.C3000000000001D4.quest_subtitle: "Survival"
	quest.C3000000000001D4.quest_desc: ["Original effect: Operators deployed on the 8 tiles surrounding the Objective Point gain +2 Block and +50% Max HP", "Description: The Children of Soil and Stone carefully taught the ancient city of Kazdel how to toughen itself and protect its people behind its walls. With the advent of a protracted peace, it was broken into many little pieces and turned into amulets for adventurers heading into unexplored lands.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D4.title: "Obtain Children Of The Walls"
	quest.C3000000000001DD.title: "Commander S Portrait"
	quest.C3000000000001DD.quest_subtitle: "Survival"
	quest.C3000000000001DD.quest_desc: ["Original effect: All allied units gain +10% ATK and Max HP, and an additional +20% in Dreadful Foe nodes", "Description: The portrait depicts a remarkable individual who made distrustful kings shake hands and soldiers who could not understand each other stand shoulder to shoulder. If she were alive today, Terra's unification might seem surprisingly plausible.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001DD.title: "Obtain Commander S Portrait"
	quest.C3000000000001EF.title: "Suspicion Mystery"
	quest.C3000000000001EF.quest_subtitle: "Survival"
	quest.C3000000000001EF.quest_desc: ["Original effect: Earn double the Originium Ingots post battle, but also lose double the Life Points; only active in Bizarre Fragments", "Description: 'Duq'hraqaam openly questioned the Farchaser's caution towards the ruins and led his descendants underground. Prophecy foretold his demise by an 'ancient wound that refuses to heal' and that his descendants would call themselves 'Durin.' Their test tunnels would reach deep into the land's core, but no living soul would ever see them again.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001EF.title: "Obtain Suspicion Mystery"
	quest.C3000000000001FA.title: "Anasa S Karma"
	quest.C3000000000001FA.quest_subtitle: "Survival"
	quest.C3000000000001FA.quest_desc: ["Original effect: Leader and Elite enemies have +50% max HP; Dreadful Foes in Border of Truth will be more difficult; leads expedition in a different direction", "Description: His nature has changed and his sword lies shattered, yet the crystals on his body are an eternal reminder that his spirit still needs honing.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FA.title: "Obtain Anasa S Karma"
	quest.C300000000000202.title: "Little Cube"
	quest.C300000000000202.quest_subtitle: "Survival"
	quest.C300000000000202.quest_desc: ["Original effect: All Allied units gain +10% Max HP, and an additional +80% in Face-Off nodes", "Description: The Liches' vessel, capable of transcending time and space, proves even more durable in fantasies. Ermengarde spent a lot of time fixing it up.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000202.title: "Obtain Little Cube"
	quest.C300000000000219.title: "King Of Sarkaz S Vessel"
	quest.C300000000000219.quest_subtitle: "Survival"
	quest.C300000000000219.quest_desc: ["Original effect: All Operators gain +80% Max HP when Life Points are full, increased to 200% if you have collected 3 or more King of Sarkaz's Collectibles", "Description: For those in this position, prosperity is but an illusion.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000219.title: "Obtain King Of Sarkaz S Vessel"
	quest.C300000000000233.title: "Delicate Bamboo"
	quest.C300000000000233.quest_subtitle: "Survival"
	quest.C300000000000233.quest_desc: ["Original effect: Operators on Vagary Tiles gain +10% HP (Can be upgraded in Leisure, to a max of 10 levels)", "Description: A young bamboo shoot from Shu's treasured field. An effect sprouts with no cause, and grows a section every time the cycle repeats, until it has ten sections connected to one another, from start to end.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000233.title: "Obtain Delicate Bamboo"
	quest.C300000000000239.title: "Moon Lady Mask"
	quest.C300000000000239.quest_subtitle: "Survival"
	quest.C300000000000239.quest_desc: ["Original effect: For every enemy blocked, Operators gain 10% Physical and Arts Dodge (Stacks up to 5 times)", "Description: The mask of a legendary Yanese character. The story of how she shed tears like a river in the search for her husband and flying to the moons has passed down the generations to the present day.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000239.title: "Obtain Moon Lady Mask"
	quest.C300000000000263.title: "Ceaseless"
	quest.C300000000000263.quest_subtitle: "Survival"
	quest.C300000000000263.quest_desc: ["Original effect: All enemies ATK +30%; [Candleguests] and their summons -10% ATK and HP when fighting outside Sui's Remnant Consciousness, plus extra -10% upon entering a new floor, and extra -50% when entering 'Laiqu Point'", "Description: Strange object created when depicting the bestial Sui. Sui will not allow others to peruse Its memories and thoughts, even if It has yet to awaken. The extension of sensation staunchly obstructs all change.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000263.title: "Obtain Ceaseless"
	quest.C300000000000264.title: "Gallopbeast Chariot"
	quest.C300000000000264.quest_subtitle: "Survival"
	quest.C300000000000264.quest_desc: ["Original effect: +30 cost limit, when DP is at 99 or higher, all units gain +50% HP and +1 Block", "Description: A box with two wheels pulled by four gallopbeasts is surely faster than mortals walking on their own two legs—Is that so? Just look at the Khagan's Nightzmora troops. A chariot traveling at full speed still cannot keep up with how fast Terra develops.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000264.title: "Obtain Gallopbeast Chariot"
	quest.C30000000000027C.title: "Court Striking Block"
	quest.C30000000000027C.quest_subtitle: "Survival"
	quest.C30000000000027C.quest_desc: ["Original effect: Allied Operators +10% HP for each Balance Coin in Coffer (max +150%)", "Description: The brother of a certain judge made this piece of wood for her so that she would have something to smash when annoyed by obstinate criminals, allowing her to vent her frustration while also intimidating the courtroom.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000027C.title: "Obtain Court Striking Block"
	quest.C300000000000281.title: "Heaven Axe"
	quest.C300000000000281.quest_subtitle: "Survival"
	quest.C300000000000281.quest_desc: ["Original effect: Operators +60% ATK and HP, but -30% ATK and HP whenever you enter Sui's Remnant Consciousness (Stacks 2x)", "Description: A lumberjack who lost his way in the Garden of Grotesqueries managed to cut a way through to Jianzi Shrine with nothing more than a blunt axe and sheer force of will. This old fellow, who hadn't the faintest idea what consciousness of the Sui even was, was later 'hired' as a staff member, and Yi added the axe he no longer needed to his collection.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000281.title: "Obtain Heaven Axe"
	quest.C300000000000289.title: "Coin Platter"
	quest.C300000000000289.quest_subtitle: "Survival"
	quest.C300000000000289.quest_desc: ["Original effect: +1 Hope on Flower Coin toss; +4 Ingots on Balance Coin toss; +1 Life Point on Risk Coin toss", "Description: If you are going to toss a coin, it had better make a sound. Created for such a purpose, this plate has somehow become one of the most discerning coin connoisseurs in the land.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000289.title: "Obtain Coin Platter"
	quest.C3000000000002B2.title: "Broken Halberd Avoid The Edge"
	quest.C3000000000002B2.quest_subtitle: "Survival"
	quest.C3000000000002B2.quest_desc: ["Original effect: 近卫干员受到攻击范围外敌人的攻击时，有75%概率闪避", "Description: 退避并非怯战，而是为了下一次攻击。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B2.title: "Obtain Broken Halberd Avoid The Edge"
	quest.C100000000000005.title: "Hybrid Combat"
	quest.C100000000000005.quest_subtitle: "Contains 62 collectibles."
	quest.C100000000000005.quest_desc: ["Affects two or more combat attributes at once.", "Contains 62 collectibles."]
	task.C200000000000005.title: "Read category guide"
	quest.C300000000000061.title: "Blunt Claws Mastery"
	quest.C300000000000061.quest_subtitle: "Hybrid Combat"
	quest.C300000000000061.quest_desc: ["Original effect: Vanguard Operators have +50% ATK and DEF", "Description: 'When the darkly-clad enemies rushed towards me, there were only four words on my mind — they are done for.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000061.title: "Obtain Blunt Claws Mastery"
	quest.C30000000000007A.title: "Stalwart Aid Counter Arts"
	quest.C30000000000007A.quest_subtitle: "Hybrid Combat"
	quest.C30000000000007A.quest_desc: ["Original effect: Enemies within the attack range of Supporter Operators have -20% DEF and -20% RES.", "Description: There are many ways to weaken an enemy's defensive capabilities: positional devices, armor-stripping Arts, marking weak points, and... giving them a stomachache.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000007A.title: "Obtain Stalwart Aid Counter Arts"
	quest.C300000000000082.title: "Rusted Blade Isolation"
	quest.C300000000000082.quest_subtitle: "Hybrid Combat"
	quest.C300000000000082.quest_desc: ["Original effect: Specialist Operators have +40% ATK and DEF", "Description: The director of S.W.E.E.P. does not have any mission participation records. *None*.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000082.title: "Obtain Rusted Blade Isolation"
	quest.C3000000000000A1.title: "Unleashings"
	quest.C3000000000000A1.quest_subtitle: "Hybrid Combat"
	quest.C3000000000000A1.quest_desc: ["Original effect: All Operators recover 1 SP every time they take damage or Elemental Injury", "Description: After several attempts by Touch, nature briefly opens up to you.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000A1.title: "Obtain Unleashings"
	quest.C3000000000000B6.title: "Leithanien Sceptre Reforged"
	quest.C3000000000000B6.quest_subtitle: "Hybrid Combat"
	quest.C3000000000000B6.quest_desc: ["Original effect: All enemy units have +35% ATK, DEF, and Max HP; Entering a new node decreases Life Point by 1 (cannot be reduced beneath 1 this way); When Life Point is below 3, all units have DP Cost + 2 and SP recovery rate -20%", "Description: It was not long ago that the Witch King's scepter flowed with daylight and the night sky.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000B6.title: "Obtain Leithanien Sceptre Reforged"
	quest.C3000000000000E1.title: "Nachzehrers Cane"
	quest.C3000000000000E1.quest_subtitle: "Hybrid Combat"
	quest.C3000000000000E1.quest_desc: ["Original effect: When an allied unit is overhealed, nearby enemies take Arts damage equal to the overheal amount", "Description: Nachzehrer devours life and uses it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E1.title: "Obtain Nachzehrers Cane"
	quest.C3000000000000EF.title: "Kings New Lance"
	quest.C3000000000000EF.quest_subtitle: "Hybrid Combat"
	quest.C3000000000000EF.quest_desc: ["Original effect: When Life Point is 1, all friendly units have +50 ASPD", "Description: Beautiful wishes made in dire straits can bring hope, even if they are not necessarily the truth.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000EF.title: "Obtain Kings New Lance"
	quest.C300000000000106.title: "Distant Home S Guide"
	quest.C300000000000106.quest_subtitle: "Hybrid Combat"
	quest.C300000000000106.quest_desc: ["Original effect: Designates one deployable tile at the beginning of battle; friendly units deployed on that tile will recover 1 SP and 3% Max HP per second", "Description: This ancient ring is actually said to be a special navigation device, used to find emergency supplies that the Ægir once secretly stashed in various spots across the ocean. Follow the ocean's currents, be guided by wind; your homeland will always continue to bestow gifts upon you.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000106.title: "Obtain Distant Home S Guide"
	quest.C30000000000010A.title: "Glorious Kazimierz"
	quest.C30000000000010A.quest_subtitle: "Hybrid Combat"
	quest.C30000000000010A.quest_desc: ["Original effect: Operators gain +70% ATK for 6 seconds after dodging", "Description: A Kazimierzian best-seller that adapts the deeds of the arena's brightest-shining knights into a novel. Nearl, who was exiled but returned to reclaim her laurels, occupies a considerable portion of its pages.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000010A.title: "Obtain Glorious Kazimierz"
	quest.C30000000000010B.title: "The Return"
	quest.C30000000000010B.quest_subtitle: "Hybrid Combat"
	quest.C30000000000010B.quest_desc: ["Original effect: Operators gain +130% ATK for 6 seconds after dodging", "Description: This Kazimierzian best-seller is said to be a collective creation by fans. 'Nearl' has already become an amalgamation of many ideals and fantasies. 'For her, exile was not an escape. She came back, and stood alone against the era's torrents.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000010B.title: "Obtain The Return"
	quest.C300000000000111.title: "King S Staff"
	quest.C300000000000111.quest_subtitle: "Hybrid Combat"
	quest.C300000000000111.quest_desc: ["Original effect: When Life Point is at 1, all Operators recover an additional 1 SP every 2 seconds", "Description: Let go of worthless pomp and treat others with kindness. They will no doubt return in kind.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000111.title: "Obtain King S Staff"
	quest.C300000000000112.title: "King S Crown"
	quest.C300000000000112.quest_subtitle: "Hybrid Combat"
	quest.C300000000000112.quest_desc: ["Original effect: When Life Point is at 1, all friendly units have +50% ATK, increased to +150% ATK if you have collected 3 or more King's Collectibles", "Description: O Nameless King, may you continue to bless Iberia, even should your kingdom fall to ruin.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000112.title: "Obtain King S Crown"
	quest.C300000000000114.title: "Derivative Terminal Supercharged Mod"
	quest.C300000000000114.quest_subtitle: "Hybrid Combat"
	quest.C300000000000114.quest_desc: ["Original effect: Summons have +30% HP, +30% ATK, and +30 ASPD", "Description: A product of Raythean Industries. The latest remote-control operation terminal, capable of connecting to the signals of most existing remotely-operated units on its own, complete with customization options and performance upgrades. Not yet available on the market.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000114.title: "Obtain Derivative Terminal Supercharged Mod"
	quest.C300000000000125.title: "Acahuallan Bowl"
	quest.C300000000000125.quest_subtitle: "Hybrid Combat"
	quest.C300000000000125.quest_desc: ["Original effect: Restore 4 Life Point, +2 Objective Shield", "Description: Fruit is one of the locals' staples, often eaten fresh right off the tree.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000125.title: "Obtain Acahuallan Bowl"
	quest.C300000000000126.title: "Three Dimensional Art Display"
	quest.C300000000000126.quest_subtitle: "Hybrid Combat"
	quest.C300000000000126.quest_desc: ["Original effect: Restore 7 Life Point, restore an additional 1 Life Point after each battle", "Description: The impression that Rhine Lab often gives is akin to this work of art: inscrutable, multi-faceted, impossible to sift fact from fiction.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000126.title: "Obtain Three Dimensional Art Display"
	quest.C30000000000012E.title: "Embedded Armor Plate"
	quest.C30000000000012E.quest_subtitle: "Hybrid Combat"
	quest.C30000000000012E.quest_desc: ["Original effect: -2 Max Life Point, +8 Objective Shield", "Description: 'You don't understand a thing, test subject. Compared to what those monsters of Ursus suffered, a measly plate of armor embedded into your body isn't even worth mentioning.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000012E.title: "Obtain Embedded Armor Plate"
	quest.C300000000000130.title: "King S Fellowship"
	quest.C300000000000130.quest_subtitle: "Hybrid Combat"
	quest.C300000000000130.quest_desc: ["Original effect: +2 Objective Shield, coverts all Life Point into an equivalent amount of Objective Shield (Cannot be reduced below 1 by this effect)", "Description: The Cultists of the Deep did not achieve success overnight; they lingered at the junction between land and sea for ages, preparing for the calamity that would come to be known as the Profound Silence.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000130.title: "Obtain King S Fellowship"
	quest.C300000000000154.title: "Caerula Arbor"
	quest.C300000000000154.quest_subtitle: "Hybrid Combat"
	quest.C300000000000154.quest_desc: ["Original effect: Enemy ASPD +15; at the end of operation, if no Life Point is lost, gain +15 Light", "Description: Through His body, Mizuki becomes one of Them. His consciousness is long gone, but His cells live on. The magma is His food, and the great tree grows towards the core of the planet. If left unchecked, He will become reborn in the planet's core, and invite Terra into we many.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000154.title: "Obtain Caerula Arbor"
	quest.C30000000000016B.title: "Devotion"
	quest.C30000000000016B.quest_subtitle: "Hybrid Combat"
	quest.C30000000000016B.quest_desc: ["Original effect: Ranged Operators deal 150 Arts damage to a random enemy within attack range with every attack or heal", "Description: Since antiquity, this tribe has believed that they hold a truth about Sami: Everything originally had a voice, until 'It' spoke for all of them.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000016B.title: "Obtain Devotion"
	quest.C30000000000016D.title: "Frozen Husk"
	quest.C30000000000016D.quest_subtitle: "Hybrid Combat"
	quest.C30000000000016D.quest_desc: ["Original effect: Melee Operators gain ASPD +40 for 5 seconds after taking damage", "Description: The warriors of Sami stationed in the Fjal Vetrtonn are often inspired by an illusion: As their life flows toward the earth, their originally frozen bodies become lighter and lighter.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000016D.title: "Obtain Frozen Husk"
	quest.C30000000000016E.title: "Ring Of Thorns"
	quest.C30000000000016E.quest_subtitle: "Hybrid Combat"
	quest.C30000000000016E.quest_desc: ["Original effect: When Melee Operators are healed, they and Operators in the adjacent 4 tiles will recover 1 SP", "Description: You were able to steady yourself while in a distorted fear. There is blood left on the thorns, and you don't know if it was you or the Snowpriest who was pricked by them. They will use whatever means they have, without batting an eye.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000016E.title: "Obtain Ring Of Thorns"
	quest.C300000000000171.title: "Frozen Whetstone"
	quest.C300000000000171.quest_subtitle: "Hybrid Combat"
	quest.C300000000000171.quest_desc: ["Original effect: When a battle begins, the Max HP, ATK, DEF, RES, Block Count, Starting SP, and DP Cost of a random Operator is doubled", "Description: The stone's surface is smooth as ice. The maker asked the mountain cliffs for permission to replicate their overpowering strength in their blade.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000171.title: "Obtain Frozen Whetstone"
	quest.C300000000000176.title: "Frost Buck S Pauldron"
	quest.C300000000000176.quest_subtitle: "Hybrid Combat"
	quest.C300000000000176.quest_desc: ["Original effect: All allied units gain ATK +40% and DEF +40% for 30 seconds when blocking 2 or more enemies", "Description: There are no signs of injuries on his body, only a pair of eyes drained of blood and tears.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000176.title: "Obtain Frost Buck S Pauldron"
	quest.C300000000000177.title: "Snow Doe S Glove"
	quest.C300000000000177.quest_subtitle: "Hybrid Combat"
	quest.C300000000000177.quest_desc: ["Original effect: All allied units gain ASPD +80 and obtain 50% Physical and Arts Dodge for 30 seconds when blocking 3 or more enemies", "Description: She shoots the last three arrows in her quiver at the Frozen Monstrosity, who used them to end her life.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000177.title: "Obtain Snow Doe S Glove"
	quest.C300000000000178.title: "Empty Fowlbeast"
	quest.C300000000000178.quest_subtitle: "Hybrid Combat"
	quest.C300000000000178.quest_desc: ["Original effect: Summons gain Max HP +30%, ATK +30%, and grant ATK +60% to their summoner", "Description: The body is long since gone, but the soul remains in the shell for eternity. The unmelting creatures in the branches and leaves carry icicles as they spread their wings in the forest.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000178.title: "Obtain Empty Fowlbeast"
	quest.C30000000000017F.title: "Iron Guard Consolidation"
	quest.C30000000000017F.quest_subtitle: "Hybrid Combat"
	quest.C30000000000017F.quest_desc: ["Original effect: Defender Operators gain HP +40%, DEF +40%, and RES +20", "Description: No matter how hard fate hits you, just take it in.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000017F.title: "Obtain Iron Guard Consolidation"
	quest.C300000000000189.title: "Ceremony Bell"
	quest.C300000000000189.quest_subtitle: "Hybrid Combat"
	quest.C300000000000189.quest_desc: ["Original effect: Recover 1 Life Point whenever you lose Anti-Interference Index", "Description: Close your eyes. Look inward for all that you crave.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000189.title: "Obtain Ceremony Bell"
	quest.C3000000000001A1.title: "Scarred Amber"
	quest.C3000000000001A1.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001A1.quest_desc: ["Original effect: Uncaps Anti-Interference Index Limit, and every surplus index point will grant all allied units HP +8% and ATK +8%", "Description: The elves have been left so alone on Terra that they embrace the dust with their backs to a foreign land.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A1.title: "Obtain Scarred Amber"
	quest.C3000000000001B9.title: "Expeditioner S Field Pack"
	quest.C3000000000001B9.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001B9.quest_desc: ["Original effect: All Operators gain ATK +60% and Resist for 15 seconds after recovering from a negative status", "Description: They always stuff their backpacks with survival supplies, then press forward with the determination and will to challenge the boundaries of the known.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001B9.title: "Obtain Expeditioner S Field Pack"
	quest.C3000000000001CC.title: "Hand Of Predation"
	quest.C3000000000001CC.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001CC.quest_desc: ["Original effect: Pioneer, Charger, and Tactician Operators gain +10% ATK and DEF on every skill activation (Stacks up to 10 times); If you have Blunt Claws - Predation, also increases their SP regen rate by +0.5/s", "Description: Herds stir, flesh rend asunder.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001CC.title: "Obtain Hand Of Predation"
	quest.C3000000000001D5.title: "King S Armor"
	quest.C3000000000001D5.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001D5.quest_desc: ["Original effect: Shield +3; converts all Life Points into Shield; Life Point -1 and Shield +1 after each battle", "Description: There used to be many golden display cases placed before the palace gates and in the square, displaying all sorts of treasures to admire. But now, it hurts just to think about such sights.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D5.title: "Obtain King S Armor"
	quest.C3000000000001D6.title: "King S Legacy"
	quest.C3000000000001D6.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001D6.quest_desc: ["Original effect: When Life Point is at 1, all Operators recover an additional 1 SP and 3% of Max HP every 2 seconds", "Description: Grow up and face reality. Arm yourself with tenacity and confidence, while showing your friends tolerance and grace.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001D6.title: "Obtain King S Legacy"
	quest.C3000000000001DB.title: "Sarkaz King S Regal Rest"
	quest.C3000000000001DB.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001DB.quest_desc: ["Original effect: All Operators gain +20% DEF and +10 RES at full Life Points", "Description: For those in this position, a peaceful sleep becomes eternal", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001DB.title: "Obtain Sarkaz King S Regal Rest"
	quest.C3000000000001DC.title: "Sarkaz King S Torn Banner"
	quest.C3000000000001DC.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001DC.quest_desc: ["Original effect: All Operators gain +30 ASPD at full Life Points", "Description: For those in this position, to struggle is to inevitably fall.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001DC.title: "Obtain Sarkaz King S Torn Banner"
	quest.C3000000000001EC.title: "Rolling Ancestors"
	quest.C3000000000001EC.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001EC.quest_desc: ["Original effect: All enemy units have ASPD +30, Movement Speed +30%, and Max HP +30%; can encounter a different Dreadful Foe in Border of Truth", "Description: Oh great, the ancestors are here, and they want something more exciting...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001EC.title: "Obtain Rolling Ancestors"
	quest.C3000000000001F4.title: "Silk Bond Mystery"
	quest.C3000000000001F4.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001F4.quest_desc: ["Original effect: Operators take continuous damage if other Operators are within the 8 surrounding tiles; otherwise, gain +50 ASPD; only active in Bizarre Fragments", "Description: 'Lich Bertha was obsessed with other kinds of Sarkaz since childhood. On the very next day that she became a 'First Scribe', she forced a witchcraft contract with a test subject animal to unlock its intelligence, creating the 'Slugkaz'. Her silk threads remain hidden, afraid to face the other Liches.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F4.title: "Obtain Silk Bond Mystery"
	quest.C3000000000001FE.title: "Body Of The End"
	quest.C3000000000001FE.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001FE.quest_desc: ["Original effect: All Operators have +2 DP Cost; all enemies take 20% less Physical and Arts damage and gain 20% ATK", "Description: Amiya looks sadly at the person before her, sealed within the 'cocoon'. Frozen in place, they will no longer feel pain, nor will Originium cut their life short. She was unwilling to recklessly use her newly awakened powers, but now... there is no other choice.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FE.title: "Obtain Body Of The End"
	quest.C3000000000001FF.title: "Reality Of The End"
	quest.C3000000000001FF.quest_subtitle: "Hybrid Combat"
	quest.C3000000000001FF.quest_desc: ["Original effect: All Operators have +2 DP Cost; all enemies take 20% less Physical and Arts damage and gain 20% ATK; extra enemies will appear in the last battle", "Description: Everything has been sealed into the 'cocoon', and now time flows only for Amiya. She will seek a panacea for all afflictions—physical or mental, she wants to cure them all. An absolutely lonely and endlessly long journey stands before her. She has already set off.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FF.title: "Obtain Reality Of The End"
	quest.C30000000000020C.title: "Judgement Vanguard"
	quest.C30000000000020C.quest_subtitle: "Hybrid Combat"
	quest.C30000000000020C.quest_desc: ["Original effect: For every Bizarre Fragment Collectible owned, Vanguard Operators gain +20% ATK and +30% Max HP", "Description: Faced with the revenants' myriad mysteries, the Vanguards take the lead and charge in.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000020C.title: "Obtain Judgement Vanguard"
	quest.C30000000000020D.title: "Judgement Defender"
	quest.C30000000000020D.quest_subtitle: "Hybrid Combat"
	quest.C30000000000020D.quest_desc: ["Original effect: For every Bizarre Fragment Collectible owned, Defender Operators gain +20% DEF and +30% Max HP", "Description: Faced with the revenants' myriad mysteries, the Defenders prepare their defenses and steadily advance.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000020D.title: "Obtain Judgement Defender"
	quest.C30000000000020F.title: "Judgement Specialist"
	quest.C30000000000020F.quest_subtitle: "Hybrid Combat"
	quest.C30000000000020F.quest_desc: ["Original effect: For every Bizarre Fragment Collectible owned, Specialist Operators gain +20% ATK and +30% Max HP", "Description: Faced with the revenants' myriad mysteries, the Specialists swiftly drop in on key targets.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000020F.title: "Obtain Judgement Specialist"
	quest.C300000000000215.title: "Unripe Yearning"
	quest.C300000000000215.quest_subtitle: "Hybrid Combat"
	quest.C300000000000215.quest_desc: ["Original effect: For every Thought you have, all Operators gain +3% Max HP and DEF", "Description: These incomplete thoughts cling to their creators, zealously guarding them until they obtain their forms through a sudden revelation and embark on a long journey.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000215.title: "Obtain Unripe Yearning"
	quest.C300000000000222.title: "Evaluation Minister"
	quest.C300000000000222.quest_subtitle: "Hybrid Combat"
	quest.C300000000000222.quest_desc: ["Original effect: When an allied unit successfully Dodges or Resists damage, the next attack deals +100% damage", "Description: An assessment support tool developed by Tianshi Bureau apprentices. You don't get anything even if you have the right answers. But when you're wrong... well, best to not even try.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000222.title: "Obtain Evaluation Minister"
	quest.C300000000000224.title: "Everlasting Guiding Light"
	quest.C300000000000224.quest_subtitle: "Hybrid Combat"
	quest.C300000000000224.quest_desc: ["Original effect: The first deployed Ground Operator gains +50% ATK, status resistance, and 50% Elemental Injury reduction until they are defeated or retreated", "Description: First-timers scaling the mount wield a burning candle to shield their minds from being submerged in the Sui's consciousness. As dark encroaches, the candle burns bright, anchoring their own consciousness on their path back to the present, throughout their long night. This is how they came to be known as 'Candleholders'.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000224.title: "Obtain Everlasting Guiding Light"
	quest.C30000000000022F.title: "Old Sandal"
	quest.C30000000000022F.quest_subtitle: "Hybrid Combat"
	quest.C30000000000022F.quest_desc: ["Original effect: Summons deployed on Vagary Tiles take -50% Physical and Arts damage, and gain +50% ATK", "Description: An old straw sandal found under a bridge. The old man atop the bridge was waiting for you to return it, but once you get back, all you see is the other sandal. You mull it over, and recall how you recognize the old man's face from a certain painting...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000022F.title: "Obtain Old Sandal"
	quest.C300000000000236.title: "Dark Red Mask"
	quest.C300000000000236.quest_subtitle: "Hybrid Combat"
	quest.C300000000000236.quest_desc: ["Original effect: All Operators take 50% less damage from enemies blocked by them, and deal 50% more damage to the blocked enemies", "Description: The mask of an ancient Yanese hero. Records tell of his undying will so strong he even crossed a thousand li and vanquished a thousand foes to stay true to his sworn brotherhood.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000236.title: "Obtain Dark Red Mask"
	quest.C300000000000241.title: "Family Stir Fry"
	quest.C300000000000241.quest_subtitle: "Hybrid Combat"
	quest.C300000000000241.quest_desc: ["Original effect: All Operators gain +20% HP and ATK; every Sui's Remnant Consciousness battle cleared increases effects by 10%", "Description: Sky as lid, land as pot, with emotions of all variations sprinkled as seasoning on top. Humanity needs only eat well to live well.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000241.title: "Obtain Family Stir Fry"
	quest.C300000000000249.title: "Strange Picky Statue"
	quest.C300000000000249.quest_subtitle: "Hybrid Combat"
	quest.C300000000000249.quest_desc: ["Original effect: Whenever you toss 3 Risk Coins, gain 3 Max Life Points and 3 Objective Shield", "Description: A shellbeast inside a pond that never does anything when coins are thrown at it. A naughty child throws trash that gets swallowed by the statue, sending the child into tears. The statue then reopens its mouth to spit out pretty pearls, sending the child into high spirits.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000249.title: "Obtain Strange Picky Statue"
	quest.C30000000000024E.title: "Plucked Balance"
	quest.C30000000000024E.quest_subtitle: "Hybrid Combat"
	quest.C30000000000024E.quest_desc: ["Original effect: Melee Operators gain +35% HP and +35% ATK", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000024E.title: "Obtain Plucked Balance"
	quest.C300000000000251.title: "Thrown Balance"
	quest.C300000000000251.quest_subtitle: "Hybrid Combat"
	quest.C300000000000251.quest_desc: ["Original effect: All Ranged Operators gain +25% HP and +25% ATK", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000251.title: "Obtain Thrown Balance"
	quest.C300000000000253.title: "Thrown Risk"
	quest.C300000000000253.quest_subtitle: "Hybrid Combat"
	quest.C300000000000253.quest_desc: ["Original effect: All Ranged Operators gain status resistance and 15% Arts Dodge", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000253.title: "Obtain Thrown Risk"
	quest.C300000000000257.title: "Sui S Balance"
	quest.C300000000000257.quest_subtitle: "Hybrid Combat"
	quest.C300000000000257.quest_desc: ["Original effect: Candleguest Operators gain +50% ATK and DEF", "Description: When both signs come together, what old tale do they tell?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000257.title: "Obtain Sui S Balance"
	quest.C30000000000025E.title: "Unsealed Case"
	quest.C30000000000025E.quest_subtitle: "Hybrid Combat"
	quest.C30000000000025E.quest_desc: ["Original effect: Leader and Elite enemies gain +30% DEF and +20 ASPD; every Statuegeist remaining on the field when the stage ends will deplete 1 Life Point (min 1); wondrous effects in Scout nodes", "Description: A box Yi left in the Sui's Remnant Consciousness. Name and decorations lost, bereft of carvings or markings.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000025E.title: "Obtain Unsealed Case"
	quest.C300000000000269.title: "Four Corners Paint"
	quest.C300000000000269.quest_subtitle: "Hybrid Combat"
	quest.C300000000000269.quest_desc: ["Original effect: For one time per battle, an Operator deployed with 4 Operators already on the field will gain +50% HP, +50% DEF, and +5 Block", "Description: Dusk's special mix of pigments that also serves as her seal. When a brush is dipped into the palette, the four colors fuse and form into a scene.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000269.title: "Obtain Four Corners Paint"
	quest.C30000000000026A.title: "Four Seasons Brush"
	quest.C30000000000026A.quest_subtitle: "Hybrid Combat"
	quest.C30000000000026A.quest_desc: ["Original effect: For one time per battle, an Operator deployed with 4 Operators already on the field will gain status resistance, +50% ATK, and take 50% less Elemental Injury", "Description: Dusk's specially created brush that also serves as her seal. When she puts brush to parchment, the four seasons stay as-is.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000026A.title: "Obtain Four Seasons Brush"
	quest.C30000000000026E.title: "Merchant Shadow"
	quest.C30000000000026E.quest_subtitle: "Hybrid Combat"
	quest.C30000000000026E.quest_desc: ["Original effect: The rightmost Operator in the Deployment Waiting Zone gains +2 Block, +50% DEF, +50% Max HP, and refunds half the DP spent after deployment", "Description: This shadow puppet was created to honor a legendary merchant. They once assembled a caravan of civilians to trade goods between cities in Catastrophe-prone areas, meeting the towns' urgent needs. When the Chidao was finally completed, they perished in an accident.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000026E.title: "Obtain Merchant Shadow"
	quest.C300000000000271.title: "Raidian S Handheld Console"
	quest.C300000000000271.quest_subtitle: "Hybrid Combat"
	quest.C300000000000271.quest_desc: ["Original effect: For every Summon on the field, all Summons gain +100 ATK and DEF (Stacks up to 10 times)", "Description: Stuffed with many carefully designed mini-games. You can always see a trace of the equipment Raidian uses daily in the protagonists, but no sign of her herself.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000271.title: "Obtain Raidian S Handheld Console"
	quest.C30000000000027F.title: "Old Millstone"
	quest.C30000000000027F.quest_subtitle: "Hybrid Combat"
	quest.C30000000000027F.quest_desc: ["Original effect: Operators +6 ASPD after taking damage (Stacks 10x)", "Description: The beast that pulled the millstone was whipped, the man who pushed the millstone was berated, but it was the millstone that broke first. Now it turns by itself, whenever it hears a sound.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000027F.title: "Obtain Old Millstone"
	quest.C300000000000286.title: "Victory Guqin"
	quest.C300000000000286.quest_subtitle: "Hybrid Combat"
	quest.C300000000000286.quest_desc: ["Original effect: Allied Operators' ATK +15%, extra +5% whenever Life Point(s) lost (Stacks 17x)", "Description: Only a brave warrior who came back from battle can make a sound with it. Each battle forms a music score that is preserved for commemoration. The body of the zither is red after hundreds of battles, but the music of victory lingers.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000286.title: "Obtain Victory Guqin"
	quest.C3000000000002A8.title: "Hound Disease Cure"
	quest.C3000000000002A8.quest_subtitle: "Hybrid Combat"
	quest.C3000000000002A8.quest_desc: ["Original effect: 我方狂躁元素爆发后不再受到持续伤害，且期间攻击速度额外+50", "Description: 可以短暂抑制猎犬病症状的特效药，但仅仅是短暂抑制，医疗及研究人员至今无法根除此病。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002A8.title: "Obtain Hound Disease Cure"
	quest.C3000000000002B0.title: "Bluntclaw Battle Hardened"
	quest.C3000000000002B0.quest_subtitle: "Hybrid Combat"
	quest.C3000000000002B0.quest_desc: ["Original effect: 所有【先锋】干员的攻击力+50%，防御力+50%", "Description: “一鼓作气，克敌机先。”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002B0.title: "Obtain Bluntclaw Battle Hardened"
	quest.C3000000000002C2.title: "Healer New Doctrine"
	quest.C3000000000002C2.quest_subtitle: "Hybrid Combat"
	quest.C3000000000002C2.quest_desc: ["Original effect: 立即进阶一个【医疗】干员（不消耗希望），并使其：治疗时使目标获得2技力", "Description: “我成为医疗干员的初衷是希望没有人再来找我看病，如果失业我也是心甘情愿的。”", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002C2.title: "Obtain Healer New Doctrine"
	quest.C100000000000006.title: "Exploration"
	quest.C100000000000006.quest_subtitle: "Contains 72 collectibles."
	quest.C100000000000006.quest_desc: ["Primarily affects nodes, battle results, routes, or exploration failure rules.", "Contains 72 collectibles."]
	task.C200000000000006.title: "Read category guide"
	quest.C30000000000001D.title: "Crimson Troupe Ticket Stub"
	quest.C30000000000001D.quest_subtitle: "Exploration"
	quest.C30000000000001D.quest_desc: ["Original effect: 25% chance to drop an additional Recruitment Voucher after battle", "Description: A Crimson Troupe ticket stub. None of the cast are listed. What kind of performance do they have in store for you?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000001D.title: "Obtain Crimson Troupe Ticket Stub"
	quest.C30000000000001E.title: "Lucky Coin"
	quest.C30000000000001E.quest_subtitle: "Exploration"
	quest.C30000000000001E.quest_desc: ["Original effect: Gain +2 Originium Ingots upon entering a noncombat node.", "Description: A coin picked up from Rhodes Island. If you find one, you're sure to be able to find many more.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000001E.title: "Obtain Lucky Coin"
	quest.C30000000000001F.title: "Masquerade Mask"
	quest.C30000000000001F.quest_subtitle: "Exploration"
	quest.C30000000000001F.quest_desc: ["Original effect: Gain +3 Originium Ingots upon entering a noncombat node.", "Description: Esteemed guests, welcome to the Crimson Troupe. The performance we have in store for you tonight will be one to remember.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000001F.title: "Obtain Masquerade Mask"
	quest.C300000000000024.title: "Four Leaf Clover Fossil"
	quest.C300000000000024.quest_subtitle: "Exploration"
	quest.C300000000000024.quest_desc: ["Original effect: Gain an additional choice when collectibles are dropped after battle", "Description: A symbol of luck that Magallan found in a place all but devoid of life. The rock has no doubt experienced many violent changes of the lands, but it survived, giving those who come across it a small bit of lingering hope.\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000024.title: "Obtain Four Leaf Clover Fossil"
	quest.C3000000000000BE.title: "Playwrights Manuscript Ursus"
	quest.C3000000000000BE.quest_subtitle: "Exploration"
	quest.C3000000000000BE.quest_desc: ["Original effect: All enemy units have +10% ATK, DEF, and Max HP; Lose 1 Originium Ingot every time you enter a non-combat node", "Description: 'The Ursus's feast comes to an abrupt stop—'\n", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000BE.title: "Obtain Playwrights Manuscript Ursus"
	quest.C3000000000000C0.title: "Playwrights Manuscript Gaul"
	quest.C3000000000000C0.quest_subtitle: "Exploration"
	quest.C3000000000000C0.quest_desc: ["Original effect: All enemy units have +10% ATK, DEF, and Max HP and the bonus is doubled when you lose Life Points for the first time in each battle", "Description: 'The Liberi's bricks turn into dust—'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000C0.title: "Obtain Playwrights Manuscript Gaul"
	quest.C3000000000000C3.title: "Magnificent Visage"
	quest.C3000000000000C3.quest_subtitle: "Exploration"
	quest.C3000000000000C3.quest_desc: ["Original effect: Gain +1 Hope upon entering a noncombat node.", "Description: It's a good thing that a glimpse of her face feels you with hope—and especially so if you knew of the disaster.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000C3.title: "Obtain Magnificent Visage"
	quest.C3000000000000D0.title: "Worn Out Puppet"
	quest.C3000000000000D0.quest_subtitle: "Exploration"
	quest.C3000000000000D0.quest_desc: ["Original effect: The adventure will head towards a different ending", "Description: 'He said he has had enough. He will be a puppet no longer.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D0.title: "Obtain Worn Out Puppet"
	quest.C3000000000000D5.title: "Abrupt Realization"
	quest.C3000000000000D5.quest_subtitle: "Exploration"
	quest.C3000000000000D5.quest_desc: ["Original effect: All friendly units have -3 DP Cost and gain +5% ATK, DEF, and Max HP. The adventure will head towards a different ending", "Description: The Witch King's followers have given everything for the arts. Their flesh, their blood, their beliefs, and their souls.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D5.title: "Obtain Abrupt Realization"
	quest.C3000000000000D7.title: "Act 1"
	quest.C3000000000000D7.quest_subtitle: "Exploration"
	quest.C3000000000000D7.quest_desc: ["Original effect: Hope +3, leads the exploration toward a different conclusion", "Description: The end of the first act, the first ending that the young man wrote for himself. In the midst of the fire that consumed all that he treasured, the hero sips his foe's blood and writes the last scene of his vendetta.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000D7.title: "Obtain Act 1"
	quest.C3000000000000E6.title: "Rhodes Island Tactical Transceiver"
	quest.C3000000000000E6.quest_subtitle: "Exploration"
	quest.C3000000000000E6.quest_desc: ["Original effect: Gain an additional choice when Recruitment Vouchers are dropped after battle", "Description: Hang in there, help's on the way.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000E6.title: "Obtain Rhodes Island Tactical Transceiver"
	quest.C3000000000000FD.title: "Nightsun Flower"
	quest.C3000000000000FD.quest_subtitle: "Exploration"
	quest.C3000000000000FD.quest_desc: ["Original effect: +10 Light", "Description: It gives off light at night and forms groups to grow, able to provide a certain amount of lighting - hence the name.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000FD.title: "Obtain Nightsun Flower"
	quest.C3000000000000FE.title: "Flamecaller Originium Slug"
	quest.C3000000000000FE.quest_subtitle: "Exploration"
	quest.C3000000000000FE.quest_desc: ["Original effect: +15 Light", "Description: A species of wild Originium slug, with plumes of dim flame periodically bursting from its back. Through modern scientific research, it was determined that the creature's incendiary phenomenon was the result of a chemical reaction, not the resurrection of their kin's souls.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000FE.title: "Obtain Flamecaller Originium Slug"
	quest.C3000000000000FF.title: "Pathfinder Fin"
	quest.C3000000000000FF.quest_subtitle: "Exploration"
	quest.C3000000000000FF.quest_desc: ["Original effect: +30 Light", "Description: An asexual marine creature endemic to the coasts of Iberia, named because they are often said to guide fincatchers back to shore. These days, they are rarely seen, and are now regarded as a symbol of luck by the new generation of Iberians.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000000FF.title: "Obtain Pathfinder Fin"
	quest.C300000000000128.title: "Three Key Contract"
	quest.C300000000000128.quest_subtitle: "Exploration"
	quest.C300000000000128.quest_desc: ["Original effect: +3 Keys", "Description: According to regulations, lighthouse keepers must always carry three keys: one to unlock the main door, another to establish communication, and one to activate the searchlight. Sign your name, and the contract is set in stone. Carry the keys with you at all times, regardless of life or death.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000128.title: "Obtain Three Key Contract"
	quest.C300000000000132.title: "Paraffin And Balsam"
	quest.C300000000000132.quest_subtitle: "Exploration"
	quest.C300000000000132.quest_desc: ["Original effect: -30 Light, when obtained, suppresses a designated Operator's Rejection", "Description: Burn it and your impurities shall be shunned, allowing you to remain a pure human being. Praise the flame.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000132.title: "Obtain Paraffin And Balsam"
	quest.C300000000000133.title: "Nightsun Grass"
	quest.C300000000000133.quest_subtitle: "Exploration"
	quest.C300000000000133.quest_desc: ["Original effect: +5 Light", "Description: Only a faint glimmer of light remains on the leaves of the nightsun flower. Contains certain detoxifying compounds and can be used as medicine.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000133.title: "Obtain Nightsun Grass"
	quest.C30000000000013E.title: "Emergency Light"
	quest.C30000000000013E.quest_subtitle: "Exploration"
	quest.C30000000000013E.quest_desc: ["Original effect: Lose an additional 2 Light after each battle", "Description: Ægir warriors used to lock some kind of small luminescent Sea Terror inside a transparent contraption to serve as lighting during emergency situations. The restless Sea Terror would smash into its confines, releasing even more light in a frenzy until it died, staining its prison with an indescribable black glue.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000013E.title: "Obtain Emergency Light"
	quest.C30000000000013F.title: "Luminous Corpse"
	quest.C30000000000013F.quest_subtitle: "Exploration"
	quest.C30000000000013F.quest_desc: ["Original effect: Lose an additional 3 Light after each battle", "Description: To provide light to we many during long migrations, the weakest organs among the collective would dissolve on their own and start glowing, leaving nothing behind but a transparent membrane.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000013F.title: "Obtain Luminous Corpse"
	quest.C300000000000140.title: "Bishop S Research"
	quest.C300000000000140.quest_subtitle: "Exploration"
	quest.C300000000000140.quest_desc: ["Original effect: Lose an additional 5 Light after each battle", "Description: Almost all of the bishop's lifelong research can be found among these documents and notes, many of which involve experiments that transcended ethics and morality. In his eyes, making contact with the Seaborn was just a means to an end for his ultimate vision: allowing human beings to evolve into a more powerful existence through fusion with the Seaborn.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000140.title: "Obtain Bishop S Research"
	quest.C300000000000141.title: "Caerula Animus"
	quest.C300000000000141.quest_subtitle: "Exploration"
	quest.C300000000000141.quest_desc: ["Original effect: -50 Light; when obtained, immediately afflicts a random Operator with a Rejection, and leads the exploration toward a different ending", "Description: The surviving core organ of the 'Firstborn' that devoured Its birthplace and soon died afterwards. Only the Seaborn are able to assimilate it, but only humans are able to understand the grief contained within. Alas, even for those whose evolution never ends, their - Their - suffering will always persist.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000141.title: "Obtain Caerula Animus"
	quest.C300000000000144.title: "Absurd Fate"
	quest.C300000000000144.quest_subtitle: "Exploration"
	quest.C300000000000144.quest_desc: ["Original effect: +10 Originium Ingots, +1 Key", "Description: His name is widely known in Kazimierz, and his descendants set up companies to benefit from his renown. All the things he defended with his life have become nothing more than gold coins in a wallet.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000144.title: "Obtain Absurd Fate"
	quest.C300000000000150.title: "Vigil"
	quest.C300000000000150.quest_subtitle: "Exploration"
	quest.C300000000000150.quest_desc: ["Original effect: All Operators gain Block +1; leads the exploration towards a different conclusion", "Description: Mizuki does not particularly identify with either humans or Seaborn. He only does what he thinks is right.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000150.title: "Obtain Vigil"
	quest.C300000000000151.title: "Hesitation"
	quest.C300000000000151.quest_subtitle: "Exploration"
	quest.C300000000000151.quest_desc: ["Original effect: All Operators gain Block -1 (will not go below 1); leads the exploration towards a different conclusion", "Description: The manifestation of Mizuki's self-doubt, as his Seaborn instincts overcome his humanity. It will continue to have a negative impact, as long as his self-identity remains unclear.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000151.title: "Obtain Hesitation"
	quest.C300000000000153.title: "Caerula Memory"
	quest.C300000000000153.quest_subtitle: "Exploration"
	quest.C300000000000153.quest_desc: ["Original effect: Light -100, immediately afflicts a random Operator with a Rejection", "Description: Even vague memories of the lab's research are enough to induce fear. Perhaps you and people like you have all done something unforgivable for the sake of survival.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000153.title: "Obtain Caerula Memory"
	quest.C300000000000157.title: "Wordless Coral"
	quest.C300000000000157.quest_subtitle: "Exploration"
	quest.C300000000000157.quest_desc: ["Original effect: Recover 5 Light for every die roll", "Description: There is no writing on it, only a faint scent. Chemicals are transmitted through the air, communicating information to we many.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000157.title: "Obtain Wordless Coral"
	quest.C30000000000015A.title: "Solidified Lamp Oil"
	quest.C30000000000015A.quest_subtitle: "Exploration"
	quest.C30000000000015A.quest_desc: ["Original effect: Light loss from battle damage reduced by 40%", "Description: Solidified oil that can be added to a lamp to keep it burning bright.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000015A.title: "Obtain Solidified Lamp Oil"
	quest.C30000000000015B.title: "Sanctified Lamp Oil"
	quest.C30000000000015B.quest_subtitle: "Exploration"
	quest.C30000000000015B.quest_desc: ["Original effect: Light loss from battle damage reduced by 60%", "Description: Processed lamp oil that the Inquisition issues to its Inquisitors. The scent sharpens the mind, keeping them alert and aware of every evil.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000015B.title: "Obtain Sanctified Lamp Oil"
	quest.C300000000000160.title: "Mercenary Insurance"
	quest.C300000000000160.quest_subtitle: "Exploration"
	quest.C300000000000160.quest_desc: ["Original effect: All friendly units gain 10% Sanctuary, increased to 35% if Light is below 50.", "Description: Special insurance offered to independent mercenaries, indemnifying against mission failure or excessive loss.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000160.title: "Obtain Mercenary Insurance"
	quest.C30000000000018A.title: "Northern Pioneer S Crutch"
	quest.C30000000000018A.quest_subtitle: "Exploration"
	quest.C30000000000018A.quest_desc: ["Original effect: When Anti-Interference Index is no less than 4, gain +2 Originium Ingots whenever you enter a non-combat node", "Description: It can detect some types of hazards, but more importantly, it can detect coins. According to the terms of the contract, the company will only bear the costs of the Pioneers' medical insurance after a local medical institute adhering to Columbian standards has been established.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000018A.title: "Obtain Northern Pioneer S Crutch"
	quest.C30000000000018F.title: "Roundstone Altar"
	quest.C30000000000018F.quest_subtitle: "Exploration"
	quest.C30000000000018F.quest_desc: ["Original effect: There is a chance after battle to permanently increase all allied units' ATK and DEF by 5% (Can stack up to 10 times)", "Description: Offer a sacrifice, and receive a reward. It is so convenient that the people never think about what they are directing their sacrifices to.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000018F.title: "Obtain Roundstone Altar"
	quest.C30000000000019D.title: "Treescar Helm"
	quest.C30000000000019D.quest_subtitle: "Exploration"
	quest.C30000000000019D.quest_desc: ["Original effect: +3 Hope; leads expedition in a different direction", "Description: It carries status and power, but to the warrior, it is only an artificial object for the weak to protect themselves. Some discard it to abandon their duty, some discard it only to strengthen their resolve to give up their lives.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000019D.title: "Obtain Treescar Helm"
	quest.C30000000000019E.title: "Boundless Gift"
	quest.C30000000000019E.quest_subtitle: "Exploration"
	quest.C30000000000019E.quest_desc: ["Original effect: +3 Collapse value; leads expedition in a different direction", "Description: Takes root in regions unperceivable, absorbs nutrients in places unimaginable. The flowers bloom across the vastness, becoming the very first signal beacon outside the border.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000019E.title: "Obtain Boundless Gift"
	quest.C30000000000019F.title: "Routeweave Net"
	quest.C30000000000019F.quest_subtitle: "Exploration"
	quest.C30000000000019F.quest_desc: ["Original effect: Additional enemies appear in battle; leads expedition in a different direction", "Description: An intricate network is woven into a map that no one understands. It shows what seems to be a path that extends in all directions, but what it actually displays is only the result.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000019F.title: "Obtain Routeweave Net"
	quest.C3000000000001A3.title: "Horizon Invitation"
	quest.C3000000000001A3.quest_subtitle: "Exploration"
	quest.C3000000000001A3.quest_desc: ["Original effect: Leads expedition in a different direction", "Description: An invitation to the end of the icefield, distributed or sold through secret channels to those deserving. However, obtaining this invitation is merely the first step, and the test is yet to come—", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A3.title: "Obtain Horizon Invitation"
	quest.C3000000000001A4.title: "Dimensional Fluid"
	quest.C3000000000001A4.quest_subtitle: "Exploration"
	quest.C3000000000001A4.quest_desc: ["Original effect: Leads expedition in a different direction", "Description: A raw material developed by integrating technology from multiple nations and results from deep-dives into Collapsal research. After passing the test, the Rhodes Island operator officially hands it to you along with a message: 'Deliver it safely to the end of the icefield, where Kal'tsit waits for you.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001A4.title: "Obtain Dimensional Fluid"
	quest.C3000000000001C1.title: "Revenant Remnant"
	quest.C3000000000001C1.quest_subtitle: "Exploration"
	quest.C3000000000001C1.quest_desc: ["Original effect: Hope +2, refresh count at each Node +1", "Description: To be a wandering ghost without a body. This is the price some Sarkaz willingly paid to ensure the future of their race.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001C1.title: "Obtain Revenant Remnant"
	quest.C3000000000001E0.title: "Masterless Memories"
	quest.C3000000000001E0.quest_subtitle: "Exploration"
	quest.C3000000000001E0.quest_desc: ["Original effect: Immediately obtain 5 Thoughts at most left behind from your last adventure", "Description: As the elder tossed them into the furnace, some revenants finally remembered where they came from and their duties, and remade their oaths to their faith. Others unleashed a sudden slew of curses, magnifying the echoes of flames reverberating on the furnace walls.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E0.title: "Obtain Masterless Memories"
	quest.C3000000000001E1.title: "Herr Hraaselsuher"
	quest.C3000000000001E1.quest_subtitle: "Exploration"
	quest.C3000000000001E1.quest_desc: ["Original effect: Toil Limit +2 and chance to gain 1 Plan after combat", "Description: Albrecht Von Musbeast, Graf of the Spire of Rosen und Horns, is at your service, pledging to bring you lost treasures and hidden wisdom! He asks only for an occasional share of the haul, saying they're for his wife and daughter.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E1.title: "Obtain Herr Hraaselsuher"
	quest.C3000000000001E3.title: "Anchor For Five Seconds Ago"
	quest.C3000000000001E3.quest_subtitle: "Exploration"
	quest.C3000000000001E3.quest_desc: ["Original effect: Gain 1 extra Inspirer after the battle if you used an Inspirer as the battle started", "Description: A young Lich was fretting over occasionally forgetting an idea he thought of five seconds ago, so he created this anchor to set those fleeting inspirations in place. Afterwards, he seemed to have forgotten to use it.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E3.title: "Obtain Anchor For Five Seconds Ago"
	quest.C3000000000001E5.title: "Scales Of Avarice"
	quest.C3000000000001E5.quest_subtitle: "Exploration"
	quest.C3000000000001E5.quest_desc: ["Original effect: Gain +3 Originium Ingots for each non-combat node entered when Total Mental Toil exceeds 20", "Description: Merchants offered money, treasure, and even their lives and souls, but couldn't balance the scales to obtain the feather-light glow. The elder revenant crushed the scales with his soul and sealed the rogue revenant in his bones.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E5.title: "Obtain Scales Of Avarice"
	quest.C3000000000001E8.title: "Doodle Of Hope"
	quest.C3000000000001E8.quest_subtitle: "Exploration"
	quest.C3000000000001E8.quest_desc: ["Original effect: Hope +3; Emergency Ops will no longer appear when refreshing nodes; triggers wondrous effects in Encounter nodes", "Description: 'I'm a Teekaz orphan. My parents died in a Catastrophe, and it was my Feline neighbor who raised me and treated me as one of his own. I can say with a clear conscience that I am a descendant of the Ancients.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001E8.title: "Obtain Doodle Of Hope"
	quest.C3000000000001EA.title: "Burdenherd Bell"
	quest.C3000000000001EA.quest_subtitle: "Exploration"
	quest.C3000000000001EA.quest_desc: ["Original effect: Burdenbeast Traveler joins your squad; gains an additional choice when loot drops from a Wish Fulfilled node", "Description: Whip it, and it will flee in terror; Pull on the reins, and it will resist. Ring the bell, hum a tune, and it will follow you to the ends of the land.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001EA.title: "Obtain Burdenherd Bell"
	quest.C3000000000001EB.title: "Lamp Of Wishes"
	quest.C3000000000001EB.quest_subtitle: "Exploration"
	quest.C3000000000001EB.quest_desc: ["Original effect: Originium Ingots +10, Wish Fulfilled will appear more often when refreshing nodes; triggers wondrous effects in Wish Fulfilled", "Description: 'I heard the Sarkaz can grant any wish, so I dug deep to find their secrets. It seems this was the start of their suffering.'", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001EB.title: "Obtain Lamp Of Wishes"
	quest.C3000000000001F5.title: "Pledge Of Babel"
	quest.C3000000000001F5.quest_subtitle: "Exploration"
	quest.C3000000000001F5.quest_desc: ["Original effect: All Operators +3 DP Cost; leads expedition in a different direction", "Description: 'Babel' is directly led by two Kings of Sarkaz who have contributed greatly to the advancement of the military, technology, and medicine. Its initial, and also ultimate, goal is to eliminate war itself by any means necessary.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F5.title: "Obtain Pledge Of Babel"
	quest.C3000000000001F6.title: "Prophet Horn"
	quest.C3000000000001F6.quest_subtitle: "Exploration"
	quest.C3000000000001F6.quest_desc: ["Original effect: Nodes will turn into Prophecy when refreshed; not active in Bizarre Fragments", "Description: It was neither guns nor blades that conquered the Elders and Ancients, but the Law. Soon, the significance of the word 'teekaz' transcended race, and Kazdel became home to all life.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F6.title: "Obtain Prophet Horn"
	quest.C3000000000001F8.title: "Time And Light"
	quest.C3000000000001F8.quest_subtitle: "Exploration"
	quest.C3000000000001F8.quest_desc: ["Original effect: Epochs will occur more often, and Thoughts have +1 Toil; leads expedition in a different direction", "Description: The first mad howl that awakened the Law.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001F8.title: "Obtain Time And Light"
	quest.C3000000000001FC.title: "Endless Key"
	quest.C3000000000001FC.quest_subtitle: "Exploration"
	quest.C3000000000001FC.quest_desc: ["Original effect: Leads expedition in a different direction", "Description: Through your torrent of inspirations, a story takes shape from nothingness. Through your exhausted imagination, Amiya will put an end to everything. Can your thoughts become a weapon to resist her?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000001FC.title: "Obtain Endless Key"
	quest.C300000000000205.title: "Arch Glyph"
	quest.C300000000000205.quest_subtitle: "Exploration"
	quest.C300000000000205.quest_desc: ["Original effect: For one time only, if you would fail any battle other than the final battle of the area or a Leader battle and are currently not in a Bizarre Fragment, you will enter a special Bizarre Fragment", "Description: Since antiquity, Kazdel has been concealed within the northern wind and snow. Led by the Cyclopes, the Sarkaz jointly created this Foldartal seal with their psychic powers. In a pinch, place it on ice and snow to hide within the Feranmut beneath your feet, evading the 'enemy'.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000205.title: "Obtain Arch Glyph"
	quest.C300000000000243.title: "Wooden Lump"
	quest.C300000000000243.quest_subtitle: "Exploration"
	quest.C300000000000243.quest_desc: ["Original effect: On next visit to Sui's Remnant Consciousness, +2 Candles; Gain 10 Coupons after clearing all Retrieve and Legend nodes", "Description: An ordinary geist object, which, as Liu'er says, is a treasure she found on the shores of the eastern. But apart from the warm wooden texture and refreshing, energizing fragrance, there doesn't seem to be anything special about it...", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000243.title: "Obtain Wooden Lump"
	quest.C30000000000025B.title: "Carved Inkstick Remnant"
	quest.C30000000000025B.quest_subtitle: "Exploration"
	quest.C30000000000025B.quest_desc: ["Original effect: Every battle, a random Operator will have their DP Cost reduced to 0. When carrying this Collectible, can choose to lead expedition in a different direction in Prophecy", "Description: A butterfly rests on the edge of the inkstick, and 'words' emerge from its multitude of layers. The missing sections are no longer readable, but the radicals and shapes of the other characters imply longing for a relative.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000025B.title: "Obtain Carved Inkstick Remnant"
	quest.C30000000000025F.title: "Inkless Scroll"
	quest.C30000000000025F.quest_subtitle: "Exploration"
	quest.C30000000000025F.quest_desc: ["Original effect: +3 Hope, Dreadful Foe nodes in Jianzi Shrine will be more difficult; leads expedition in a different direction", "Description: Humanity and Sui opened the box with their shared memories, and the long scroll searches for traces of where ink could have been.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000025F.title: "Obtain Inkless Scroll"
	quest.C300000000000260.title: "Memory Scope"
	quest.C300000000000260.quest_subtitle: "Exploration"
	quest.C300000000000260.quest_desc: ["Original effect: When obtained, lose all Originium Ingots and Hope, and gain -50% Command Level EXP and Originium Ingots from battle. Special function in Wander into Wonderland", "Description: Created by Sui proxies for the purpose of fighting the bestial Sui. In its endless spinning, the myriad possibilities of Its awakening are revealed, allowing Wang to plan ahead.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000260.title: "Obtain Memory Scope"
	quest.C300000000000261.title: "Little Moji"
	quest.C300000000000261.quest_subtitle: "Exploration"
	quest.C300000000000261.quest_desc: ["Original effect: Reduce natural DP regeneration rate by 50%, leads expedition in a different direction. Special function in Tavern", "Description: Inkgeist fed with the Sui proxies' memories. Its movements are not particularly swift, but it assists with suppressing Sui's awakening consciousness in the infinite possibilities.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000261.title: "Obtain Little Moji"
	quest.C30000000000026F.title: "Deepwater Talisman"
	quest.C30000000000026F.quest_subtitle: "Exploration"
	quest.C30000000000026F.quest_desc: ["Original effect: In Garden of Grotesqueries, the first combat node on every floor will drop an extra Recruitment Voucher, Recruitment Voucher conservation limit +1", "Description: The Sui Regulator trusts you, and approved your application to bring more Operators into the garden. Though, just as a creekfin enters a new river with caution, they hope newcomers will understand the importance of staying sharp.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000026F.title: "Obtain Deepwater Talisman"
	quest.C300000000000273.title: "Tzu Wu Blade"
	quest.C300000000000273.quest_subtitle: "Exploration"
	quest.C300000000000273.quest_desc: ["Original effect: Reveals all Turmoil nodes on the current or next Sui's Remnant Consciousness visit; grants -5% Redeployment Time to all Operators, and gains 1 stack for each completed Turmoil node, up to 6 stacks", "Description: An object condensed from the first Acute Hour of Sui, shaped as a weapon. With combat as whetstone, one can see keen fury within.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000273.title: "Obtain Tzu Wu Blade"
	quest.C300000000000274.title: "Wu Shang Shuttle"
	quest.C300000000000274.quest_subtitle: "Exploration"
	quest.C300000000000274.quest_desc: ["Original effect: Reveals all Trade nodes on the current or next Sui's Remnant Consciousness visit; Trade nodes will offer discounted goods, and buying all stock in a shop grants a free chance to refresh stock", "Description: An object condensed from the seventh Acute Hour of Sui, shaped as a shuttle. With links and weaves, one can see layered anxiety within.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000274.title: "Obtain Wu Shang Shuttle"
	quest.C300000000000275.title: "Shen Chu Wheel"
	quest.C300000000000275.quest_subtitle: "Exploration"
	quest.C300000000000275.quest_desc: ["Original effect: +1 Hope, +3 Ingots, reveals all Leisure nodes on the current and next Sui's Remnant Consciousness visit; wondrous effects in some Leisure nodes", "Description: An object condensed from the ninth Acute Hour of Sui, shaped as a wheel. With curiosity as forge, one can see optimistic escapism within.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000275.title: "Obtain Shen Chu Wheel"
	quest.C300000000000276.title: "Hai Shih Stove"
	quest.C300000000000276.quest_subtitle: "Exploration"
	quest.C300000000000276.quest_desc: ["Original effect: Wondrous effects in Retrieve nodes; +2 Candles after clearing all Retrieve nodes (only triggers once)", "Description: An object condensed from the twelfth Acute Hour of Sui, shaped as a stove. With myriad bestial Sui deeds and mortal disputes all on the same land, why differentiate between the two?", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000276.title: "Obtain Hai Shih Stove"
	quest.C300000000000277.title: "Yin Shih Flask"
	quest.C300000000000277.quest_subtitle: "Exploration"
	quest.C300000000000277.quest_desc: ["Original effect: +2 Hope, reveals some Legend and Decision nodes on the current or next Sui's Remnant Consciousness visit; wondrous effects in some Legend nodes", "Description: An object condensed from the third Acute Hour of Sui, shaped as a flask. With tales as wine, one can see unrestrained freedom within.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000277.title: "Obtain Yin Shih Flask"
	quest.C300000000000278.title: "Wei Chien Rule"
	quest.C300000000000278.quest_subtitle: "Exploration"
	quest.C300000000000278.quest_desc: ["Original effect: +6 Ingots; wondrous effects in Tavern nodes", "Description: An object condensed from the eighth Acute Hour of Sui, shaped as a rule. With knowledge of construction, one can see obstructive amiability within.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000278.title: "Obtain Wei Chien Rule"
	quest.C30000000000028D.title: "Swaddled Eagle"
	quest.C30000000000028D.quest_subtitle: "Exploration"
	quest.C30000000000028D.quest_desc: ["Original effect: 初始希望+1，初始揭示前两个探索区域中所有节点的信息", "Description: 愿新生的它不再狂傲。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000028D.title: "Obtain Swaddled Eagle"
	quest.C30000000000028E.title: "Swaddled Dragon"
	quest.C30000000000028E.quest_subtitle: "Exploration"
	quest.C30000000000028E.quest_desc: ["Original effect: 前两个探索区域的战斗中，所有敌人的最大生命-50%", "Description: 愿新生的它不再饥饿。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C40000000000028E.title: "Obtain Swaddled Dragon"
	quest.C3000000000002CF.title: "Hide And Seek"
	quest.C3000000000002CF.quest_subtitle: "Exploration"
	quest.C3000000000002CF.quest_desc: ["Original effect: 每次进入新区域时标记一个节点，探索该节点后获得一个较为稀有的随机自然物", "Description: 藏起一颗橡实，以便让万物都认得我们。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002CF.title: "Obtain Hide And Seek"
	quest.C3000000000002D9.title: "Black Current Tree Sea Notes"
	quest.C3000000000002D9.quest_subtitle: "Exploration"
	quest.C3000000000002D9.quest_desc: ["Original effect: 每探索一种新节点叠加1层，每层使作战后获得收藏品的概率提升", "Description: 一本被反复增加过内容的笔记本，纸张上不同的字体说明它已几经易手。它似乎永远在等待着下一位记录者。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002D9.title: "Obtain Black Current Tree Sea Notes"
	quest.C3000000000002DA.title: "Basic Iot Terminal"
	quest.C3000000000002DA.quest_subtitle: "Exploration"
	quest.C3000000000002DA.quest_desc: ["Original effect: 探索2个诡意行商或秘境行商后，获得【高级物联终端】", "Description: 据说是一个可将万物连接起来的终端设备，从此与万物心意相通不再是问题。你难道不想知道你家的冰箱在想什么吗？", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002DA.title: "Obtain Basic Iot Terminal"
	quest.C3000000000002E1.title: "Sand Table Alpha"
	quest.C3000000000002E1.quest_subtitle: "Exploration"
	quest.C3000000000002E1.quest_desc: ["Original effect: 我方单位部署费用+2，让探索开启不同的方向，同时持有【沙盘β】可以揭示源阶方的所在位置", "Description: 来自梅兰德基金会的特殊信息，保密等级相当高。沙盘上显示的区域似乎极难深入，或许只能根据另一方的线索二次定位后找到她。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E1.title: "Obtain Sand Table Alpha"
	quest.C3000000000002E2.title: "Sand Table Beta"
	quest.C3000000000002E2.quest_subtitle: "Exploration"
	quest.C3000000000002E2.quest_desc: ["Original effect: 我方单位部署费用+3，让探索开启不同的方向，同时持有【沙盘α】可以揭示源阶方的所在位置", "Description: 来自联合政府的特殊信息，保密等级相当高。沙盘上显示的区域似乎极难深入，或许只能根据另一方的线索二次定位后找到她。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E2.title: "Obtain Sand Table Beta"
	quest.C3000000000002E3.title: "Heart Stirring Beacon"
	quest.C3000000000002E3.quest_subtitle: "Exploration"
	quest.C3000000000002E3.quest_desc: ["Original effect: 所有敌人的生命+20%，我方单位的生命-40%，让探索开启不同的方向", "Description: 一颗被时刻监测着的心脏，似乎正在夺走你的力量。调整至某个方向后，它微弱地跳动了起来。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E3.title: "Obtain Heart Stirring Beacon"
	quest.C3000000000002E4.title: "Bring Down The God"
	quest.C3000000000002E4.quest_subtitle: "Exploration"
	quest.C3000000000002E4.quest_desc: ["Original effect: 可以在特殊节点中，使“玻利瓦尔，症结之核”首次释放“灾厄之口”时不摧毁“危朽”", "Description: 日志：未确认的异常个体入侵，非预期的错误。监测到对居民与建筑的破坏行为，严重不利于后续发展，优先确保乌托邦依照原计划正常运行，阻击目标。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E4.title: "Obtain Bring Down The God"
	quest.C3000000000002E5.title: "Annihilate The Light"
	quest.C3000000000002E5.quest_subtitle: "Exploration"
	quest.C3000000000002E5.quest_desc: ["Original effect: 可以在特殊节点中，使“玻利瓦尔，症结之核”的“灾厄之口”伤害降低", "Description: 日志：未确认的异常个体入侵，非预期的错误。监测到非自然的灾害肆虐，严重不利于后续发展，优先确保乌托邦依照原计划正常运行，阻击目标。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E5.title: "Obtain Annihilate The Light"
	quest.C3000000000002E6.title: "Burn Down Civilization"
	quest.C3000000000002E6.quest_subtitle: "Exploration"
	quest.C3000000000002E6.quest_desc: ["Original effect: 可以在特殊节点中，使“玻利瓦尔，症结之核”的“灾厄之口”无法封锁待部署区", "Description: 日志：未确认的异常个体入侵，非预期的错误。监测到对认知根基的干涉，严重不利于后续发展，优先确保乌托邦依照原计划正常运行，阻击目标。", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C4000000000002E6.title: "Obtain Burn Down Civilization"
	quest.C100000000000007.title: "Squad and Recruitment"
	quest.C100000000000007.quest_subtitle: "Contains 161 collectibles."
	quest.C100000000000007.quest_desc: ["Primarily affects Hope, recruitment, deployment, or squad building.", "Contains 161 collectibles."]
	task.C200000000000007.title: "Read category guide"
