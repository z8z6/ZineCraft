	quest.C300000000000078.title: "Stalwart Aid Diligence"
	quest.C300000000000078.quest_subtitle: "Offense"
	quest.C300000000000078.quest_desc: ["Original effect: The SP Cost of Supporter Operators' skills is decreased by -40%.", "Description: Operators tend to give it their all, even to tasks that might seem trivial. The reality is, those tasks are not trivial at all.", "Equip in any accessory slot; see the item tooltip and Abilities panel for the Minecraft effect."]
	task.C400000000000078.title: "Obtain Stalwart Aid Diligence"
