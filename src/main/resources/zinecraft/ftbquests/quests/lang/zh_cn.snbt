{
	chapter.5A494E4543524146.title: "Zinecraft：泰拉远征"
	quest.1000000000000001.title: "远征手册"
	quest.1000000000000001.quest_subtitle: "维度、国家群系与武器指引"
	quest.1000000000000001.quest_desc: ["新玩家会直接出生在泰拉。本章会引导你踏访十九个国家群系、前往萨米唯一星门并进入主世界，随后掌握 Zinecraft 的剑、枪械与法杖。\n\n勾选下方任务开始远征。"]
	quest.1000000000000002.title: "前往萨米星门"
	quest.1000000000000002.quest_desc: ["前往 zinecraft:sami_frozen_forest。泰拉唯一一座星门固定坐落在萨米，地图坐标约为 X=-23008、Z=-40000；JourneyMap 会显示萨米的国家边界和名称。"]
	quest.1000000000000003.title: "激活并前往主世界"
	quest.1000000000000003.quest_desc: ["用源石、晶体电子单元和全新装置合成协议源石。手持协议源石右键星门协议控制器；认证成功后青色事件视界才会建立，协议源石作为密钥不会被消耗。踏入事件视界即可单向前往 minecraft:overworld 的出生区域。"]

	quest.2000000000000001.title: "阿戈尔深海"
	quest.2000000000000001.quest_desc: ["深渊岩板海床与耐压墙砖聚居区。这里可见海豚，并分布着阿戈尔主题聚落与地标。"]
	quest.2000000000000002.title: "玻利瓦尔平原"
	quest.2000000000000002.quest_desc: ["战争侵蚀的战蚀土平原，鹦鹉出没；多索雷斯灰泥街区与地标散布其间。"]
	quest.2000000000000003.title: "东国常暗裂谷"
	quest.2000000000000003.quest_desc: ["裂谷暗壤覆盖的幽暗山林，狐群、町屋灰泥墙与裂谷神社共同构成东国区域。"]
	quest.2000000000000004.title: "杜林地下花园"
	quest.2000000000000004.quest_desc: ["花园苔土与发光鱿鱼点亮地下花园，彩板理想城街区藏在洞穴世界之中。"]
	quest.2000000000000005.title: "哥伦比亚砂岩荒野"
	quest.2000000000000005.quest_desc: ["峡谷砂土、犰狳与装配墙板拓荒镇构成哥伦比亚边疆，科研设施是这里的重要地标。"]
	quest.2000000000000006.title: "卡西米尔骑士领"
	quest.2000000000000006.quest_desc: ["旱原草皮孕育马群与骑士城区，竞技场石砌建筑象征竞赛文化。"]
	quest.2000000000000007.title: "卡兹戴尔伤痕荒地"
	quest.2000000000000007.quest_desc: ["战痕灰烬上遍布战争痕迹、洞穴蜘蛛与装甲板萨卡兹聚落，并可发现巴别塔主题遗迹。"]
	quest.2000000000000008.title: "拉特兰圣田"
	quest.2000000000000008.quest_desc: ["冲积白垩铺成明亮圣田，蜜蜂与默认持铳的拉特兰公民生活在大理石修道院城镇附近。"]
	quest.2000000000000009.title: "莱塔尼亚暮色林"
	quest.2000000000000009.quest_desc: ["暮林腐殖土森林笼罩在暮色中，狼群、共振砖音乐城镇与双塔地标体现莱塔尼亚气质。"]
	quest.200000000000000A.title: "雷姆必拓矿业荒地"
	quest.200000000000000A.quest_desc: ["矿渣土矿场中游荡着尸壳，波纹钢板营地、铁路设施与采掘井架记录着工业开拓。"]
	quest.200000000000000B.title: "米诺斯日照丘陵"
	quest.200000000000000B.quest_desc: ["阳光照耀晒土地山坡与山羊群，英雄石砌城邦和十二英雄主题建筑坐落于丘陵之间。"]
	quest.200000000000000C.title: "萨尔贡岩漠"
	quest.200000000000000C.quest_desc: ["岩漠硬壳地中有骆驼、土坯绿洲镇与商旅设施，黄金之城主题地标隐藏在荒漠深处。"]
	quest.200000000000000D.title: "萨米冻林"
	quest.200000000000000D.quest_desc: ["冻原苔土针叶林是北极熊与祭仪石雪祀村的家园，古老祭坛散发着萨米荒野的神秘气息。"]
	quest.200000000000000E.title: "维多利亚雾岭"
	quest.200000000000000E.quest_desc: ["雾沼土高地常年多雾，羊群与工业砖城区并存，蒸汽设施和城防建筑塑造当地景观。"]
	quest.200000000000000F.title: "乌萨斯冻原"
	quest.200000000000000F.quest_desc: ["永冻土覆盖北方台地，流髑在寒风中游荡；帝国石砌城镇、矿站和石棺主题设施散布冻原。"]
	quest.2000000000000010.title: "谢拉格雪峰"
	quest.2000000000000010.quest_desc: ["圣雪岩山脊间生活着雪兔，蔓珠院石墙山村、商路与喀兰峰宗教建筑共同点缀雪峰。"]
	quest.2000000000000011.title: "叙拉古雨林"
	quest.2000000000000011.quest_desc: ["雨浸土湿林降雨丰沛，蜘蛛与家族石砌城镇共存，剧院和家族法院体现当地秩序。"]
	quest.2000000000000012.title: "炎国山林"
	quest.2000000000000012.quest_desc: ["山壤峰林中可见熊猫与青砖尚蜀山城，亭台、茶坊和玉门烽火台构成炎国景观。"]
	quest.2000000000000013.title: "伊比利亚盐风三角洲"
	quest.2000000000000013.quest_desc: ["盐壳砾石海岸承受盐风侵蚀，溺尸徘徊水域，海岸石砌城镇和灯塔守望着三角洲。"]
	quest.2000000000000020.title: "泰拉地理学家"
	quest.2000000000000020.quest_desc: ["你已经踏访全部十九个国家群系。确认完成考察并领取远征经验。"]

	quest.3000000000000001.title: "武器训练配给"
	quest.3000000000000001.quest_subtitle: "领取测试剑、步枪、弹药与法杖"
	quest.3000000000000001.quest_desc: ["Zinecraft 武器由服务端动作系统处理命中、伤害、弹药和技能效果。确认领取训练装备，随后完成三个基础训练。"]
	quest.3000000000000002.title: "剑术训练"
	quest.3000000000000002.quest_desc: ["主手持测试剑，左键发动带有前摇与有效帧的轻攻击。对一个安全目标完成练习后勾选确认。"]
	quest.3000000000000003.title: "枪械训练"
	quest.3000000000000003.quest_desc: ["测试步枪弹匣容量为 12。左键射击、右键切换瞄准，按 R 使用背包中的测试弹药装填。完成一次射击和装填后勾选确认。"]
	quest.3000000000000004.title: "法杖训练"
	quest.3000000000000004.quest_desc: ["测试法杖左键施放奥术弹，右键施放治疗之光。两种技能效果均由服务端在施法有效帧执行。完成练习后勾选确认。"]
	quest.3000000000000005.title: "TaCZ 枪械适配"
	quest.3000000000000005.quest_subtitle: "可选：需要外部 TaCZ 枪包资源"
	quest.3000000000000005.quest_desc: ["Zinecraft 会加载兼容 TaCZ 枪包，并将每把枪映射为带数据组件的 zinecraft:tacz_gun。左键射击、右键瞄准、R 装填、B 切换模式、X 检视、V 枪械近战。\n\n此任务为可选项；没有安装枪包资源时不会阻塞主线。"]
	quest.3000000000000006.title: "基础武器认证"
	quest.3000000000000006.quest_desc: ["剑、枪械与法杖训练均已完成。确认领取认证经验；TaCZ 适配训练仍可作为独立可选挑战继续完成。"]

	task.1100000000000001.title: "开始泰拉远征"
	task.2100000000000020.title: "提交完整考察记录"
	task.3100000000000001.title: "领取训练装备"
	task.3100000000000003.title: "我已完成轻攻击练习"
	task.3100000000000005.title: "我已完成射击与装填"
	task.3100000000000007.title: "我已完成两种法术练习"
	task.3100000000000009.title: "我已测试 TaCZ 枪械动作"
	task.310000000000000A.title: "提交基础武器认证"

	chapter.54455252414E4554.title: "泰拉国家关系网"
	quest.4000000000000000.title: "关系网图例"
	quest.4000000000000000.quest_subtitle: "点击国家标志查看外交与国力数据"
	quest.4000000000000000.quest_desc: ["每个节点代表一个国家；连线表示 TerraNationRelations 中具有 PRTS 明确依据的重要双边关系。没有连线表示采用中立默认值，或目前缺少足够明确的资料。\n\n节点数据顺序：繁荣 / 稳定 / 军力 / 开放 / 战争倾向。关系数据顺序：好感 / 战争欲望 / 贸易 / 紧张 / 信任。数值范围为 0—100；好感和信任范围为 -100—100。\n\n注意：连线颜色只表示 FTB 任务查看进度，并不表示外交关系正负。国家数据与关系分数是面向玩法的推定初始值，史实依据来自 PRTS。"]
	task.4100000000000000.title: "我已了解关系网图例"

	quest.4000000000000001.title: "阿戈尔"
	quest.4000000000000001.quest_subtitle: "繁荣72 / 稳定50 / 军力80 / 开放10 / 战争倾向15"
	quest.4000000000000001.quest_desc: ["国家状态：深海技术高度发达，但对陆上国家保持封闭。\n\n重要关系：\n• 伊比利亚：-25 / 10 / 18 / 52 / -45（技术转移；大静谧后的隔阂）"]
	quest.4000000000000002.title: "玻利瓦尔"
	quest.4000000000000002.quest_subtitle: "繁荣35 / 稳定20 / 军力45 / 开放55 / 战争倾向55"
	quest.4000000000000002.quest_desc: ["国家状态：长期割据与代理冲突显著压低稳定和繁荣。\n\n重要关系：\n• 哥伦比亚：-55 / 72 / 25 / 85 / -65（活跃冲突、代理战争）\n• 莱塔尼亚：25 / 22 / 55 / 55 / 15（投资、代理冲突）"]
	quest.4000000000000003.title: "东国"
	quest.4000000000000003.quest_subtitle: "繁荣62 / 稳定40 / 军力60 / 开放45 / 战争倾向40"
	quest.4000000000000003.quest_desc: ["国家状态：内部局势复杂，并承受来自北方强权的历史压力。\n\n重要关系：\n• 乌萨斯：-60 / 68 / 12 / 82 / -70（历史战争、边境紧张）"]
	quest.4000000000000004.title: "杜林"
	quest.4000000000000004.quest_subtitle: "繁荣82 / 稳定80 / 军力35 / 开放55 / 战争倾向15"
	quest.4000000000000004.quest_desc: ["国家状态：地下城市富足稳定，军事扩张意愿较低。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000005.title: "哥伦比亚"
	quest.4000000000000005.quest_subtitle: "繁荣88 / 稳定72 / 军力85 / 开放90 / 战争倾向65"
	quest.4000000000000005.quest_desc: ["国家状态：经济、科技和军力强劲，对外开放同时具有明显扩张性。\n\n重要关系：\n• 玻利瓦尔：-55 / 72 / 25 / 85 / -65（代理战争）\n• 莱塔尼亚：-40 / 52 / 35 / 72 / -45（代理竞争）\n• 谢拉格：32 / 8 / 72 / 20 / 25（投资、贸易）\n• 维多利亚：-28 / 28 / 62 / 58 / -30（贸易、边境紧张）"]
	quest.4000000000000006.title: "卡西米尔"
	quest.4000000000000006.quest_subtitle: "繁荣78 / 稳定65 / 军力72 / 开放75 / 战争倾向45"
	quest.4000000000000006.quest_desc: ["国家状态：商业繁荣且军事实力可观，长期面对北方边境压力。\n\n重要关系：\n• 乌萨斯：-65 / 78 / 12 / 85 / -72（历史战争、边境紧张）"]
	quest.4000000000000007.title: "卡兹戴尔"
	quest.4000000000000007.quest_subtitle: "繁荣30 / 稳定30 / 军力88 / 开放35 / 战争倾向70"
	quest.4000000000000007.quest_desc: ["国家状态：繁荣与稳定偏低，但军事能力和冲突倾向很高。\n\n重要关系：\n• 维多利亚：-65 / 48 / 8 / 72 / -78（历史战争、占领）\n• 拉特兰→卡兹戴尔：-72 / 18 / 2 / 75 / -80（外交排斥；单向政策）"]
	quest.4000000000000008.title: "拉特兰"
	quest.4000000000000008.quest_subtitle: "繁荣85 / 稳定88 / 军力78 / 开放82 / 战争倾向12"
	quest.4000000000000008.quest_desc: ["国家状态：高度繁荣稳定，常承担国际见证与调解角色。\n\n重要关系：\n• 伊比利亚：20 / 4 / 42 / 22 / 18（宗教联系、调解）\n• 卡兹戴尔：-72 / 18 / 2 / 75 / -80（外交排斥；拉特兰单向政策）"]
	quest.4000000000000009.title: "莱塔尼亚"
	quest.4000000000000009.quest_subtitle: "繁荣80 / 稳定70 / 军力82 / 开放65 / 战争倾向35"
	quest.4000000000000009.quest_desc: ["国家状态：综合国力强盛，通过投资与代理势力影响周边。\n\n重要关系：\n• 玻利瓦尔：25 / 22 / 55 / 55 / 15（投资、代理冲突）\n• 哥伦比亚：-40 / 52 / 35 / 72 / -45（代理竞争）\n• 谢拉格：28 / 6 / 65 / 16 / 24（投资、贸易）"]
	quest.400000000000000A.title: "雷姆必拓"
	quest.400000000000000A.quest_subtitle: "繁荣72 / 稳定75 / 军力45 / 开放85 / 战争倾向20"
	quest.400000000000000A.quest_desc: ["国家状态：矿业经济活跃、对外开放，扩张与战争倾向较低。\n\n重要关系：\n• 谢拉格：42 / 4 / 80 / 12 / 38（投资、贸易）"]
	quest.400000000000000B.title: "米诺斯"
	quest.400000000000000B.quest_subtitle: "繁荣60 / 稳定68 / 军力62 / 开放55 / 战争倾向30"
	quest.400000000000000B.quest_desc: ["国家状态：整体温和稳定，国力处于中游。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.400000000000000C.title: "萨尔贡"
	quest.400000000000000C.quest_subtitle: "繁荣65 / 稳定60 / 军力70 / 开放70 / 战争倾向40"
	quest.400000000000000C.quest_desc: ["国家状态：疆域广阔、贸易开放，军力与冲突倾向处于中上水平。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.400000000000000D.title: "萨米"
	quest.400000000000000D.quest_subtitle: "繁荣38 / 稳定70 / 军力75 / 开放25 / 战争倾向15"
	quest.400000000000000D.quest_desc: ["国家状态：对外封闭而防卫能力较强，主动战争倾向低。\n\n重要关系：\n• 乌萨斯：-58 / 72 / 8 / 80 / -68（历史战争、边境紧张）"]
	quest.400000000000000E.title: "维多利亚"
	quest.400000000000000E.quest_subtitle: "繁荣76 / 稳定40 / 军力90 / 开放72 / 战争倾向55"
	quest.400000000000000E.quest_desc: ["国家状态：军力强大且经济开放，但内部局势削弱稳定。\n\n重要关系：\n• 卡兹戴尔：-65 / 48 / 8 / 72 / -78（历史战争、占领）\n• 谢拉格：38 / 6 / 62 / 16 / 32（投资、贸易）\n• 哥伦比亚：-28 / 28 / 62 / 58 / -30（贸易、边境紧张）"]
	quest.400000000000000F.title: "乌萨斯"
	quest.400000000000000F.quest_subtitle: "繁荣55 / 稳定38 / 军力92 / 开放30 / 战争倾向85"
	quest.400000000000000F.quest_desc: ["国家状态：军力和战争倾向极高，对外开放与内部稳定偏低。\n\n重要关系：\n• 卡西米尔：-65 / 78 / 12 / 85 / -72\n• 萨米：-58 / 72 / 8 / 80 / -68\n• 东国：-60 / 68 / 12 / 82 / -70\n以上均属于历史战争与边境紧张。"]
	quest.4000000000000010.title: "谢拉格"
	quest.4000000000000010.quest_subtitle: "繁荣58 / 稳定72 / 军力48 / 开放52 / 战争倾向20"
	quest.4000000000000010.quest_desc: ["国家状态：整体稳定、战争倾向低，正通过改革逐步扩大对外联系。\n\n重要关系：\n• 维多利亚：38 / 6 / 62 / 16 / 32\n• 哥伦比亚：32 / 8 / 72 / 20 / 25\n• 莱塔尼亚：28 / 6 / 65 / 16 / 24\n• 雷姆必拓：42 / 4 / 80 / 12 / 38\n以上均以投资和贸易为主。"]
	quest.4000000000000011.title: "叙拉古"
	quest.4000000000000011.quest_subtitle: "繁荣70 / 稳定55 / 军力65 / 开放72 / 战争倾向45"
	quest.4000000000000011.quest_desc: ["国家状态：贸易开放且经济活跃，家族秩序使稳定与冲突倾向并存。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000012.title: "炎国"
	quest.4000000000000012.quest_subtitle: "繁荣88 / 稳定88 / 军力90 / 开放60 / 战争倾向20"
	quest.4000000000000012.quest_desc: ["国家状态：繁荣、稳定和军力均处高位，主动战争倾向较低。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000013.title: "伊比利亚"
	quest.4000000000000013.quest_subtitle: "繁荣32 / 稳定52 / 军力65 / 开放15 / 战争倾向25"
	quest.4000000000000013.quest_desc: ["国家状态：大静谧后繁荣与开放显著下降，仍保有一定军事实力。\n\n重要关系：\n• 阿戈尔：-48 / 24 / 12 / 68 / -62（技术转移、外交排斥）\n• 拉特兰：20 / 4 / 42 / 22 / 18（宗教联系、调解）"]

	chapter_group.4E4154494F4E5347.title: "泰拉国家档案"
	chapter.4E4154494F4E5343.title: "十九国与特色建筑"
	quest.5000000000000000.title: "阅读说明"
	quest.5000000000000000.quest_subtitle: "PRTS 国家资料与 Zinecraft 玩法实现分开呈现"
	quest.5000000000000000.quest_desc: ["本章节按 PRTS“泰拉大典”当前收录的十九个国家排列。每个节点先标明资料条目，再列出 Zinecraft 为对应国家实现的群系、可重复生成聚落和两座每世界唯一地标。\n\n建筑与地貌属于基于资料的 Minecraft 玩法化表达，不应视为《明日方舟》官方场景复刻。"]
	task.5100000000000000.title: "我已了解资料与玩法实现的边界"
	quest.5000000000000001.title: "阿戈尔"
	quest.5000000000000001.quest_subtitle: "深海国家资料与耐压建筑"
	quest.5000000000000001.quest_desc: ["PRTS 条目：泰拉大典:地理/阿戈尔。\n\nZinecraft 实现：阿戈尔深渊海；阿戈尔海下飞地（压力住宅、水培实验室、深潜码头、海流档案馆）；火山能源信标、深海观测穹顶。"]
	quest.5000000000000002.title: "玻利瓦尔"
	quest.5000000000000002.quest_subtitle: "西北平原、多索雷斯与长期冲突"
	quest.5000000000000002.quest_desc: ["PRTS：玻利瓦尔位于泰拉大陆西北部，与哥伦比亚接壤；进入结晶时代后，双方因矿石开采范围重叠而发生冲突。\n\nZinecraft 实现：玻利瓦尔平原；多索雷斯街区；多索雷斯游艇、极限铁人赛检查站。"]
	quest.5000000000000003.title: "东"
	quest.5000000000000003.quest_subtitle: "东国资料与裂谷城镇"
	quest.5000000000000003.quest_desc: ["PRTS 条目：泰拉大典:地理/东。\n\nZinecraft 实现：东国暗影裂谷；锁川町（町屋、锻刀铺、茶屋、奉行所）；常暗裂谷神社、锁川边境望楼。"]
	quest.5000000000000004.title: "杜林"
	quest.5000000000000004.quest_subtitle: "地下国家资料与理想城建筑"
	quest.5000000000000004.quest_desc: ["PRTS 条目：泰拉大典:地理/杜林。\n\nZinecraft 实现：杜林地下花园；理想城街区（穹顶公寓、机械工坊、游戏厅、轨道站）；际崖城穹顶车站、大水坑水上乐园。"]
	quest.5000000000000005.title: "哥伦比亚"
	quest.5000000000000005.quest_subtitle: "哥伦比亚资料与拓荒建筑"
	quest.5000000000000005.quest_desc: ["PRTS 条目：泰拉大典:地理/哥伦比亚。\n\nZinecraft 实现：哥伦比亚砂岩荒野；拓荒小镇（装配住宅、拓荒实验室、物流仓库、治安所）；拓荒区科研站、移动监狱补给站。"]
	quest.5000000000000006.title: "卡西米尔"
	quest.5000000000000006.quest_subtitle: "骑士之国资料与竞技建筑"
	quest.5000000000000006.quest_desc: ["PRTS 条目：泰拉大典:地理/卡西米尔。\n\nZinecraft 实现：卡西米尔骑士领；骑士街区（公寓、甲胄工坊、赞助商店、竞赛旅店）；大骑士竞技场门楼、征战骑士纪念碑。"]
	quest.5000000000000007.title: "卡兹戴尔"
	quest.5000000000000007.quest_subtitle: "萨卡兹国家资料与战痕建筑"
	quest.5000000000000007.quest_desc: ["PRTS 条目：泰拉大典:地理/卡兹戴尔。\n\nZinecraft 实现：卡兹戴尔战痕荒原；萨卡兹聚落（帐屋、铸炉、佣兵会所、补给铺）；巴别塔遗迹、萨卡兹流动营地。"]
	quest.5000000000000008.title: "拉特兰"
	quest.5000000000000008.quest_subtitle: "拉特兰资料与圣城建筑"
	quest.5000000000000008.quest_desc: ["PRTS 条目：拉特兰。\n\nZinecraft 实现：拉特兰圣田；修道院城镇（白石住宅、甜品店、公证所、钟楼礼拜堂）；启示石塔、安布罗修礼拜堂；中心地下另有拉特兰主机。"]
	quest.5000000000000009.title: "莱塔尼亚"
	quest.5000000000000009.quest_subtitle: "莱塔尼亚资料与音乐建筑"
	quest.5000000000000009.quest_desc: ["PRTS 条目：泰拉大典:地理/莱塔尼亚。\n\nZinecraft 实现：莱塔尼亚暮光森林；音乐城镇（暮色住宅、乐器工坊、排练厅、艺术学院）；崔林特尔梅双塔、夕照音乐厅。"]
	quest.500000000000000A.title: "雷姆必拓"
	quest.500000000000000A.quest_subtitle: "矿业国家资料与工业建筑"
	quest.500000000000000A.quest_desc: ["PRTS 条目：泰拉大典:地理/雷姆必拓。\n\nZinecraft 实现：雷姆必拓矿业恶地；采矿营地（矿工宿舍、矿石工坊、货运站、食堂）；源石矿井架、矿石运输铁路站。"]
	quest.500000000000000B.title: "米诺斯"
	quest.500000000000000B.quest_subtitle: "米诺斯资料与英雄建筑"
	quest.500000000000000B.quest_desc: ["PRTS 条目：泰拉大典:地理/米诺斯。\n\nZinecraft 实现：米诺斯日照丘陵；英雄城邦（院落住宅、橄榄市场、训练厅、议事厅）；十二英雄神殿、科林尼亚英雄广场。"]
	quest.500000000000000C.title: "萨尔贡"
	quest.500000000000000C.quest_subtitle: "萨尔贡资料与绿洲建筑"
	quest.500000000000000C.quest_desc: ["PRTS 条目：泰拉大典:地理/萨尔贡。\n\nZinecraft 实现：萨尔贡岩漠；绿洲城镇（土坯住宅、香料市场、商旅驿站、水井房）；黄金之城宝石集市、长泉镇古井。"]
	quest.500000000000000D.title: "萨米"
	quest.500000000000000D.quest_subtitle: "萨米资料与雪祀建筑"
	quest.500000000000000D.quest_desc: ["PRTS 条目：泰拉大典:地理/萨米。\n\nZinecraft 实现：萨米冻林；雪祀村落（雪屋、猎人营地、仪式屋、补给棚）；独眼巨人祭坛、雪祀仪式屋。"]
	quest.500000000000000E.title: "维多利亚"
	quest.500000000000000E.quest_subtitle: "维多利亚资料与工业建筑"
	quest.500000000000000E.quest_desc: ["PRTS 条目：泰拉大典:地理/维多利亚。\n\nZinecraft 实现：维多利亚迷雾高地；工业街区（砖砌公寓、蒸汽工坊、铁路仓库、市政厅）；伦蒂尼姆城防炮、蒸汽铁路站。"]
	quest.500000000000000F.title: "乌萨斯"
	quest.500000000000000F.quest_subtitle: "乌萨斯资料与北地建筑"
	quest.500000000000000F.quest_desc: ["PRTS 条目：泰拉大典:地理/乌萨斯。\n\nZinecraft 实现：乌萨斯冻原；北方城镇（保温住宅、军需仓库、矿务所、公共大厅）；切尔诺伯格石棺站、远北矿区哨塔。"]
	quest.5000000000000010.title: "谢拉格"
	quest.5000000000000010.quest_subtitle: "雪境国家资料与喀兰建筑"
	quest.5000000000000010.quest_desc: ["PRTS 条目：泰拉大典:地理/谢拉格。\n\nZinecraft 实现：谢拉格雪峰；山地村落（石木民居、茶坊、商队驿站、祭祀屋）；喀兰峰蔓珠院、圣山大典广场。"]
	quest.5000000000000011.title: "叙拉古"
	quest.5000000000000011.quest_subtitle: "叙拉古资料与家族建筑"
	quest.5000000000000011.quest_desc: ["PRTS 条目：叙拉古。\n\nZinecraft 实现：叙拉古雨林；家族城镇（家族住宅、餐馆、裁缝铺、议事厅）；家族联合法院、家族歌剧院。"]
	quest.5000000000000012.title: "炎"
	quest.5000000000000012.quest_subtitle: "炎国资料与尚蜀、玉门建筑"
	quest.5000000000000012.quest_desc: ["PRTS 条目：泰拉大典:地理/炎。\n\nZinecraft 实现：炎国山林；尚蜀城镇（院落住宅、茶馆、百工坊、驿站）；玉门烽火台、尚蜀山间亭。"]
	quest.5000000000000013.title: "伊比利亚"
	quest.5000000000000013.quest_subtitle: "伊比利亚资料与海岸建筑"
	quest.5000000000000013.quest_desc: ["PRTS 条目：泰拉大典:地理/伊比利亚。\n\nZinecraft 实现：伊比利亚盐碱三角洲；海岸城镇（盐石住宅、造船坊、鱼市、审判庭办事处）；伊比利亚之眼灯塔、盐风城审判庭礼拜堂。"]

	chapter_group.444556454C4F5047.title: "开发与模组"
	chapter.4445564D4F445343.title: "开发环境模组说明"
	quest.6000000000000000.title: "Zinecraft 开发环境"
	quest.6000000000000000.quest_subtitle: "区分发布依赖、传递依赖与开发辅助模组"
	quest.6000000000000000.quest_desc: ["本章节列出当前 Gradle 开发运行环境中加载的主要模组。发布必需依赖负责玩法与数据；传递依赖由上层模组带入；开发辅助模组只用于 runClient 调试，不会打入 Zinecraft JAR。"]
	task.6100000000000000.title: "我已了解依赖分类"
	quest.6000000000000001.title: "平台与世界生成"
	quest.6000000000000001.quest_desc: ["Minecraft 1.21.1；NeoForge 21.1.244；TerraBlender 4.1.0.8。\n\nNeoForge 提供模组平台，TerraBlender 参与群系与世界生成接入。"]
	quest.6000000000000002.title: "机械动力生态"
	quest.6000000000000002.quest_desc: ["Create 6.0.10、Ponder 1.0.82、Flywheel 1.0.6、Registrate 1.3.0+67。\n\nCreate 提供机械动力内容；Ponder 用于演示场景；Flywheel 与 Registrate 是其运行和注册体系。"]
	quest.6000000000000003.title: "任务系统"
	quest.6000000000000003.quest_desc: ["FTB Quests 2101.1.27，并由 FTB Library 与 FTB Teams 提供界面、数据及团队进度支持。Zinecraft 内置任务模板由安装器合并到 config/ftbquests/quests。"]
	quest.6000000000000004.title: "饰品与藏品"
	quest.6000000000000004.quest_desc: ["Curios 9.5.1+1.21.1 提供饰品能力。Zinecraft 的集成战略藏品属于 relic 槽物品，当前为玩家配置 20 个藏品栏位。"]
	quest.6000000000000005.title: "配置与基础库"
	quest.6000000000000005.quest_desc: ["Cloth Config 15.0.140 提供配置界面能力；Architectury 与 Common Networking 等由现有模组作为传递依赖加载。项目源码与运行时现已统一为 Java，不再携带额外的语言运行库。"]
	quest.6000000000000006.title: "仅开发环境辅助模组"
	quest.6000000000000006.quest_desc: ["JEI 19.27.0.340、Just Enough Resources 1.6.0.17、AppleSkin 3.0.9、Jade 15.10.5、Just Enough Characters 4.5.22、JourneyMap 6.0.1、Nature's Compass 3.4.0 与 Explorer's Compass 3.4.0。\n\n它们分别用于物品与资源查询、饱食信息、方块信息、拼音搜索、地图调试，以及定位群系和结构，只作为开发运行依赖。"]


	chapter.534B494C4C534348.title: "干员技能"
	quest.D100000000000000.title: "干员技能训练"
	quest.D100000000000000.quest_subtitle: "查看技能资料与 Ponder 演示"
	quest.D100000000000000.quest_desc: ["本章收录当前已注册的九种干员技能物品。", "将鼠标移到技能物品上并按住 Ponder 键，可以查看对应机制演示。", "演示用于说明 Minecraft 机制化表达，不直接参与服务端伤害结算。"]
	task.D200000000000000.title: "阅读技能训练说明"
	quest.D300000000000001.title: "桃金娘：支援号令·β型"
	quest.D300000000000001.quest_subtitle: "先锋 · 自动回复 · 手动触发"
	quest.D300000000000001.quest_desc: ["初始技力 13 · 技力消耗 22 · 持续 8 秒", "停止攻击，并在持续时间内逐步回复部署费用。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000001.title: "持有支援号令·β型"
	task.D500000000000001.title: "确认已查看技能演示"
	quest.D300000000000002.title: "银灰：真银斩"
	quest.D300000000000002.quest_subtitle: "近卫 · 自动回复 · 手动触发"
	quest.D300000000000002.quest_desc: ["初始技力 75 · 技力消耗 90 · 持续 30 秒", "降低自身防御，大幅提高攻击并扩大范围，同时攻击至多六个目标。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000002.title: "持有真银斩"
	task.D500000000000002.title: "确认已查看技能演示"
	quest.D300000000000003.title: "能天使：过载模式"
	quest.D300000000000003.quest_subtitle: "狙击 · 自动回复 · 自动触发"
	quest.D300000000000003.quest_desc: ["初始技力 20 · 技力消耗 30 · 持续 15 秒", "自动开启，攻击变为五连射并缩短攻击间隔。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000003.title: "持有过载模式"
	task.D500000000000003.title: "确认已查看技能演示"
	quest.D300000000000004.title: "维什戴尔：爆裂黎明"
	quest.D300000000000004.quest_subtitle: "狙击 · 自动回复 · 手动触发"
	quest.D300000000000004.quest_desc: ["初始技力 40 · 技力消耗 50 · 弹药技能", "立刻在攻击范围内召唤2个魂灵之影（最多存在3个，技能结束后保留），攻击力+180%，攻击间隔大幅增大，攻击时攻击力提升至220%，溅射范围大幅扩大且第一天赋的发动概率提高至100%。攻击装有6发弹药，打完后结束（可随时停止技能）。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000004.title: "持有爆裂黎明"
	task.D500000000000004.title: "确认已查看技能演示"
	quest.D300000000000005.title: "艾雅法拉：火山"
	quest.D300000000000005.quest_subtitle: "术师 · 自动回复 · 手动触发"
	quest.D300000000000005.quest_desc: ["初始技力 55 · 技力消耗 80 · 持续 15 秒", "攻击范围扩大并快速向范围内至多六个敌人发射熔岩。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000005.title: "持有火山"
	task.D500000000000005.title: "确认已查看技能演示"
	quest.D300000000000006.title: "塞雷娅：钙质化"
	quest.D300000000000006.quest_subtitle: "重装 · 自动回复 · 手动触发"
	quest.D300000000000006.quest_desc: ["初始技力 70 · 技力消耗 80 · 持续 30 秒", "持续治疗附近友方，同时使附近敌人减速并更易受到法术伤害。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000006.title: "持有钙质化"
	task.D500000000000006.title: "确认已查看技能演示"
	quest.D300000000000007.title: "夜莺：圣域"
	quest.D300000000000007.quest_subtitle: "医疗 · 自动回复 · 手动触发"
	quest.D300000000000007.quest_desc: ["初始技力 115 · 技力消耗 120 · 持续 60 秒", "扩大治疗范围并强化攻击，使范围内友方获得法术抗性与法术闪避。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000007.title: "持有圣域"
	task.D500000000000007.title: "确认已查看技能演示"
	quest.D300000000000008.title: "铃兰：狐火渺然"
	quest.D300000000000008.quest_subtitle: "辅助 · 自动回复 · 手动触发"
	quest.D300000000000008.quest_desc: ["初始技力 50 · 技力消耗 70 · 持续 35 秒", "停止攻击，扩大范围，使敌人停顿并持续恢复范围内友方生命。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
	task.D400000000000008.title: "持有狐火渺然"
	task.D500000000000008.title: "确认已查看技能演示"
	quest.D300000000000009.title: "红：狼群"
	quest.D300000000000009.quest_subtitle: "特种 · 被动 · 部署触发"
	quest.D300000000000009.quest_desc: ["初始技力 0 · 技力消耗 0 · 无持续时间", "部署后立即伤害周围所有地面敌人，并使命中目标晕眩三秒。", "持有技能物品，并查看对应 Ponder 演示后手动确认。"]
