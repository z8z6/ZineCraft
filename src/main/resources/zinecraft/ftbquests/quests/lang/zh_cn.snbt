{
	chapter.5A494E4543524146.title: "Zinecraft：泰拉远征"
	quest.1000000000000001.title: "远征手册"
	quest.1000000000000001.quest_subtitle: "维度、国家群系与武器指引"
	quest.1000000000000001.quest_desc: ["本章会引导你寻找主世界星门、进入泰拉维度、踏访十九个国家群系，并掌握 Zinecraft 的剑、枪械与法杖。\n\n勾选下方任务开始远征。"]
	quest.1000000000000002.title: "寻找雪原星门"
	quest.1000000000000002.quest_desc: ["星门遗迹只会自然生成于主世界的雪原群系。找到 minecraft:snowy_plains，随后在雪原中搜索星门的青色事件视界。"]
	quest.1000000000000003.title: "穿越星门"
	quest.1000000000000003.quest_desc: ["踏入星门即可前往 zinecraft:terra。泰拉使用类主世界地形与昼夜规则，但群系源只包含十九个泰拉国家群系。返回时再次进入泰拉侧星门。"]

	quest.2000000000000001.title: "阿戈尔深海"
	quest.2000000000000001.quest_desc: ["暗海晶石海床与深海聚居区。这里可见海豚，并分布着阿戈尔主题聚落与地标。"]
	quest.2000000000000002.title: "玻利瓦尔平原"
	quest.2000000000000002.quest_desc: ["战争侵蚀的砂土平原，鹦鹉出没；多索雷斯风格街区与地标散布其间。"]
	quest.2000000000000003.title: "东国常暗裂谷"
	quest.2000000000000003.quest_desc: ["灰化土覆盖的幽暗山林，狐群、锁川町与裂谷神社共同构成东国区域。"]
	quest.2000000000000004.title: "杜林地下花园"
	quest.2000000000000004.quest_desc: ["苔藓与发光鱿鱼点亮地下花园，理想城街区藏在洞穴世界之中。"]
	quest.2000000000000005.title: "哥伦比亚砂岩荒野"
	quest.2000000000000005.quest_desc: ["红砂峡谷、犰狳与拓荒镇构成哥伦比亚边疆，科研设施是这里的重要地标。"]
	quest.2000000000000006.title: "卡西米尔骑士领"
	quest.2000000000000006.quest_desc: ["辽阔草原孕育马群与骑士城区，大骑士竞技场风格建筑象征竞赛文化。"]
	quest.2000000000000007.title: "卡兹戴尔伤痕荒地"
	quest.2000000000000007.quest_desc: ["黑石废土上遍布战争痕迹、洞穴蜘蛛与萨卡兹聚落，并可发现巴别塔主题遗迹。"]
	quest.2000000000000008.title: "拉特兰圣田"
	quest.2000000000000008.quest_desc: ["方解石铺成明亮圣田，蜜蜂与默认持铳的拉特兰公民生活在修道院城镇附近。"]
	quest.2000000000000009.title: "莱塔尼亚暮色林"
	quest.2000000000000009.quest_desc: ["盘根森林笼罩在暮色中，狼群、音乐城镇与双塔地标体现莱塔尼亚气质。"]
	quest.200000000000000A.title: "雷姆必拓矿业荒地"
	quest.200000000000000A.quest_desc: ["陶土矿场中游荡着尸壳，矿业营地、铁路设施与采掘井架记录着工业开拓。"]
	quest.200000000000000B.title: "米诺斯日照丘陵"
	quest.200000000000000B.quest_desc: ["阳光照耀夯土山坡与山羊群，英雄城邦和十二英雄主题建筑坐落于丘陵之间。"]
	quest.200000000000000C.title: "萨尔贡岩漠"
	quest.200000000000000C.quest_desc: ["炽热沙海中有骆驼、绿洲镇与商旅设施，黄金之城主题地标隐藏在岩漠深处。"]
	quest.200000000000000D.title: "萨米冻林"
	quest.200000000000000D.quest_desc: ["积雪针叶林是北极熊与雪祀村的家园，古老祭坛散发着萨米荒野的神秘气息。"]
	quest.200000000000000E.title: "维多利亚雾岭"
	quest.200000000000000E.quest_desc: ["泥泞高地常年多雾，羊群与工业城区并存，蒸汽设施和城防建筑塑造当地景观。"]
	quest.200000000000000F.title: "乌萨斯冻原"
	quest.200000000000000F.quest_desc: ["坚冰覆盖北方台地，流髑在寒风中游荡；城镇、矿站和石棺主题设施散布冻原。"]
	quest.2000000000000010.title: "谢拉格雪峰"
	quest.2000000000000010.quest_desc: ["蓝冰山脊间生活着雪兔，山村、商路与喀兰峰宗教建筑共同点缀雪峰。"]
	quest.2000000000000011.title: "叙拉古雨林"
	quest.2000000000000011.quest_desc: ["苔石湿林降雨丰沛，蜘蛛与家族城镇共存，剧院和家族法院体现当地秩序。"]
	quest.2000000000000012.title: "炎国山林"
	quest.2000000000000012.quest_desc: ["凝灰岩峰林中可见熊猫与尚蜀山城，亭台、茶坊和玉门烽火台构成炎国景观。"]
	quest.2000000000000013.title: "伊比利亚盐风三角洲"
	quest.2000000000000013.quest_desc: ["砾石海岸承受盐风侵蚀，溺尸徘徊水域，海岸镇和灯塔守望着三角洲。"]
	quest.2000000000000020.title: "泰拉地理学家"
	quest.2000000000000020.quest_desc: ["你已经踏访全部十九个国家群系。确认完成考察并领取远征经验。"]

	quest.3000000000000001.title: "武器训练配给"
	quest.3000000000000001.quest_subtitle: "领取测试剑、步枪、弹药与法杖"
	quest.3000000000000001.quest_desc: ["Zinecraft 武器由服务端动作系统处理命中、伤害、弹药和技能效果。确认领取训练装备，随后完成三个基础训练。"]
	quest.3000000000000002.title: "剑术训练"
	quest.3000000000000002.quest_desc: ["主手持测试剑，左键发动带有前摇与有效帧的轻攻击。对一个安全目标完成练习后勾选确认。"]
	quest.3000000000000003.title: "枪械训练"
	quest.3000000000000003.quest_desc: ["测试步枪弹匣容量为 12。左键射击、右键切换瞄准，按 R 使用背包中的测试弹药装填。完成一次射击和装填后勾选确认。"]
	quest.3000000000000004.title: "法杖训练"
	quest.3000000000000004.quest_desc: ["测试法杖左键施放奥术弹，右键施放治疗之光。两种技能效果均由服务端在施法有效帧执行。完成练习后勾选确认。"]
	quest.3000000000000005.title: "TaCZ 枪械适配"
	quest.3000000000000005.quest_subtitle: "可选：需要外部 TaCZ 枪包资源"
	quest.3000000000000005.quest_desc: ["Zinecraft 会加载兼容 TaCZ 枪包，并将每把枪映射为带数据组件的 zinecraft:tacz_gun。左键射击、右键瞄准、R 装填、B 切换模式、X 检视、V 枪械近战。\n\n此任务为可选项；没有安装枪包资源时不会阻塞主线。"]
	quest.3000000000000006.title: "基础武器认证"
	quest.3000000000000006.quest_desc: ["剑、枪械与法杖训练均已完成。确认领取认证经验；TaCZ 适配训练仍可作为独立可选挑战继续完成。"]

	task.1100000000000001.title: "开始泰拉远征"
	task.2100000000000020.title: "提交完整考察记录"
	task.3100000000000001.title: "领取训练装备"
	task.3100000000000003.title: "我已完成轻攻击练习"
	task.3100000000000005.title: "我已完成射击与装填"
	task.3100000000000007.title: "我已完成两种法术练习"
	task.3100000000000009.title: "我已测试 TaCZ 枪械动作"
	task.310000000000000A.title: "提交基础武器认证"

	chapter.54455252414E4554.title: "泰拉国家关系网"
	quest.4000000000000000.title: "关系网图例"
	quest.4000000000000000.quest_subtitle: "点击国家标志查看外交与国力数据"
	quest.4000000000000000.quest_desc: ["每个节点代表一个国家；连线表示 TerraNationRelations 中具有 PRTS 明确依据的重要双边关系。没有连线表示采用中立默认值，或目前缺少足够明确的资料。\n\n节点数据顺序：繁荣 / 稳定 / 军力 / 开放 / 战争倾向。关系数据顺序：好感 / 战争欲望 / 贸易 / 紧张 / 信任。数值范围为 0—100；好感和信任范围为 -100—100。\n\n注意：连线颜色只表示 FTB 任务查看进度，并不表示外交关系正负。国家数据与关系分数是面向玩法的推定初始值，史实依据来自 PRTS。"]
	task.4100000000000000.title: "我已了解关系网图例"

	quest.4000000000000001.title: "阿戈尔"
	quest.4000000000000001.quest_subtitle: "繁荣72 / 稳定50 / 军力80 / 开放10 / 战争倾向15"
	quest.4000000000000001.quest_desc: ["国家状态：深海技术高度发达，但对陆上国家保持封闭。\n\n重要关系：\n• 伊比利亚：-25 / 10 / 18 / 52 / -45（技术转移；大静谧后的隔阂）"]
	quest.4000000000000002.title: "玻利瓦尔"
	quest.4000000000000002.quest_subtitle: "繁荣35 / 稳定20 / 军力45 / 开放55 / 战争倾向55"
	quest.4000000000000002.quest_desc: ["国家状态：长期割据与代理冲突显著压低稳定和繁荣。\n\n重要关系：\n• 哥伦比亚：-55 / 72 / 25 / 85 / -65（活跃冲突、代理战争）\n• 莱塔尼亚：25 / 22 / 55 / 55 / 15（投资、代理冲突）"]
	quest.4000000000000003.title: "东国"
	quest.4000000000000003.quest_subtitle: "繁荣62 / 稳定40 / 军力60 / 开放45 / 战争倾向40"
	quest.4000000000000003.quest_desc: ["国家状态：内部局势复杂，并承受来自北方强权的历史压力。\n\n重要关系：\n• 乌萨斯：-60 / 68 / 12 / 82 / -70（历史战争、边境紧张）"]
	quest.4000000000000004.title: "杜林"
	quest.4000000000000004.quest_subtitle: "繁荣82 / 稳定80 / 军力35 / 开放55 / 战争倾向15"
	quest.4000000000000004.quest_desc: ["国家状态：地下城市富足稳定，军事扩张意愿较低。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000005.title: "哥伦比亚"
	quest.4000000000000005.quest_subtitle: "繁荣88 / 稳定72 / 军力85 / 开放90 / 战争倾向65"
	quest.4000000000000005.quest_desc: ["国家状态：经济、科技和军力强劲，对外开放同时具有明显扩张性。\n\n重要关系：\n• 玻利瓦尔：-55 / 72 / 25 / 85 / -65（代理战争）\n• 莱塔尼亚：-40 / 52 / 35 / 72 / -45（代理竞争）\n• 谢拉格：32 / 8 / 72 / 20 / 25（投资、贸易）\n• 维多利亚：-28 / 28 / 62 / 58 / -30（贸易、边境紧张）"]
	quest.4000000000000006.title: "卡西米尔"
	quest.4000000000000006.quest_subtitle: "繁荣78 / 稳定65 / 军力72 / 开放75 / 战争倾向45"
	quest.4000000000000006.quest_desc: ["国家状态：商业繁荣且军事实力可观，长期面对北方边境压力。\n\n重要关系：\n• 乌萨斯：-65 / 78 / 12 / 85 / -72（历史战争、边境紧张）"]
	quest.4000000000000007.title: "卡兹戴尔"
	quest.4000000000000007.quest_subtitle: "繁荣30 / 稳定30 / 军力88 / 开放35 / 战争倾向70"
	quest.4000000000000007.quest_desc: ["国家状态：繁荣与稳定偏低，但军事能力和冲突倾向很高。\n\n重要关系：\n• 维多利亚：-65 / 48 / 8 / 72 / -78（历史战争、占领）\n• 拉特兰→卡兹戴尔：-72 / 18 / 2 / 75 / -80（外交排斥；单向政策）"]
	quest.4000000000000008.title: "拉特兰"
	quest.4000000000000008.quest_subtitle: "繁荣85 / 稳定88 / 军力78 / 开放82 / 战争倾向12"
	quest.4000000000000008.quest_desc: ["国家状态：高度繁荣稳定，常承担国际见证与调解角色。\n\n重要关系：\n• 伊比利亚：20 / 4 / 42 / 22 / 18（宗教联系、调解）\n• 卡兹戴尔：-72 / 18 / 2 / 75 / -80（外交排斥；拉特兰单向政策）"]
	quest.4000000000000009.title: "莱塔尼亚"
	quest.4000000000000009.quest_subtitle: "繁荣80 / 稳定70 / 军力82 / 开放65 / 战争倾向35"
	quest.4000000000000009.quest_desc: ["国家状态：综合国力强盛，通过投资与代理势力影响周边。\n\n重要关系：\n• 玻利瓦尔：25 / 22 / 55 / 55 / 15（投资、代理冲突）\n• 哥伦比亚：-40 / 52 / 35 / 72 / -45（代理竞争）\n• 谢拉格：28 / 6 / 65 / 16 / 24（投资、贸易）"]
	quest.400000000000000A.title: "雷姆必拓"
	quest.400000000000000A.quest_subtitle: "繁荣72 / 稳定75 / 军力45 / 开放85 / 战争倾向20"
	quest.400000000000000A.quest_desc: ["国家状态：矿业经济活跃、对外开放，扩张与战争倾向较低。\n\n重要关系：\n• 谢拉格：42 / 4 / 80 / 12 / 38（投资、贸易）"]
	quest.400000000000000B.title: "米诺斯"
	quest.400000000000000B.quest_subtitle: "繁荣60 / 稳定68 / 军力62 / 开放55 / 战争倾向30"
	quest.400000000000000B.quest_desc: ["国家状态：整体温和稳定，国力处于中游。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.400000000000000C.title: "萨尔贡"
	quest.400000000000000C.quest_subtitle: "繁荣65 / 稳定60 / 军力70 / 开放70 / 战争倾向40"
	quest.400000000000000C.quest_desc: ["国家状态：疆域广阔、贸易开放，军力与冲突倾向处于中上水平。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.400000000000000D.title: "萨米"
	quest.400000000000000D.quest_subtitle: "繁荣38 / 稳定70 / 军力75 / 开放25 / 战争倾向15"
	quest.400000000000000D.quest_desc: ["国家状态：对外封闭而防卫能力较强，主动战争倾向低。\n\n重要关系：\n• 乌萨斯：-58 / 72 / 8 / 80 / -68（历史战争、边境紧张）"]
	quest.400000000000000E.title: "维多利亚"
	quest.400000000000000E.quest_subtitle: "繁荣76 / 稳定40 / 军力90 / 开放72 / 战争倾向55"
	quest.400000000000000E.quest_desc: ["国家状态：军力强大且经济开放，但内部局势削弱稳定。\n\n重要关系：\n• 卡兹戴尔：-65 / 48 / 8 / 72 / -78（历史战争、占领）\n• 谢拉格：38 / 6 / 62 / 16 / 32（投资、贸易）\n• 哥伦比亚：-28 / 28 / 62 / 58 / -30（贸易、边境紧张）"]
	quest.400000000000000F.title: "乌萨斯"
	quest.400000000000000F.quest_subtitle: "繁荣55 / 稳定38 / 军力92 / 开放30 / 战争倾向85"
	quest.400000000000000F.quest_desc: ["国家状态：军力和战争倾向极高，对外开放与内部稳定偏低。\n\n重要关系：\n• 卡西米尔：-65 / 78 / 12 / 85 / -72\n• 萨米：-58 / 72 / 8 / 80 / -68\n• 东国：-60 / 68 / 12 / 82 / -70\n以上均属于历史战争与边境紧张。"]
	quest.4000000000000010.title: "谢拉格"
	quest.4000000000000010.quest_subtitle: "繁荣58 / 稳定72 / 军力48 / 开放52 / 战争倾向20"
	quest.4000000000000010.quest_desc: ["国家状态：整体稳定、战争倾向低，正通过改革逐步扩大对外联系。\n\n重要关系：\n• 维多利亚：38 / 6 / 62 / 16 / 32\n• 哥伦比亚：32 / 8 / 72 / 20 / 25\n• 莱塔尼亚：28 / 6 / 65 / 16 / 24\n• 雷姆必拓：42 / 4 / 80 / 12 / 38\n以上均以投资和贸易为主。"]
	quest.4000000000000011.title: "叙拉古"
	quest.4000000000000011.quest_subtitle: "繁荣70 / 稳定55 / 军力65 / 开放72 / 战争倾向45"
	quest.4000000000000011.quest_desc: ["国家状态：贸易开放且经济活跃，家族秩序使稳定与冲突倾向并存。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000012.title: "炎国"
	quest.4000000000000012.quest_subtitle: "繁荣88 / 稳定88 / 军力90 / 开放60 / 战争倾向20"
	quest.4000000000000012.quest_desc: ["国家状态：繁荣、稳定和军力均处高位，主动战争倾向较低。\n\n当前没有收录具有充分 PRTS 依据的重要双边关系，系统对其他国家使用中立默认值。"]
	quest.4000000000000013.title: "伊比利亚"
	quest.4000000000000013.quest_subtitle: "繁荣32 / 稳定52 / 军力65 / 开放15 / 战争倾向25"
	quest.4000000000000013.quest_desc: ["国家状态：大静谧后繁荣与开放显著下降，仍保有一定军事实力。\n\n重要关系：\n• 阿戈尔：-48 / 24 / 12 / 68 / -62（技术转移、外交排斥）\n• 拉特兰：20 / 4 / 42 / 22 / 18（宗教联系、调解）"]
}
