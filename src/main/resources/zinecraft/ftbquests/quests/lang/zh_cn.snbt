	chapter.7A00000000000001.title: "阿戈尔：国家档案"
	quest.7D01000000000001.title: "国家设定"
	quest.7D01000000000001.quest_subtitle: "PRTS 国家资料摘要"
	quest.7D01000000000001.quest_desc: ["地处深海、对外相对封锁的国家。国家权力掌握在科学执政官与技术执政官手中，并以深海猎人、海巡队等力量对抗海嗣。\n\n资料口径：PRTS 泰拉大典国家条目；本节点不补写未公开设定。"]
	task.7E01000000000001.title: "阅读国家设定"
	quest.7D01000000000002.title: "城市与聚落"
	quest.7D01000000000002.quest_subtitle: "PRTS 已确认地名目录"
	quest.7D01000000000002.quest_desc: ["城市、聚落与明确城市辖区：弥利亚留姆。\n\n地图坐标与边界属于 Zinecraft 游戏化布局，不代表官方精确位置。"]
	task.7E01000000000002.title: "阅读城市目录"
	quest.7D01000000000003.title: "重要地区"
	quest.7D01000000000003.quest_subtitle: "行政区与自然地貌"
	quest.7D01000000000003.quest_desc: ["重要地区：现有 PRTS 地理总目录未列出更多可确认地名。\n\n国家、城市和群系是不同数据层；地区边界不会被群系边界替代。"]
	task.7E01000000000003.title: "阅读地区目录"
	quest.7D01000000000004.title: "建筑与探索"
	quest.7D01000000000004.quest_subtitle: "当前可访问的国家结构"
	quest.7D01000000000004.quest_desc: ["本章可探索建筑：阿戈尔海底聚居地、阿戈尔火山信标、阿戈尔深渊观测站。\n\n这些注册结构是依据资料制作的 Minecraft 表达；每座城市另有独立注册的城市中心、住宅、商店、工坊和公共建筑 Blockout，未知外观不视为官方复原。"]
	task.7E01000000000004.title: "阅读建筑目录"
	quest.7B01000000000001.title: "阿戈尔海底聚居地"
	quest.7B01000000000001.quest_subtitle: "进入结构范围后自动完成"
	quest.7B01000000000001.quest_desc: ["前往并进入 zinecraft:aegir_subsea_enclave 的有效结构范围。FTB Quests 会在服务器端自动检测访问状态。"]
	task.7C01000000000001.title: "访问阿戈尔海底聚居地"
	quest.7B01000000000002.title: "阿戈尔火山信标"
	quest.7B01000000000002.quest_subtitle: "进入结构范围后自动完成"
